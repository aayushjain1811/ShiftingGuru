@model LocationDetailsViewModel
@{
    var seo = ViewData["Seo"] as ShiftingGuru.ViewModels.Seo.SeoViewModel;
    var location = Model.Location;
    var heroUrl = location.HeroImageUrl;
    var highlights = Model.Services.Take(4).ToList();
}

<!-- ============ 1. Hero ============ -->
<section class="relative overflow-hidden border-b border-ink-100 bg-hero pt-28 lg:pt-40">

    @if (heroUrl is not null)
    {
        @* The city's own photo, uploaded in admin. It settles slowly as the
           page loads, exactly like the service pages. *@
        <img src="@heroUrl" alt=""
             class="photo-drift absolute inset-0 h-full w-full object-cover object-center lg:object-right"
             width="1920" height="1080" fetchpriority="high" decoding="async" aria-hidden="true" />

        @* Cream on the left so the heading reads, clearing to the right so the
           photo is visible. On phones it washes the whole image. *@
        <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(254,253,251,0.95)_0%,rgba(254,253,251,0.85)_55%,rgba(254,253,251,0.7)_100%)] lg:bg-[linear-gradient(90deg,rgba(254,253,251,1)_0%,rgba(254,253,251,0.97)_38%,rgba(254,253,251,0.75)_56%,rgba(254,253,251,0)_86%)]" aria-hidden="true"></div>
        <div class="pointer-events-none absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-hero via-hero/70 to-transparent lg:h-32" aria-hidden="true"></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-hero to-transparent" aria-hidden="true"></div>
    }
    else
    {
        @* No photo yet: the faint arcs from the homepage hero. *@
        <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 1440 620"
             preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
            <path d="M880 -60 A 560 560 0 0 0 1500 620" stroke="rgb(49 86 198 / 0.07)" stroke-width="1.5" />
            <path d="M1000 -60 A 440 440 0 0 0 1500 460" stroke="rgb(49 86 198 / 0.05)" stroke-width="1.5" />
        </svg>
    }

    <div class="relative mx-auto max-w-[1400px] px-5 pb-20 sm:px-8 lg:pb-28">
        <partial name="_Breadcrumbs" model="seo!.Breadcrumbs" />

        <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-10">

            <div class="lg:col-span-7">
                <p class="hero-in hero-in-1 flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.14em] text-jade-500">
                    <span class="h-px w-8 bg-jade-500" aria-hidden="true"></span>
                    @location.Display
                </p>

                @* The one H1 on the page, from the database so every city differs. *@
                <h1 class="hero-in hero-in-2 mt-7 max-w-[16ch] font-display text-[clamp(2.5rem,6.5vw,4.75rem)] font-extrabold leading-[0.98] tracking-[-0.045em] text-ink-900">
                    @location.H1
                </h1>

                <p class="hero-in hero-in-3 mt-8 max-w-xl text-lg leading-relaxed text-ink-700">
                    @location.ShortDescription
                </p>

                <div class="hero-in hero-in-4 mt-10 flex flex-wrap gap-4">
                    <a href="/quote"
                       class="lift group inline-flex h-13 items-center gap-2 bg-jade-500 px-7 text-base font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                        Get Free Quotes
                        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1.5"
                             viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                            <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                    <a href="#how-it-works"
                       class="lift inline-flex h-13 items-center border border-ink-300 bg-white px-7 text-base font-semibold text-ink-900 shadow-card rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">
                        How It Works
                    </a>
                </div>
            </div>

            @* Floating card: a few services, linked, for people who already
               know what they're moving. *@
            <div class="hero-in hero-in-5 lg:col-span-4 lg:col-start-9">
                <div class="float-slow border border-ink-200 bg-white p-7 shadow-float rounded-panel">
                    <svg class="h-7 w-7 text-jade-500" viewBox="0 0 20 20" fill="none"
                         stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                        <path d="M10 18s-6-5.2-6-10a6 6 0 1112 0c0 4.8-6 10-6 10z" stroke-linecap="round" stroke-linejoin="round" />
                        <circle cx="10" cy="8" r="2" />
                    </svg>
                    <p class="mt-6 text-[13px] font-semibold uppercase tracking-[0.14em] text-ink-500">
                        Moving in @location.Name
                    </p>
                    <ul class="mt-4 space-y-3">
                        @foreach (var service in highlights)
                        {
                            <li>
                                <a href="/services/@service.Slug" class="group flex items-start gap-2.5">
                                    <svg class="mt-1.5 h-3 w-3 shrink-0 text-success-600" viewBox="0 0 20 20" fill="none"
                                         stroke="currentColor" stroke-width="3" aria-hidden="true">
                                        <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    <span class="text-[15px] text-ink-700 transition-colors group-hover:text-jade-600">@service.Name</span>
                                </a>
                            </li>
                        }
                    </ul>
                    <a href="#services" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-jade-500 transition-colors hover:text-jade-600">
                        All services here
                        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                            <path d="M10 4v11M6 11l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ 2. Slow strip of services (decorative) ============ -->
<div class="border-b border-ink-100 bg-white py-5" aria-hidden="true">
    <div class="marquee">
        <div class="marquee-track">
            @for (var copy = 0; copy < 2; copy++)
            {
                foreach (var service in Model.Services)
                {
                    <span class="flex shrink-0 items-center gap-3 px-6 font-display text-lg font-bold tracking-[-0.02em] text-ink-900">
                        <svg class="h-4 w-4 text-success-600" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.8">
                            <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        @service.Name in @location.Name
                    </span>
                }
            }
        </div>
    </div>
</div>

<!-- ============ 3. About this city ============ -->
<section class="bg-white" aria-labelledby="about-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">
        <div class="grid gap-10 lg:grid-cols-12">
            <h2 id="about-heading"
                class="reveal-left lg:col-span-4 font-display text-[clamp(2rem,4.2vw,3.25rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                Moving in @location.Name
            </h2>

            <div class="reveal-right lg:col-span-7 lg:col-start-6">
                @foreach (var paragraph in Model.Paragraphs)
                {
                    <p class="mb-6 max-w-[62ch] text-lg leading-relaxed text-ink-700 last:mb-0">@paragraph</p>
                }
            </div>
        </div>
    </div>
</section>

<!-- ============ 4. Services - the homepage photo cards ============ -->
<section id="services" class="scroll-mt-24 border-y border-ink-100 bg-paper" aria-labelledby="services-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">

        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
            <h2 id="services-heading"
                class="reveal-up lg:col-span-7 font-display text-[clamp(2rem,4.5vw,3.5rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                Services available in @location.Name
            </h2>
            <p class="reveal-up lg:col-span-4 lg:col-start-9 text-base leading-relaxed text-ink-500">
                One enquiry reaches verified professionals who cover @location.Name.
            </p>
        </div>

        @* Same card as the homepage and service pages, so the whole site
           looks like one site. *@
        <ul class="stagger mt-14 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-5">
            @foreach (var service in Model.Services)
            {
                <partial name="_ServiceCard" model="service" />
            }
        </ul>
    </div>
</section>

<!-- ============ 5. How it works - the truck journey ============ -->
<section id="how-it-works" class="journey scroll-mt-24 overflow-hidden bg-white" aria-labelledby="how-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">

        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
            <h2 id="how-heading"
                class="reveal-up lg:col-span-7 font-display text-[clamp(2rem,4.5vw,3.5rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                How it works
            </h2>
            <p class="reveal-up lg:col-span-4 lg:col-start-9 text-base leading-relaxed text-ink-500">
                From your first request in @location.Name to final delivery.
            </p>
        </div>

        <partial name="_Journey" />
    </div>
</section>

<!-- ============ 6. Quote strip ============ -->
<section class="border-y border-ink-100 bg-paper" aria-label="Get free quotes">
    <div class="reveal-up mx-auto flex max-w-[1400px] flex-col gap-5 px-5 py-8 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
        <p class="font-display text-lg font-bold tracking-[-0.02em] text-ink-900">
            Planning a move in @location.Name? Compare quotes in one go.
        </p>
        <a href="/quote"
           class="lift inline-flex h-12 shrink-0 items-center justify-center bg-jade-500 px-6 text-[15px] font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
            Get Free Quotes
        </a>
    </div>
</section>

<!-- ============ 7. Routes (only when some exist) ============ -->
@if (Model.Routes.Count > 0)
{
    <section class="bg-white" aria-labelledby="routes-heading">
        <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">
            <h2 id="routes-heading"
                class="reveal-up max-w-2xl font-display text-[clamp(2rem,4.5vw,3.5rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                Routes from and to @location.Name
            </h2>

            <ul class="stagger mt-14 border-t border-ink-200">
                @foreach (var route in Model.Routes)
                {
                    <li class="reveal-up border-b border-ink-200">
                        <a href="@route.Url" class="group flex items-center justify-between gap-4 py-6">
                            <span class="font-display text-[clamp(1.25rem,3vw,2rem)] font-bold leading-none tracking-[-0.04em] text-ink-900 transition-colors group-hover:text-jade-500">
                                @route.Label
                            </span>
                            <svg class="h-4 w-4 shrink-0 text-ink-300 transition-all duration-200 group-hover:translate-x-2 group-hover:text-jade-500"
                                 viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </section>
}

<!-- ============ 8. FAQs ============ -->
<partial name="_Faqs" model="Model.Faqs" />

<!-- ============ 9. Other cities ============ -->
@if (Model.OtherLocations.Count > 0)
{
    <section class="border-t border-ink-100 bg-white" aria-labelledby="other-heading">
        <div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8 lg:py-20">
            <h2 id="other-heading" class="reveal-up font-display text-2xl font-bold tracking-[-0.03em] text-ink-900">Other cities</h2>

            <ul class="stagger mt-6 flex flex-wrap gap-3">
                @foreach (var other in Model.OtherLocations)
                {
                    <li class="reveal-up">
                        <a href="@other.Url" class="lift inline-flex min-h-11 items-center border border-ink-200 bg-white px-4 text-[15px] font-medium text-ink-800 rounded-card transition-colors hover:border-jade-500 hover:bg-jade-50 hover:text-jade-600">
                            @other.Name
                        </a>
                    </li>
                }
            </ul>
        </div>
    </section>
}

<!-- ============ 10. Final CTA ============ -->
<partial name="_QuoteCta" />