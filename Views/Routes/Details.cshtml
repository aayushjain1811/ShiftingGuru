@model RouteDetailsViewModel
@{
    var seo = ViewData["Seo"] as ShiftingGuru.ViewModels.Seo.SeoViewModel;
    var route = Model.Route;
    var from = route.FromLocation!;
    var to = route.ToLocation!;

    var steps = new (string Number, string Title, string Body)[]
    {
        ("01", "Submit your requirement", $"Tell us what you're moving from {from.Name} to {to.Name}."),
        ("02", "Get matched with providers", "We pass it to professionals who run this corridor."),
        ("03", "Compare quotes", "See what each charges and what's included before you decide."),
        ("04", "Choose confidently", "Pick your provider and deal with them directly.")
    };
}

<section class="relative overflow-hidden bg-ink-950 pb-16 pt-28 lg:pb-20 lg:pt-40">
    <div class="pointer-events-none absolute inset-0 grid-veil" aria-hidden="true">
        <div class="absolute -right-40 -top-40 h-[560px] w-[560px] rounded-full bg-jade-500/12 blur-[120px]"></div>
        <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1440 620" preserveAspectRatio="xMidYMid slice" fill="none">
            <path class="route-path" d="M-60 540 C 280 540, 360 340, 680 330 S 1100 200, 1500 150"
                  stroke="rgb(34 197 138 / 0.4)" stroke-width="1.5" stroke-dasharray="7 11" stroke-linecap="round" />
        </svg>
    </div>

    <div class="relative mx-auto max-w-[1400px] px-5 sm:px-8">
        <partial name="_Breadcrumbs" model="seo!.Breadcrumbs" />

        <p class="mt-10 flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.14em] text-jade-400">
            <span class="h-px w-8 bg-jade-400" aria-hidden="true"></span>
            @from.Name to @to.Name
        </p>

        <h1 class="mt-6 max-w-3xl font-display text-[clamp(2.25rem,6vw,4.5rem)] font-extrabold leading-[0.98] tracking-[-0.045em] text-white">
            @route.H1
        </h1>

        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-200">@route.ShortDescription</p>

        <a href="/quote" class="mt-10 inline-flex h-13 items-center bg-jade-500 px-7 text-base font-semibold text-ink-950 rounded-card transition-colors hover:bg-jade-400">
            Get Free Quotes
        </a>

        @* Both endpoints link to their city pages - internal linking in both
           directions, which is what makes the cluster discoverable. *@
        <dl class="mt-12 grid max-w-lg grid-cols-2 gap-px border border-white/10 bg-white/10">
            <div class="bg-ink-950 p-5">
                <dt class="text-[13px] text-ink-400">From</dt>
                <dd class="mt-1">
                    <a href="/locations/@from.Slug" class="font-display text-xl font-bold tracking-[-0.03em] text-white hover:text-jade-400">@from.Name</a>
                    <p class="mt-0.5 text-sm text-ink-400">@from.State</p>
                </dd>
            </div>
            <div class="bg-ink-950 p-5">
                <dt class="text-[13px] text-ink-400">To</dt>
                <dd class="mt-1">
                    <a href="/locations/@to.Slug" class="font-display text-xl font-bold tracking-[-0.03em] text-white hover:text-jade-400">@to.Name</a>
                    <p class="mt-0.5 text-sm text-ink-400">@to.State</p>
                </dd>
            </div>
        </dl>
    </div>
</section>

<section class="bg-white" aria-labelledby="about-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8 lg:py-24">
        <div class="grid gap-10 lg:grid-cols-12">
            <h2 id="about-heading" class="lg:col-span-4 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-extrabold leading-[1.05] tracking-[-0.04em] text-ink-900">
                Planning this move
            </h2>

            <div class="lg:col-span-7 lg:col-start-6">
                @foreach (var paragraph in Model.Paragraphs)
                {
                    <p class="mb-6 max-w-[62ch] text-lg leading-relaxed text-ink-700 last:mb-0">@paragraph</p>
                }
            </div>
        </div>
    </div>
</section>

<section class="border-y border-ink-100 bg-paper" aria-labelledby="services-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8 lg:py-24">
        <h2 id="services-heading" class="max-w-2xl font-display text-[clamp(1.75rem,4vw,2.75rem)] font-extrabold leading-[1.05] tracking-[-0.04em] text-ink-900">
            Services on this route
        </h2>

        <ul class="mt-12 grid grid-cols-2 gap-px bg-ink-200 lg:grid-cols-4">
            @foreach (var service in Model.Services)
            {
                <li>
                    <a href="/services/@service.Slug" class="group flex h-full flex-col bg-paper p-6 transition-colors hover:bg-ink-900">
                        <svg class="h-6 w-6 text-ink-900 transition-colors group-hover:text-jade-400" viewBox="0 0 20 20"
                             fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <path d="@service.IconPath" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <h3 class="mt-8 font-display text-base font-bold tracking-[-0.02em] text-ink-900 transition-colors group-hover:text-white">@service.Name</h3>
                        <p class="mt-2 text-sm leading-relaxed text-ink-500 transition-colors group-hover:text-ink-200">@service.ShortDescription</p>
                    </a>
                </li>
            }
        </ul>
    </div>
</section>

<section class="bg-white" aria-labelledby="how-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8 lg:py-24">
        <h2 id="how-heading" class="max-w-2xl font-display text-[clamp(1.75rem,4vw,2.75rem)] font-extrabold leading-[1.05] tracking-[-0.04em] text-ink-900">
            How it works
        </h2>

        <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var step in steps)
            {
                <li class="border-t border-ink-200 pt-6">
                    <span class="font-display text-sm font-bold text-jade-600">@step.Number</span>
                    <h3 class="mt-3 font-display text-lg font-bold tracking-[-0.03em] text-ink-900">@step.Title</h3>
                    <p class="mt-2.5 max-w-[34ch] text-[15px] leading-relaxed text-ink-500">@step.Body</p>
                </li>
            }
        </ol>
    </div>
</section>

<partial name="_Faqs" model="Model.Faqs" />

@if (Model.RelatedRoutes.Count > 0)
{
    <section class="border-t border-ink-100 bg-paper" aria-labelledby="related-heading">
        <div class="mx-auto max-w-[1400px] px-5 py-14 sm:px-8 lg:py-20">
            <h2 id="related-heading" class="font-display text-2xl font-bold tracking-[-0.03em] text-ink-900">Related routes</h2>

            <ul class="mt-6 border-t border-ink-200">
                @foreach (var related in Model.RelatedRoutes)
                {
                    <li class="border-b border-ink-200">
                        <a href="@related.Url" class="fill-row group flex items-center justify-between gap-4 px-4 py-5">
                            <span class="font-display text-lg font-semibold tracking-[-0.02em] text-ink-900 transition-colors group-hover:text-white">@related.Label</span>
                            <svg class="h-4 w-4 shrink-0 text-ink-200 transition-all duration-200 group-hover:translate-x-1.5 group-hover:text-jade-400"
                                 viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </section>
}

<partial name="_QuoteCta" />
