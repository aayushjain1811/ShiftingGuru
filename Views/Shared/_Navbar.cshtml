@{
    var navLinks = new (string Text, string Href)[]
    {
        ("Services", "/services"),
        ("Locations", "/locations"),
        ("How It Works", "/how-it-works"),
        ("About Us", "/about"),
        ("Contact", "/contact")
    };
}

@* Transparent over the light hero, then condenses to solid paper once
   you scroll past it. One class toggle, no scroll maths. *@
<header id="site-header" class="site-header fixed inset-x-0 top-0 z-50 border-b border-transparent">
    <div class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-5 sm:px-8 lg:h-20">

        <a href="/" class="group flex items-center gap-3" aria-label="ShiftingGuru home">
            <partial name="_Logo" model="@("h-9 w-auto lg:h-10")" />

            @* If the logo image already shows the name, delete the line below. *@
            <span data-header-word class="font-display text-[19px] font-extrabold tracking-[-0.03em] text-ink-900">ShiftingGuru</span>
        </a>

        <nav class="hidden lg:flex lg:items-center lg:gap-9" aria-label="Main">
            @foreach (var link in navLinks)
            {
                <a href="@link.Href" data-header-link
                   class="underline-grow text-[15px] font-medium text-ink-700 transition-colors hover:text-jade-500">@link.Text</a>
            }
        </nav>

        <div class="hidden lg:flex lg:items-center lg:gap-6">
            @* Customers have no password: /my-request sends them to the
               request-access page if their sign-in link has expired. *@
            <a href="/my-request" data-header-link class="underline-grow text-[15px] font-medium text-ink-700 transition-colors hover:text-jade-500">
                Track My Request
            </a>
            <a href="/partner/login" data-header-link class="underline-grow text-[15px] font-medium text-ink-700 transition-colors hover:text-jade-500">
                Partner Login
            </a>
            <a href="#get-quotes"
               class="lift group inline-flex h-11 items-center gap-2 bg-jade-500 px-6 text-[15px] font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                Get Free Quotes
                <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1"
                     viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                    <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
        </div>

        @* On phones the drawer hides everything, so the customer link also
           sits directly in the bar, next to the menu button. *@
        <div class="flex items-center gap-2 lg:hidden">

            <a href="/my-request" data-header-link
               class="inline-flex h-11 items-center px-2 text-[15px] font-medium text-ink-700 transition-colors hover:text-jade-500">
                Track
            </a>

            <button id="menu-toggle" type="button"
                    class="grid h-11 w-11 place-items-center border border-ink-200 bg-white rounded-card transition-colors hover:border-jade-500"
                    aria-expanded="false" aria-controls="mobile-drawer" aria-label="Open menu">
                <svg data-header-icon class="h-5 w-5 text-ink-900" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round" />
                </svg>
            </button>
        </div>
    </div>
</header>

<div id="mobile-overlay" hidden class="fixed inset-0 z-50 bg-ink-950/60 lg:hidden"></div>

<div id="mobile-drawer" hidden
     class="drawer fixed right-0 top-0 z-50 flex h-dvh w-[86%] max-w-sm flex-col bg-paper lg:hidden"
     role="dialog" aria-modal="true" aria-label="Site menu">

    <div class="flex h-16 items-center justify-between border-b border-ink-100 px-5">
        <span class="font-display text-base font-bold tracking-tight text-ink-900">Menu</span>
        <button id="menu-close" type="button"
                class="grid h-11 w-11 place-items-center border border-ink-100 rounded-card" aria-label="Close menu">
            <svg class="h-5 w-5 text-ink-900" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
            </svg>
        </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-5 py-3" aria-label="Mobile">
        <ul class="divide-y divide-ink-100">
            @foreach (var link in navLinks)
            {
                <li>
                    <a href="@link.Href" class="block py-4 font-display text-lg font-semibold tracking-tight text-ink-900 transition-colors hover:text-jade-500">@link.Text</a>
                </li>
            }
        </ul>
    </nav>

    <div class="space-y-3 border-t border-ink-100 p-5">
        <a href="#get-quotes"
           class="lift block bg-jade-500 py-3.5 text-center text-base font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
            Get Free Quotes
        </a>
        <a href="/my-request"
           class="block border border-ink-200 bg-white py-3.5 text-center text-base font-medium text-ink-800 rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">
            Track My Request
        </a>
        <a href="/partner/login"
           class="block border border-ink-200 bg-white py-3.5 text-center text-base font-medium text-ink-800 rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">
            Partner Login
        </a>
        <a href="/join-as-partner"
           class="block py-2 text-center text-sm font-medium text-ink-500 transition-colors hover:text-jade-500">
            Join as Partner
        </a>
    </div>
</div>