@model IReadOnlyList<ShiftingGuru.ViewModels.Seo.FaqViewModel>

@* Reuses the homepage accordion markup, so site.js drives it with no extra
   JavaScript. Real <button> elements give keyboard support for free. *@
@if (Model.Count > 0)
{
    <section id="faq" class="scroll-mt-24 border-t border-ink-100 bg-paper" aria-labelledby="faq-heading">
        <div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8 lg:py-24">
            <div class="grid gap-10 lg:grid-cols-12">

                <h2 id="faq-heading"
                    class="lg:col-span-4 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-extrabold leading-[1.05] tracking-[-0.04em] text-ink-900">
                    Common questions
                </h2>

                <div id="faq-list" class="lg:col-span-7 lg:col-start-6 divide-y divide-ink-200 border-y border-ink-200">
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        var panelId = $"faq-panel-{i}";
                        var buttonId = $"faq-button-{i}";

                        <div>
                            <h3>
                                <button type="button" id="@buttonId" data-faq-question
                                        aria-expanded="false" aria-controls="@panelId"
                                        class="flex w-full items-center justify-between gap-6 py-6 text-left">
                                    <span class="font-display text-lg font-semibold tracking-[-0.02em] text-ink-900">@Model[i].Question</span>
                                    <svg class="faq-icon h-5 w-5 shrink-0 text-ink-400" viewBox="0 0 20 20" fill="none"
                                         stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                        <path d="M10 4v12M4 10h12" stroke-linecap="round" />
                                    </svg>
                                </button>
                            </h3>

                            <div id="@panelId" class="faq-panel pb-6" role="region" aria-labelledby="@buttonId">
                                <p class="max-w-[62ch] text-[15px] leading-relaxed text-ink-600">@Model[i].Answer</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}
