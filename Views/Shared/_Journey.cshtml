                <g transform="translate(-10,-10)" stroke="#98A2B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10l7-3 7 3v6l-7 3-7-3v-6z" /><path d="M10 1v4.5M8 3.5l2 2 2-2" /></g>
