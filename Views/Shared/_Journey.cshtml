                    <circle r="24" fill="#3156C6" />
                    <g transform="translate(-10,-10)" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10l7-3 7 3v6l-7 3-7-3v-6z" /><path d="M10 1v4.5M8 3.5l2 2 2-2" /></g>
                </g>
            </g>
            <circle cx="450" cy="205" r="7" fill="#DCE6FF" />
            <g class="on-5"><circle cx="450" cy="205" r="15" fill="none" stroke="#3156C6" stroke-opacity="0.3" stroke-width="2" /><circle cx="450" cy="205" r="7" fill="#3156C6" /></g>
            <text x="450" y="317" text-anchor="middle" fill="#98A2B3" font-size="21" font-weight="700" class="font-display">Unloading</text>
            <text x="450" y="317" text-anchor="middle" fill="#182238" font-size="21" font-weight="700" class="font-display on-5">Unloading</text>

            @* 06 Delivered (above) *@
            <line x1="550" y1="146" x2="550" y2="120" stroke="#E6E8ED" stroke-width="1.5" stroke-dasharray="3 4" />
            <g transform="translate(550,96)">
                <circle r="24" fill="#FFFFFF" stroke="#E6E8ED" stroke-width="1.5" />
                <g transform="translate(-10,-10)" stroke="#98A2B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l7-6 7 6v8H3V9z" /></g>
                <g class="on-6">
                    <circle r="24" fill="#2F7D65" />
                    <g transform="translate(-10,-10)" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l7-6 7 6v8H3V9z" /><path class="tick-draw" pathLength="1" d="M7 12.5l2.2 2.2 4-4.4" /></g>
                </g>
            </g>
            <circle cx="550" cy="160" r="7" fill="#DCE6FF" />
            <g class="on-6"><circle cx="550" cy="160" r="15" fill="none" stroke="#2F7D65" stroke-opacity="0.3" stroke-width="2" /><circle cx="550" cy="160" r="7" fill="#2F7D65" /></g>
            <text x="550" y="60" text-anchor="middle" fill="#98A2B3" font-size="21" font-weight="700" class="font-display">Delivered</text>
            <text x="550" y="60" text-anchor="middle" fill="#182238" font-size="21" font-weight="700" class="font-display on-6">Delivered</text>

            @* The truck, with speed lines while it moves. *@
            <g class="route-truck-m">
                <g class="truck-speed" stroke="#3156C6" stroke-width="2" stroke-linecap="round" opacity="0.6">
                    <line x1="-40" y1="-6" x2="-28" y2="-6" />
                    <line x1="-44" y1="0"  x2="-26" y2="0" />
                    <line x1="-38" y1="6"  x2="-28" y2="6" />
                </g>
                <circle r="19" fill="#FFFFFF" stroke="#DCE6FF" stroke-width="1.5" />
                <g transform="translate(-10,-8)" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="0" y="2" width="11" height="9" rx="1.5" fill="#1E2A44" stroke="#1E2A44" stroke-width="1.2" />
                    <path d="M11,5h3.2L17,8v3h-6z" fill="#3156C6" stroke="#3156C6" stroke-width="1.2" />
                    <circle cx="4" cy="12.5" r="1.8" fill="#FFFFFF" stroke="#1E2A44" stroke-width="1.2" />
                    <circle cx="13.5" cy="12.5" r="1.8" fill="#FFFFFF" stroke="#1E2A44" stroke-width="1.2" />
                </g>
            </g>
        </svg>
    </div>

    @* Screen readers get the stages as a plain list, since the drawing is
       decorative. *@
    <ol class="sr-only">
        @foreach (var stage in stages)
        {
            <li>@stage</li>
        }
    </ol>
</div>