@*
    Favicon and app icon links, in one place. Goes inside <head>.

    Files these expect:
        wwwroot/favicon.ico                  32x32
        wwwroot/images/apple-touch-icon.png  180x180
*@

<link rel="icon" href="~/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />
