@* Shared closing CTA. Used by /services and every service detail page so the
   conversion path is identical everywhere. *@
<section class="relative overflow-hidden border-y border-jade-100 bg-jade-50" aria-labelledby="quote-cta-heading">

    @* Two faint arcs in the soft blue accent. Decoration only. *@
    <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 1440 400"
         preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
        <path d="M-40 360 C 360 360, 520 80, 980 70 S 1400 20, 1480 10" stroke="#DCE6FF" stroke-width="2" />
        <path d="M-40 400 C 420 400, 640 170, 1060 160 S 1400 110, 1480 100" stroke="#DCE6FF" stroke-width="1.5" />
    </svg>

    <div class="relative mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-24">
        <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">

            <div class="max-w-2xl">
                <h2 id="quote-cta-heading"
                    class="font-display text-[clamp(2.25rem,5.5vw,4.5rem)] font-extrabold leading-[0.98] tracking-[-0.045em] text-ink-900">
                    <span class="block">Planning a move?</span>
                    <span class="block">Let's make it easier.</span>
                </h2>
                <p class="mt-6 max-w-md text-lg leading-snug text-ink-700">
                    Tell us what you're moving. We'll help you find the right professionals.
                </p>
            </div>

            <a href="/quote"
               class="lift group inline-flex h-14 shrink-0 items-center justify-center gap-2 bg-jade-500 px-8 text-base font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                Get Free Quotes
                <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1.5"
                     viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
        </div>
    </div>
</section>
