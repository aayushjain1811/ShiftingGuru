@model Service

@* One card, used by the homepage, /services and every service page.

   Photo on top with nothing over it, words below on white. Featured
   services get a double-width tile, a wider photo and a badge, because
   those are the ones we most want people to open. *@
<li class="reveal-scale @(Model.IsFeatured ? "col-span-2" : "")">
    <a href="/services/@Model.Slug"
       class="group flex h-full flex-col overflow-hidden border @(Model.IsFeatured ? "border-jade-100" : "border-ink-200") bg-white shadow-card rounded-panel transition-all duration-300 hover:-translate-y-1 hover:border-jade-100 hover:shadow-float">

        <div class="relative @(Model.IsFeatured ? "aspect-[16/9]" : "aspect-[4/3]") overflow-hidden bg-ink-100">
            <img src="~/images/services/@(Model.Slug).webp"
                 alt="@Model.Name"
                 class="h-full w-full object-cover transition-transform duration-[600ms] ease-out group-hover:scale-105"
                 width="1280" height="960"
                 loading="lazy" decoding="async" />

            <span class="absolute left-4 top-4 grid h-10 w-10 place-items-center bg-white/95 shadow-card rounded-card" aria-hidden="true">
                <svg class="h-5 w-5 text-jade-500" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="@Model.IconPath" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>

            @if (Model.IsFeatured)
            {
                <span class="absolute right-4 top-4 inline-flex items-center bg-jade-500 px-3 py-1.5 text-xs font-semibold text-white shadow-cta rounded-full">
                    Featured service
                </span>
            }
        </div>

        <div class="flex flex-1 flex-col p-5 lg:p-6">
            <h3 class="font-display @(Model.IsFeatured ? "text-xl lg:text-2xl" : "text-lg") font-bold tracking-[-0.03em] text-ink-900 transition-colors group-hover:text-jade-600">
                @Model.Name
            </h3>
            <p class="mt-2 flex-1 @(Model.IsFeatured ? "text-[15px]" : "text-sm") leading-relaxed text-ink-500">
                @Model.ShortDescription
            </p>

            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-jade-500">
                @(Model.IsFeatured ? "Get a quote" : "View service")
                <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1.5"
                     viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </div>
    </a>
</li>