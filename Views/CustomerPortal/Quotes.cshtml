@model CustomerQuoteListViewModel
@using ShiftingGuru.Areas.Admin
@{
    var lead = Model.Lead;
    var cheapest = Model.Quotes.Count > 1 ? Model.Quotes.Min(q => q.TotalAmount) : (decimal?)null;
}

<partial name="_CustomerShell" model="lead" />

<section class="bg-paper">
    <div class="mx-auto max-w-5xl px-5 py-10 sm:px-8 lg:py-14">

        @if (TempData["CustomerError"] is string error)
        {
            <div class="mb-6 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 rounded-card" role="alert">@error</div>
        }

        @if (Model.Quotes.Count == 0)
        {
            <div class="border border-ink-200 bg-white p-10 text-center rounded-panel">
                <h2 class="font-display text-lg font-bold tracking-[-0.02em] text-ink-900">No quotes yet</h2>
                <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-ink-500">
                    We're waiting for our partner providers to respond to your request.
                    Quotes will appear here as they come in.
                </p>
                <a href="/my-request" class="mt-6 inline-flex h-11 items-center border border-ink-200 px-5 text-sm font-medium text-ink-800 rounded-card hover:border-ink-900">
                    Back to your request
                </a>
            </div>
        }
        else
        {
            <div class="flex flex-wrap items-end justify-between gap-3">
                <div>
                    <h2 class="font-display text-xl font-bold tracking-[-0.03em] text-ink-900">
                        @Model.Quotes.Count quote@(Model.Quotes.Count == 1 ? "" : "s")
                    </h2>
                    <p class="mt-1 text-sm text-ink-500">Lowest price first. Compare what's included, not just the total.</p>
                </div>

                @if (Model.LeadConverted)
                {
                    <span class="inline-flex items-center border border-jade-500/30 bg-jade-100 px-3 py-1 text-sm font-medium text-jade-600 rounded-card">
                        Provider chosen
                    </span>
                }
            </div>

            @* Stacked cards at every width - a five-column price table would be
               unusable on a phone, and this is a mobile-first audience. *@
            <ul class="mt-6 space-y-4">
                @foreach (var quote in Model.Quotes)
                {
                    <li class="@(quote.IsAccepted ? "border-jade-500/40" : "border-ink-200") border bg-white rounded-panel">

                        <div class="flex flex-wrap items-start justify-between gap-4 border-b border-ink-100 p-5 sm:p-6">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="font-display text-lg font-bold tracking-[-0.02em] text-ink-900">@quote.VendorName</h3>

                                    @if (cheapest.HasValue && quote.TotalAmount == cheapest && !Model.LeadConverted)
                                    {
                                        <span class="border border-jade-500/30 bg-jade-100 px-2 py-0.5 text-[12px] font-medium text-jade-600 rounded-card">Lowest price</span>
                                    }
                                    @if (Model.LeadConverted)
                                    {
                                        <span class="@QuoteBadge.Classes(quote.Status) border px-2 py-0.5 text-[12px] font-medium rounded-card">
                                            @QuoteBadge.Label(quote.Status)
                                        </span>
                                    }
                                </div>

                                <p class="mt-1.5 text-sm text-ink-500">
                                    @quote.VendorCity
                                    @if (quote.VendorYearsOfExperience > 0)
                                    {
                                        <text> &middot; @quote.VendorYearsOfExperience years in business</text>
                                    }
                                </p>
                            </div>

                            <div class="text-right">
                                <p class="font-display text-2xl font-bold tracking-tight text-ink-900">@Money.Format(quote.TotalAmount)</p>
                                <p class="mt-0.5 text-xs text-ink-400">all charges included</p>
                            </div>
                        </div>

                        <div class="grid gap-5 p-5 sm:grid-cols-3 sm:p-6">
                            <div>
                                <p class="text-[13px] text-ink-500">Pickup</p>
                                <p class="mt-0.5 text-sm text-ink-800">@(quote.EstimatedPickupDate?.ToString("d MMM yyyy") ?? "To confirm")</p>
                            </div>
                            <div>
                                <p class="text-[13px] text-ink-500">Delivery</p>
                                <p class="mt-0.5 text-sm text-ink-800">@(quote.EstimatedDeliveryDate?.ToString("d MMM yyyy") ?? "To confirm")</p>
                            </div>
                            <div>
                                <p class="text-[13px] text-ink-500">In transit</p>
                                <p class="mt-0.5 text-sm text-ink-800">@(quote.EstimatedDeliveryDays.HasValue ? $"{quote.EstimatedDeliveryDays} day(s)" : "To confirm")</p>
                            </div>
                        </div>

                        <div class="flex flex-wrap items-center gap-3 border-t border-ink-100 p-5 sm:p-6">
                            <a href="/my-request/quotes/@quote.QuoteId"
                               class="inline-flex h-11 items-center border border-ink-200 px-5 text-sm font-medium text-ink-800 rounded-card hover:border-ink-900">
                                View full breakdown
                            </a>

                            @if (quote.IsSelectable)
                            {
                                <a href="/my-request/choose/@quote.QuoteId"
                                   class="inline-flex h-11 items-center bg-jade-500 px-5 text-sm font-semibold text-ink-950 rounded-card transition-colors hover:bg-jade-400">
                                    Choose this provider
                                </a>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</section>
