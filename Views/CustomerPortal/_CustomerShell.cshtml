@model ShiftingGuru.Models.Lead
@{
    var path = Context.Request.Path.Value ?? "";
    var tabs = new (string Label, string Href)[]
    {
        ("Your request", "/my-request"),
        ("Quotes", "/my-request/quotes")
    };
}

@* Shared header for every customer portal page. *@
<div class="border-b border-ink-200 bg-white">
    <div class="mx-auto max-w-5xl px-5 pt-28 sm:px-8 lg:pt-36">

        <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-jade-600">Your request</p>

        <h1 class="mt-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-extrabold leading-tight tracking-[-0.04em] text-ink-900">
            @Model.ServiceName
        </h1>
        <p class="mt-2 text-sm text-ink-500">
            @Model.LeadNumber &middot;
            @(Model.MovingFrom is null ? Model.StorageLocation ?? "-" : $"{Model.MovingFrom} to {Model.MovingTo}")
        </p>

        <nav class="mt-7 flex gap-1" aria-label="Your request">
            @foreach (var tab in tabs)
            {
                var active = tab.Href == "/my-request" ? path == "/my-request" : path.StartsWith(tab.Href);
                <a href="@tab.Href"
                   class="@(active ? "border-ink-900 text-ink-900" : "border-transparent text-ink-500 hover:text-ink-900") border-b-2 px-4 py-3 text-sm font-medium transition-colors">
                    @tab.Label
                </a>
            }
        </nav>
    </div>
</div>
