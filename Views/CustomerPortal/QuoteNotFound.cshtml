@{
    ViewData["Title"] = "Quote not available";
}

<section class="bg-paper">
    <div class="mx-auto max-w-xl px-5 pb-16 pt-28 text-center sm:px-8 lg:pt-36">
        <h1 class="font-display text-2xl font-bold tracking-[-0.03em] text-ink-900">Quote not available</h1>
        <p class="mt-3 text-base leading-relaxed text-ink-600">
            This quote isn't part of your request, or it's no longer available.
        </p>
        <a href="/my-request/quotes"
           class="mt-7 inline-flex h-12 items-center bg-ink-900 px-6 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">
            Back to your quotes
        </a>
    </div>
</section>
