<section class="bg-paper">
    <div class="mx-auto max-w-xl px-5 pb-16 pt-28 text-center sm:px-8 lg:pt-36">

        <span class="mx-auto grid h-14 w-14 place-items-center border border-success-200 bg-success-50 rounded-card" aria-hidden="true">
            <svg class="h-7 w-7 text-success-600" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4">
                <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </span>

        <h1 class="mt-8 font-display text-[clamp(1.75rem,4vw,2.5rem)] font-extrabold leading-tight tracking-[-0.04em] text-ink-900">
