@model CustomerQuoteDetailsViewModel
@using ShiftingGuru.Areas.Admin
@{
    var lead = Model.Lead;
    var quote = Model.Quote;

    var lines = new (string Label, decimal Value)[]
    {
        ("Base price", quote.BasePrice),
        ("Packing charges", quote.PackingCharges),
        ("Transportation charges", quote.TransportationCharges),
        ("Loading / unloading", quote.LoadingUnloadingCharges),
        ("Additional charges", quote.AdditionalCharges)
    };
}

<partial name="_CustomerShell" model="lead" />

<section class="bg-paper">
    <div class="mx-auto max-w-5xl px-5 py-10 sm:px-8 lg:py-14">

        <a href="/my-request/quotes" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 hover:text-ink-900">
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M16 10H5M9 6l-4 4 4 4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            All quotes
        </a>

        <div class="mt-5 border border-ink-200 bg-white shadow-card rounded-panel">

            <div class="flex flex-wrap items-start justify-between gap-4 border-b border-ink-100 p-6">
                <div>
                    <h2 class="font-display text-2xl font-bold tracking-[-0.03em] text-ink-900">@quote.VendorName</h2>
                    <p class="mt-1.5 text-sm text-ink-500">
                        Quote @quote.QuoteNumber &middot; submitted @quote.SubmittedAt.ToLocalTime().ToString("d MMM yyyy")
                    </p>
                </div>
                <span class="@QuoteBadge.Classes(quote.Status) inline-flex items-center border px-3 py-1 text-sm font-medium rounded-card">
                    @QuoteBadge.Label(quote.Status)
                </span>
            </div>

            <div class="p-6">
                <h3 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Price breakdown</h3>
                <dl class="mt-4 divide-y divide-ink-100 border-y border-ink-100">
                    @foreach (var line in lines)
                    {
                        <div class="flex items-center justify-between py-3">
                            <dt class="text-sm text-ink-600">@line.Label</dt>
                            <dd class="text-sm text-ink-900">@Money.Format(line.Value)</dd>
                        </div>
                    }
                </dl>
                <div class="mt-4 flex items-center justify-between">
                    <span class="text-sm font-semibold text-ink-900">Total</span>
                    <span class="font-display text-2xl font-bold tracking-tight text-ink-900">@Money.Format(quote.TotalAmount)</span>
                </div>
            </div>

            <div class="border-t border-ink-100 p-6">
                <h3 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Timing</h3>
                <dl class="mt-4 grid gap-5 sm:grid-cols-3">
                    <div>
                        <dt class="text-[13px] text-ink-500">Pickup</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(quote.EstimatedPickupDate?.ToString("d MMMM yyyy") ?? "To confirm")</dd>
                    </div>
                    <div>
                        <dt class="text-[13px] text-ink-500">Delivery</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(quote.EstimatedDeliveryDate?.ToString("d MMMM yyyy") ?? "To confirm")</dd>
                    </div>
                    <div>
                        <dt class="text-[13px] text-ink-500">In transit</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(quote.EstimatedDeliveryDays.HasValue ? $"{quote.EstimatedDeliveryDays} day(s)" : "To confirm")</dd>
                    </div>
                </dl>
            </div>

            <div class="border-t border-ink-100 p-6">
                <h3 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">About this provider</h3>
                <dl class="mt-4 grid gap-5 sm:grid-cols-2">
                    <div>
                        <dt class="text-[13px] text-ink-500">Based in</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@quote.VendorCity</dd>
                    </div>
                    @if (quote.VendorYearsOfExperience > 0)
                    {
                        <div>
                            <dt class="text-[13px] text-ink-500">Experience</dt>
                            <dd class="mt-0.5 text-sm text-ink-800">@quote.VendorYearsOfExperience years</dd>
                        </div>
                    }
                </dl>

                @if (quote.VendorServices.Count > 0)
                {
                    <ul class="mt-4 flex flex-wrap gap-2">
                        @foreach (var service in quote.VendorServices)
                        {
                            <li class="border border-ink-200 px-3 py-1 text-sm text-ink-700 rounded-card">@service</li>
                        }
                    </ul>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(quote.VendorNotes))
            {
                <div class="border-t border-ink-100 p-6">
                    <h3 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Notes from the provider</h3>
                    <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-ink-800">@quote.VendorNotes</p>
                </div>
            }

            @if (quote.IsSelectable)
            {
                <div class="border-t border-ink-100 bg-paper p-6">
                    <a href="/my-request/choose/@quote.QuoteId"
                       class="inline-flex h-12 items-center bg-jade-500 px-6 text-sm font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                        Choose this provider
                    </a>
                </div>
            }
        </div>
    </div>
</section>
