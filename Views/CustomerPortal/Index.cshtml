@model CustomerRequestViewModel
@{
    var lead = Model.Lead;
}

<partial name="_CustomerShell" model="lead" />

<section class="bg-paper">
    <div class="mx-auto max-w-5xl px-5 py-10 sm:px-8 lg:py-14">

        @if (TempData["CustomerMessage"] is string note)
        {
            <div class="mb-6 border border-jade-100 bg-jade-50 px-4 py-3 text-sm text-jade-600 rounded-card" role="status">@note</div>
        }

        @if (lead.IsConverted && Model.SelectedQuote is not null)
        {
            <section class="border border-success-200 bg-white p-6 shadow-card rounded-panel" aria-labelledby="selected-heading">
                <div class="flex flex-wrap items-start justify-between gap-4">
                    <div>
                        <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-success-600">Provider selected</p>
                        <h2 id="selected-heading" class="mt-2 font-display text-2xl font-bold tracking-[-0.03em] text-ink-900">
                            @Model.SelectedQuote.VendorName
                        </h2>
                        <p class="mt-1 text-sm text-ink-500">Quote @Model.SelectedQuote.QuoteNumber</p>
                    </div>
                    <p class="text-2xl font-bold tracking-tight text-ink-900">@Money.Format(Model.SelectedQuote.TotalAmount)</p>
                </div>

                <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-600">
                    Your chosen provider has your requirement and your contact details. They'll be in touch
                    to arrange the details of your move.
                </p>
            </section>
        }
        else
        {
            <section class="border border-ink-200 bg-white p-6 shadow-card rounded-panel">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <h2 class="font-display text-lg font-bold tracking-[-0.02em] text-ink-900">
                            @(Model.QuoteCount == 0 ? "Waiting for quotes" : $"{Model.QuoteCount} quote{(Model.QuoteCount == 1 ? "" : "s")} received")
                        </h2>
                        <p class="mt-1.5 max-w-md text-sm leading-relaxed text-ink-500">
                            @(Model.QuoteCount == 0
                                ? "We're waiting for our partner providers to respond to your request."
                                : "Compare what each provider is offering, then choose the one you want.")
                        </p>
                    </div>

                    @if (Model.QuoteCount > 0)
                    {
                        <a href="/my-request/quotes"
                           class="inline-flex h-12 shrink-0 items-center bg-jade-500 px-6 text-sm font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                            Compare quotes
                        </a>
                    }
                </div>
            </section>
        }

        <section class="mt-4 border border-ink-200 bg-white p-6 shadow-card rounded-panel" aria-labelledby="request-heading">
            <h2 id="request-heading" class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">What you asked for</h2>

            <dl class="mt-5 grid gap-5 sm:grid-cols-2">
                <div>
                    <dt class="text-[13px] text-ink-500">Reference</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@lead.LeadNumber</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Service</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@lead.ServiceName</dd>
                </div>

                @if (lead.ServiceSlug == "warehouse-storage")
                {
                    <div>
                        <dt class="text-[13px] text-ink-500">Location</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.StorageLocation ?? "-")</dd>
                    </div>
                    <div>
                        <dt class="text-[13px] text-ink-500">Start date</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingDate?.ToString("d MMMM yyyy") ?? "Not given")</dd>
                    </div>
                }
                else
                {
                    <div>
                        <dt class="text-[13px] text-ink-500">Moving from</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingFrom ?? "-")</dd>
                    </div>
                    <div>
                        <dt class="text-[13px] text-ink-500">Moving to</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingTo ?? "-")</dd>
                    </div>
                    <div>
                        <dt class="text-[13px] text-ink-500">Moving date</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingDate?.ToString("d MMMM yyyy") ?? "Not given")</dd>
                    </div>
                }

                @foreach (var detail in Model.ServiceDetails)
                {
                    <div>
                        <dt class="text-[13px] text-ink-500">@detail.Label</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@detail.Value</dd>
                    </div>
                }
            </dl>

            @if (!string.IsNullOrWhiteSpace(lead.AdditionalRequirements))
            {
                <div class="mt-6 border-t border-ink-100 pt-5">
                    <p class="text-[13px] text-ink-500">Your notes</p>
                    <p class="mt-1.5 whitespace-pre-line text-sm leading-relaxed text-ink-800">@lead.AdditionalRequirements</p>
                </div>
            }
        </section>

        <form method="post" action="/my-request/sign-out" class="mt-6">
            @Html.AntiForgeryToken()
            <button type="submit" class="text-sm font-medium text-ink-500 hover:text-ink-900">
                Sign out of this request
            </button>
        </form>
    </div>
</section>
