@model CreateReviewViewModel
@{
    var words = new[] { "", "Poor", "Fair", "Good", "Very good", "Excellent" };
}

<section class="bg-paper">
    <div class="mx-auto max-w-xl px-5 pb-16 pt-28 sm:px-8 lg:pt-36">

        <a href="/my-request" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 hover:text-ink-900">
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M16 10H5M9 6l-4 4 4 4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Back to your request
        </a>

        <h1 class="mt-5 font-display text-[clamp(1.75rem,4vw,2.5rem)] font-extrabold leading-tight tracking-[-0.04em] text-ink-900">
            How was your experience?
        </h1>
        <p class="mt-3 text-base leading-relaxed text-ink-600">
            <span class="font-semibold text-ink-900">@Model.VendorName</span> &middot; @Model.Route
        </p>

        <div asp-validation-summary="ModelOnly"
             class="mt-6 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 rounded-card empty:hidden"></div>

        <form method="post" action="/my-request/review" class="mt-7 border border-ink-200 bg-white p-6 rounded-panel sm:p-7">
            @Html.AntiForgeryToken()

            @* Real radio inputs: arrow keys work, the form submits without
               JavaScript, and the server validates the value regardless. *@
            <fieldset data-star-group>
                <legend class="text-[13px] font-semibold text-ink-800">Your rating</legend>

                <div class="mt-3 flex items-center gap-1">
                    @for (var star = 1; star <= 5; star++)
                    {
                        var isChecked = Model.Rating == star;
                        <label data-star="@star" class="star-label" title="@words[star]">
                            <input type="radio" name="Rating" value="@star" checked="@isChecked"
                                   class="sr-only" aria-label="@star out of 5 stars" />
                            <svg class="h-9 w-9" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M10 2.5l2.2 4.7 5 .7-3.6 3.6.9 5.1-4.5-2.5-4.5 2.5.9-5.1L2.8 7.9l5-.7z" />
                            </svg>
                        </label>
                    }

                    <span data-star-output class="ml-3 text-sm font-medium text-ink-600"></span>
                </div>

                <span asp-validation-for="Rating" class="mt-2 block text-sm text-red-600"></span>
            </fieldset>

            <div class="mt-6">
                <label asp-for="Title" class="block text-[13px] font-semibold text-ink-800"></label>
                <input asp-for="Title" placeholder="e.g. Careful team, arrived on time"
                       class="mt-2 block h-12 w-full border border-ink-200 px-3 text-[15px] text-ink-900 placeholder:text-ink-400 rounded-card focus:border-jade-500" />
                <span asp-validation-for="Title" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div class="mt-5">
                <label asp-for="Comment" class="block text-[13px] font-semibold text-ink-800"></label>
                <textarea asp-for="Comment" rows="5" placeholder="How was the packing, the timing, the handling? What would you tell a friend?"
                          class="mt-2 block w-full border border-ink-200 px-3 py-2.5 text-[15px] text-ink-900 placeholder:text-ink-400 rounded-card focus:border-jade-500"></textarea>
                <span asp-validation-for="Comment" class="mt-1 block text-sm text-red-600"></span>
                <p class="mt-1.5 text-xs text-ink-400">Between 10 and 1000 characters.</p>
            </div>

            <button type="submit"
                    class="mt-6 h-12 w-full bg-jade-500 text-[15px] font-semibold text-ink-950 rounded-card transition-colors hover:bg-jade-400">
                @(Model.IsEdit ? "Save changes" : "Submit review")
            </button>

            <p class="mt-4 text-xs leading-relaxed text-ink-400">
                Reviews are checked by our team before they're published. Your review shows your
                first name and last initial only.
            </p>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/review-form.js" asp-append-version="true" defer></script>
}
