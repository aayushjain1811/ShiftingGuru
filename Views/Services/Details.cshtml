@model ServiceDetailsViewModel

@{
    var service = Model.Service;
    var reasons = new (string Title, string Body)[]
    {
        ("Verified professionals", "Partner details are checked before they can receive your requirement."),
        ("Multiple quotes", "One enquiry reaches several providers, so you're not stuck with a single price."),
        ("Transparent scope", "Offers state what's included, which is where cheap quotes usually differ."),
        ("No booking fee", "Collecting quotes through ShiftingGuru costs you nothing.")
    };
}

<!-- ============ 1 + 2. Breadcrumb and hero ============ -->
<section class="relative overflow-hidden border-b border-ink-100 bg-hero pt-28 lg:pt-40">

    @* This service's own photograph, settling slowly as the page loads.
       The filename is the slug, so every service gets its own without any
       extra configuration. *@
    <img src="~/images/services/@(service.Slug).webp"
         alt=""
         class="photo-drift absolute inset-0 h-full w-full object-cover object-center lg:object-right"
         width="1280" height="854" fetchpriority="high" decoding="async" aria-hidden="true" />

    @* Cream on the left so the heading reads, clearing to the right so the
       photograph is actually visible. On phones it washes the whole image. *@
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(254,253,251,0.95)_0%,rgba(254,253,251,0.85)_55%,rgba(254,253,251,0.7)_100%)] lg:bg-[linear-gradient(90deg,rgba(254,253,251,1)_0%,rgba(254,253,251,0.97)_38%,rgba(254,253,251,0.75)_56%,rgba(254,253,251,0)_86%)]" aria-hidden="true"></div>

    <div class="pointer-events-none absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-hero via-hero/70 to-transparent lg:h-32" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-hero to-transparent" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-[1400px] px-5 pb-20 sm:px-8 lg:pb-28">

        @* Breadcrumb wraps instead of overflowing on narrow screens. *@
        <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-500">
                <li><a href="/" class="underline-grow transition-colors hover:text-jade-500">Home</a></li>
                <li class="text-ink-300" aria-hidden="true">/</li>
                <li><a href="/services" class="underline-grow transition-colors hover:text-jade-500">Services</a></li>
                <li class="text-ink-300" aria-hidden="true">/</li>
                <li><span class="font-medium text-ink-900" aria-current="page">@service.Name</span></li>
            </ol>
        </nav>

        <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-10">

            <div class="lg:col-span-7">
                <p class="hero-in hero-in-1 flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.14em] text-jade-500">
                    <span class="h-px w-8 bg-jade-500" aria-hidden="true"></span>
                    @service.Name
                </p>

                <h1 class="hero-in hero-in-2 mt-7 max-w-[16ch] font-display text-[clamp(2.5rem,6.5vw,4.75rem)] font-extrabold leading-[0.98] tracking-[-0.045em] text-ink-900">
                    @service.HeroTitle
                </h1>

                <p class="hero-in hero-in-3 mt-8 max-w-xl text-lg leading-relaxed text-ink-700">
                    @service.HeroDescription
                </p>

                <div class="hero-in hero-in-4 mt-10 flex flex-wrap gap-4">
                    <a href="/quote"
                       class="lift group inline-flex h-13 items-center gap-2 bg-jade-500 px-7 text-base font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                        Get Free Quotes
                        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1.5"
                             viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                            <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                    <a href="#how-it-works"
                       class="lift inline-flex h-13 items-center border border-ink-300 bg-white px-7 text-base font-semibold text-ink-900 shadow-card rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">
                        How It Works
                    </a>
                </div>
            </div>

            <div class="hero-in hero-in-5 lg:col-span-4 lg:col-start-9">
                <div class="border border-ink-200 bg-white p-7 shadow-float rounded-panel">
                    <svg class="h-7 w-7 text-jade-500" viewBox="0 0 20 20" fill="none"
                         stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                        <path d="@service.IconPath" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <p class="mt-6 text-[13px] font-semibold uppercase tracking-[0.14em] text-ink-500">
                        This service covers
                    </p>
                    <ul class="mt-4 space-y-3">
                        @foreach (var feature in service.Features.Take(4))
                        {
                            <li class="flex items-start gap-2.5">
                                <svg class="mt-1.5 h-3 w-3 shrink-0 text-success-600" viewBox="0 0 20 20" fill="none"
                                     stroke="currentColor" stroke-width="3" aria-hidden="true">
                                    <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <span class="text-[15px] text-ink-700">@feature.Title</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ 3. Quote strip ============ -->
<section class="border-b border-ink-100 bg-paper" aria-label="Get free quotes">
    <div class="mx-auto flex max-w-[1400px] flex-col gap-5 px-5 py-8 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
        <p class="font-display text-lg font-bold tracking-[-0.02em] text-ink-900">
            Ready to compare @service.Name.ToLowerInvariant() quotes?
        </p>
        <a href="/quote"
           class="lift inline-flex h-12 shrink-0 items-center justify-center bg-jade-500 px-6 text-[15px] font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
            Get Free Quotes
        </a>
    </div>
</section>

<!-- ============ 4. Overview ============ -->
<section class="bg-white" aria-labelledby="overview-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">
        <div class="grid gap-10 lg:grid-cols-12">

            <h2 id="overview-heading"
                class="reveal-left lg:col-span-4 font-display text-[clamp(2rem,4.2vw,3.25rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                About this service
            </h2>

            <div class="reveal-right lg:col-span-7 lg:col-start-6">
                @foreach (var paragraph in service.Overview)
                {
                    <p class="mb-6 max-w-[62ch] text-lg leading-relaxed text-ink-700 last:mb-0">@paragraph</p>
                }
            </div>
        </div>
    </div>
</section>

<!-- ============ 5. What's included ============ -->
<section class="border-y border-ink-100 bg-paper" aria-labelledby="includes-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">

        <h2 id="includes-heading"
            class="reveal-up max-w-2xl font-display text-[clamp(2rem,4.5vw,3.5rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
            What @service.Name.ToLowerInvariant() includes
        </h2>

        <ol class="stagger mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @for (var i = 0; i < service.Features.Count; i++)
            {
                <li class="reveal-scale border border-ink-200 bg-white p-6 shadow-card rounded-panel sm:p-7">
                    <span class="font-display text-sm font-bold text-jade-500">@((i + 1).ToString("00"))</span>
                    <h3 class="mt-3 font-display text-lg font-bold tracking-[-0.03em] text-ink-900">@service.Features[i].Title</h3>
                    <p class="mt-2.5 max-w-[34ch] text-[15px] leading-relaxed text-ink-500">@service.Features[i].Body</p>
                </li>
            }
        </ol>
    </div>
</section>

<!-- ============ 6. Why choose ShiftingGuru ============ -->
<section class="bg-white" aria-labelledby="why-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">

        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
            <h2 id="why-heading"
                class="reveal-up lg:col-span-6 font-display text-[clamp(2rem,4.5vw,3.5rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                Why choose ShiftingGuru
            </h2>
            <p class="reveal-up lg:col-span-4 lg:col-start-9 text-base leading-relaxed text-ink-500">
                We're not a moving company. We're the layer that helps you find the right one.
            </p>
        </div>

        <ul class="stagger mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var reason in reasons)
            {
                <li class="reveal-up border-t border-ink-200 pt-6">
                    <h3 class="font-display text-lg font-bold tracking-[-0.03em] text-ink-900">@reason.Title</h3>
                    <p class="mt-2.5 text-[15px] leading-relaxed text-ink-500">@reason.Body</p>
                </li>
            }
        </ul>
    </div>
</section>

<!-- ============ 7. How it works ============ -->
<section id="how-it-works" class="journey scroll-mt-24 overflow-hidden border-y border-ink-100 bg-paper" aria-labelledby="how-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">

        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
            <h2 id="how-heading"
                class="reveal-up lg:col-span-7 font-display text-[clamp(2rem,4.5vw,3.5rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                How it works
            </h2>
            <p class="reveal-up lg:col-span-4 lg:col-start-9 text-base leading-relaxed text-ink-500">
                From your first @service.Name.ToLowerInvariant() request to final delivery.
            </p>
        </div>

        <partial name="_Journey" />
    </div>
</section>

<<!-- ============ 8. Service-specific benefits ============ -->
<section class="bg-white" aria-labelledby="benefits-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">

        <h2 id="benefits-heading"
            class="reveal-up max-w-2xl font-display text-[clamp(2rem,4.5vw,3.5rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
            Why this works well for @service.Name.ToLowerInvariant()
        </h2>

        <ul class="reveal-scale mt-14 grid gap-px overflow-hidden border border-ink-200 bg-ink-200 shadow-card rounded-panel sm:grid-cols-2">
            @foreach (var benefit in service.Benefits)
            {
                <li class="bg-white p-7 lg:p-9">
                    <h3 class="font-display text-lg font-bold tracking-[-0.03em] text-ink-900">@benefit.Title</h3>
                    <p class="mt-2.5 max-w-[40ch] text-[15px] leading-relaxed text-ink-500">@benefit.Body</p>
                </li>
            }
        </ul>
    </div>
</section>

<!-- ============ 9. FAQ ============ -->
<section id="faq" class="scroll-mt-24 border-y border-ink-100 bg-paper" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">
        <div class="grid gap-10 lg:grid-cols-12">

            <h2 id="faq-heading"
                class="reveal-left lg:col-span-4 font-display text-[clamp(2rem,4.2vw,3.25rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                @service.Name questions
            </h2>

            @* Same id and data attributes the homepage accordion uses, so the
               existing site.js drives this with no extra JavaScript. *@
            <div id="faq-list" class="reveal-right lg:col-span-7 lg:col-start-6 divide-y divide-ink-100 border border-ink-200 bg-white px-5 shadow-card rounded-panel sm:px-7">
                @for (var i = 0; i < service.Faqs.Count; i++)
                {
                    var panelId = "faq-panel-" + i;
                    var buttonId = "faq-button-" + i;

                    <div>
                        <h3>
                            <button type="button" id="@buttonId" data-faq-question
                                    aria-expanded="false" aria-controls="@panelId"
                                    class="flex w-full items-center justify-between gap-6 py-6 text-left">
                                <span class="font-display text-lg font-semibold tracking-[-0.02em] text-ink-900">@service.Faqs[i].Question</span>
                                <svg class="faq-icon h-5 w-5 shrink-0 text-jade-500" viewBox="0 0 20 20" fill="none"
                                     stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M10 4v12M4 10h12" stroke-linecap="round" />
                                </svg>
                            </button>
                        </h3>

                        <div id="@panelId" class="faq-panel pb-6" role="region" aria-labelledby="@buttonId">
                            <p class="max-w-[62ch] text-[15px] leading-relaxed text-ink-500">@service.Faqs[i].Answer</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- ============ Related services ============ -->
@if (Model.RelatedServices.Count > 0)
{
    <section class="border-y border-ink-100 bg-paper" aria-labelledby="related-heading">
        <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-24">

            <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
                <h2 id="related-heading"
                    class="reveal-up lg:col-span-7 font-display text-[clamp(2rem,4.5vw,3.5rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                    Other services
                </h2>
                <p class="reveal-up lg:col-span-4 lg:col-start-9 text-base leading-relaxed text-ink-500">
                    Moving more than one thing? Everything can go through the same enquiry.
                </p>
            </div>

            @* Same photo cards as the homepage, so a service page and the
               homepage never look like two different sites. *@
            <ul class="stagger mt-14 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-5">
                @foreach (var related in Model.RelatedServices)
                {
                    <partial name="_ServiceCard" model="related" />
                }
            </ul>

            <div class="mt-12">
                <a href="/services"
                   class="group inline-flex items-center gap-2 text-base font-semibold text-jade-500 transition-colors hover:text-jade-600">
                    See all services
                    <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1.5"
                         viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                        <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>
        </div>
    </section>
}

<!-- ============ Service FAQs ============ -->
<partial name="_Faqs" model="Model.Faqs" />

<!-- ============ 10. Final CTA ============ -->
<partial name="_QuoteCta" />