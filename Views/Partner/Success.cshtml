@{
    var vendorNumber = ViewData["VendorNumber"] as string;
    var businessName = ViewData["BusinessName"] as string;
}

<section class="relative overflow-hidden bg-hero pt-28 pb-20 lg:pt-40 lg:pb-28">
    @* Extremely faint arcs, the same decoration as the homepage hero. *@
    <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 1440 620"
         preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
        <path d="M880 -60 A 560 560 0 0 0 1500 620" stroke="rgb(49 86 198 / 0.07)" stroke-width="1.5" />
        <path d="M1000 -60 A 440 440 0 0 0 1500 460" stroke="rgb(49 86 198 / 0.05)" stroke-width="1.5" />
    </svg>

    <div class="relative mx-auto max-w-[1400px] px-5 sm:px-8">
        <div class="max-w-2xl">

            <span class="grid h-14 w-14 place-items-center border border-success-200 bg-success-50 rounded-card" aria-hidden="true">
                <svg class="h-7 w-7 text-success-600" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4">
                    <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>

            <h1 class="mt-9 font-display text-[clamp(2.25rem,5.5vw,4rem)] font-extrabold leading-[0.98] tracking-[-0.045em] text-ink-900">
                Application received
            </h1>

            <p class="mt-7 text-lg leading-relaxed text-ink-700">
                Thanks@(string.IsNullOrEmpty(businessName) ? "" : $", {businessName}"). Your partner application
                has been submitted successfully.
            </p>

            <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-500">
                Our team will review your business details and notify you once your account
                is approved. You won't be able to sign in to the partner dashboard until then.
            </p>

            @if (!string.IsNullOrEmpty(vendorNumber))
            {
                <div class="mt-8 inline-flex flex-col border border-ink-200 bg-white px-6 py-4 shadow-card rounded-panel">
                    <span class="text-[13px] font-semibold uppercase tracking-[0.14em] text-ink-500">Your reference</span>
                    <span class="mt-1 font-display text-xl font-bold tracking-[-0.02em] text-ink-900">@vendorNumber</span>
                </div>
            }

            <div class="mt-10 flex flex-wrap gap-4">
                <a href="/" class="inline-flex h-13 items-center bg-jade-500 px-7 text-base font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                    Back to Home
                </a>
                <a href="/services" class="inline-flex h-13 items-center border border-ink-300 bg-white px-7 text-base font-semibold text-ink-900 rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">
                    Explore Services
                </a>
            </div>
        </div>
    </div>
</section>
