@{
    var locations = new (string City, string Slug)[]
    {
        ("Delhi", "delhi"), ("Gurgaon", "gurgaon"), ("Noida", "noida"),
        ("Mumbai", "mumbai"), ("Bangalore", "bangalore"), ("Pune", "pune"),
        ("Hyderabad", "hyderabad"), ("Chennai", "chennai"), ("Kolkata", "kolkata"),
        ("Jaipur", "jaipur")
    };
}

<section id="locations" class="scroll-mt-24 bg-white" aria-labelledby="locations-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">

        <div class="grid gap-10 lg:grid-cols-12">

            <div class="lg:col-span-4">
                <h2 id="locations-heading"
                    class="font-display text-[clamp(2rem,4.2vw,3.25rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                    Moving from or to somewhere?
                </h2>
                <p class="mt-5 max-w-xs text-base leading-relaxed text-ink-500">
                    Start with your city and see what's available there.
                </p>
            </div>

            @* An index list rather than a bag of pill chips. Reads like a
               directory, which is what it is. *@
            <ul class="lg:col-span-7 lg:col-start-6 grid grid-cols-1 gap-px overflow-hidden border border-ink-200 bg-ink-200 shadow-card rounded-panel sm:grid-cols-2">
                @foreach (var location in locations)
                {
                    <li>
                        <a href="/locations/@location.Slug"
                           class="fill-row fill-row-soft group flex items-center justify-between bg-white px-4 py-4 sm:px-5">
                            <span class="font-display text-base font-semibold tracking-[-0.02em] text-ink-900 transition-colors group-hover:text-jade-600">
                                @location.City
                            </span>
                            <svg class="h-3.5 w-3.5 text-ink-300 transition-all duration-200 group-hover:translate-x-1 group-hover:text-jade-500"
                                 viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </li>
                }
            </ul>
        </div>

        <div class="mt-10">
            <a href="/locations" class="group inline-flex items-center gap-2 text-base font-semibold text-jade-500 transition-colors hover:text-jade-600">
                See all cities
                <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1.5"
                     viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
        </div>
    </div>
</section>
