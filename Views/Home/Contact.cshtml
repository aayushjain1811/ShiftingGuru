@{
    ViewData["Title"] = "Contact Us";
    ViewData["MetaDescription"] =
        "Contact ShiftingGuru by phone, WhatsApp or email for car transport, home shifting and logistics across India.";

    // ---------------------------------------------------------------
    // TODO: replace every value below with your real details.
    // phoneDigits is used for the tel: and WhatsApp links, so it must be
    // digits only with the country code and no spaces.
    // ---------------------------------------------------------------
    var phoneDisplay = "+91 9812015400";
    var phoneDigits = "919812015400";
    var email = "rahul@goyalcarcarrier.com";
    var addressLines = new[] { "Goyal Car Carrier", "Shop no 6, Bhardwaj Complex, near pareena laxmi apartment, Sector 99A", "Gurugram, Haryana-122505" };
    var hours = "Monday to Saturday, 9:00 AM to 7:00 PM";
}

<section class="relative overflow-hidden border-b border-ink-100 bg-hero pb-16 pt-28 lg:pb-20 lg:pt-40">

    @* Extremely faint arcs, the same decoration as the homepage hero. *@
    <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 1440 620"
         preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
        <path d="M880 -60 A 560 560 0 0 0 1500 620" stroke="rgb(49 86 198 / 0.07)" stroke-width="1.5" />
        <path d="M1000 -60 A 440 440 0 0 0 1500 460" stroke="rgb(49 86 198 / 0.05)" stroke-width="1.5" />
    </svg>

    <div class="relative mx-auto max-w-[1400px] px-5 sm:px-8">

        <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-500">
                <li><a href="/" class="transition-colors hover:text-jade-500">Home</a></li>
                <li class="text-ink-300" aria-hidden="true">/</li>
                <li><span class="font-medium text-ink-900" aria-current="page">Contact</span></li>
            </ol>
        </nav>

        <h1 class="mt-10 max-w-[18ch] font-display text-[clamp(2.25rem,5.5vw,4rem)] font-extrabold leading-[1.02] tracking-[-0.045em] text-ink-900">
            Talk to a person.
        </h1>

        <p class="mt-7 max-w-[54ch] text-lg leading-relaxed text-ink-500">
            Call or message us for anything: a quick price check, a date you are not sure about,
            or a vehicle that needs collecting from an address we have not covered before.
        </p>
    </div>
</section>

<!-- Ways to reach us -->
<section class="bg-paper" aria-labelledby="reach-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8 lg:py-20">

        <h2 id="reach-heading" class="sr-only">How to reach us</h2>

        <div class="grid gap-5 lg:grid-cols-3">

            <!-- Phone -->
            <div class="border border-ink-200 bg-white p-7 shadow-card rounded-panel">
                <svg class="h-6 w-6 text-jade-500" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path d="M4 3h3l1.5 4-2 1.5a10 10 0 005 5L13 11.5 17 13v3a1 1 0 01-1.1 1A14 14 0 013 4.1 1 1 0 014 3z"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>

                <h3 class="mt-5 font-display text-lg font-bold tracking-[-0.02em] text-ink-900">Call us</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-ink-500">Fastest for urgent pickups.</p>

                <a href="tel:+@phoneDigits"
                   class="mt-4 inline-block font-display text-xl font-bold tracking-[-0.02em] text-jade-500 transition-colors hover:text-jade-600">
                    @phoneDisplay
                </a>

                <p class="mt-3 text-sm text-ink-500">@hours</p>
            </div>

            <!-- WhatsApp -->
            <div class="border border-ink-200 bg-white p-7 shadow-card rounded-panel">
                <svg class="h-6 w-6 text-success-600" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path d="M3 17l1.2-3.4A7 7 0 1110 17a7 7 0 01-3.4-.9L3 17z" stroke-linecap="round" stroke-linejoin="round" />
                </svg>

                <h3 class="mt-5 font-display text-lg font-bold tracking-[-0.02em] text-ink-900">WhatsApp</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-ink-500">
                    Send photos of the vehicle or goods and we can quote faster.
                </p>

                <a href="https://wa.me/@phoneDigits" target="_blank" rel="noopener"
                   class="mt-4 inline-flex h-11 items-center border border-ink-300 bg-white px-5 text-[15px] font-semibold text-ink-900 rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">
                    Message on WhatsApp
                </a>
            </div>

            <!-- Email -->
            <div class="border border-ink-200 bg-white p-7 shadow-card rounded-panel">
                <svg class="h-6 w-6 text-jade-500" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path d="M3 5h14v10H3z" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M3 6l7 5 7-5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>

                <h3 class="mt-5 font-display text-lg font-bold tracking-[-0.02em] text-ink-900">Email</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-ink-500">
                    Best for documents, invoices and corporate bookings.
                </p>

                <a href="mailto:@email"
                   class="mt-4 inline-block break-all text-[15px] font-semibold text-jade-500 transition-colors hover:text-jade-600">
                    @email
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Office and quote -->
<section class="border-y border-ink-100 bg-white" aria-labelledby="office-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-24">

        <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">

            <div class="lg:col-span-6">
                <h2 id="office-heading" class="font-display text-[clamp(1.75rem,4vw,2.5rem)] font-bold leading-tight tracking-[-0.04em] text-ink-900">
                    Our office
                </h2>

                <address class="mt-7 space-y-1 text-[17px] not-italic leading-relaxed text-ink-700">
                    @foreach (var line in addressLines)
                    {
                        <p>@line</p>
                    }
                </address>

                <p class="mt-6 text-[15px] leading-relaxed text-ink-500">
                    Visits are welcome during working hours. Call first if you are coming about
                    a specific booking, so the right person is available.
                </p>
            </div>

            <div class="lg:col-span-6">
                <div class="border border-ink-200 bg-paper p-7 shadow-card rounded-panel lg:p-9">
                    <h2 class="font-display text-[22px] font-bold tracking-[-0.03em] text-ink-900">
                        Prefer to compare quotes?
                    </h2>
                    <p class="mt-3 text-[15px] leading-relaxed text-ink-500">
                        Tell us what you are moving and where it needs to go. Verified professionals
                        respond with what they would charge and what is included, and you choose.
                    </p>

                    <a href="/quote"
                       class="mt-7 inline-flex h-13 items-center bg-jade-500 px-7 text-base font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                        Get Free Quotes
                    </a>

                    <p class="mt-4 text-sm text-ink-500">Free to use. No obligation to book.</p>
                </div>
            </div>
        </div>
    </div>
</section>
