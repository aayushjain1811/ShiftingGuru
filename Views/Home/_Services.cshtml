@inject IServiceCatalog Catalog

@* Cards come from the same catalog that powers /services, so the homepage
   links can never drift out of sync with the pages that exist. *@
<section id="services" class="scroll-mt-24 border-y border-ink-100 bg-white" aria-labelledby="services-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">

        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
            <h2 id="services-heading"
                class="lg:col-span-7 font-display text-[clamp(2rem,4.5vw,3.5rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                Whatever you're moving, we've got you covered.
            </h2>
            <p class="lg:col-span-4 lg:col-start-9 text-base leading-relaxed text-ink-500">
                Pick the service that fits. Your requirement goes to professionals who
                actually handle that kind of work.
            </p>
        </div>

        <ul class="mt-14 grid grid-cols-2 gap-px overflow-hidden border border-ink-200 bg-ink-200 shadow-card rounded-panel lg:grid-cols-4">
            @foreach (var service in Catalog.GetAll())
            {
                <partial name="_ServiceCard" model="service" />
            }
        </ul>

        <div class="mt-12">
            <a href="/services"
               class="group inline-flex items-center gap-2 text-base font-semibold text-jade-500 transition-colors hover:text-jade-600">
                See all services
                <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1.5"
                     viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
        </div>
    </div>
</section>
