@using Microsoft.EntityFrameworkCore
@inject ShiftingGuru.Data.ApplicationDbContext Db

@{
    // Real reviews only: approved by an admin, and five stars. Newest first,
    // six at most. The name is the snapshot taken when the review was written
    // ("Aayush J."), never the lead's full name.
    var reviews = await Db.Reviews
        .AsNoTracking()
        .Where(r => r.Status == ReviewStatus.Approved && r.Rating == 5)
        .OrderByDescending(r => r.PublishedAt ?? r.CreatedAt)
        .Take(6)
        .Select(r => new
        {
            r.Title,
            r.Comment,
            Name = r.CustomerNameSnapshot,
            From = r.Lead!.MovingFrom,
            To = r.Lead.MovingTo,
            Service = r.Lead.ServiceName
        })
        .ToListAsync();
}

@* No approved five-star reviews yet: show nothing at all. An empty box or a
   made-up review does more harm to trust than a missing section. *@
@if (reviews.Count > 0)
{
    <section class="bg-white" aria-labelledby="reviews-heading">
        <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">

            <div class="flex flex-wrap items-end justify-between gap-6">
                <h2 id="reviews-heading"
                    class="reveal-up font-display text-[clamp(2rem,4.5vw,3.5rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                    What customers say
                </h2>
                <p class="reveal-up text-sm text-ink-500">
                    Verified reviews from completed moves
                </p>
            </div>

            @* Swipe rail on phones, a plain grid on desktop. *@
            <ul class="stagger no-scrollbar mt-14 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2 lg:grid lg:grid-cols-3 lg:overflow-visible lg:pb-0">
                @foreach (var review in reviews)
                {
                    var route = !string.IsNullOrWhiteSpace(review.From) && !string.IsNullOrWhiteSpace(review.To)
                        ? $"{review.From} to {review.To}"
                        : null;

                    <li class="reveal-up w-[86%] shrink-0 snap-start lg:w-auto">
                        <figure class="flex h-full flex-col border border-ink-200 bg-white p-7 shadow-card rounded-panel">

                            <div class="flex items-center gap-1.5" role="img" aria-label="5 out of 5 stars">
                                @for (var i = 0; i < 5; i++)
                                {
                                    <svg class="h-4 w-4 text-amber-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path d="M10 2.5l2.2 4.7 5 .7-3.6 3.6.9 5.1-4.5-2.5-4.5 2.5.9-5.1L2.8 7.9l5-.7z" />
                                    </svg>
                                }
                                <span class="ml-2 inline-flex items-center gap-1 rounded-full border border-success-200 bg-success-50 px-2 py-0.5 text-[11px] font-semibold text-success-600">
                                    <svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                                        <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    Verified move
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(review.Title))
                            {
                                <p class="mt-6 font-display text-lg font-bold tracking-[-0.02em] text-ink-900">
                                    @review.Title
                                </p>
                            }

                            <blockquote class="@(string.IsNullOrWhiteSpace(review.Title) ? "mt-6" : "mt-3") flex-1 text-[15px] leading-relaxed text-ink-700">
                                @review.Comment
                            </blockquote>

                            <figcaption class="mt-7 border-t border-ink-100 pt-5">
                                <p class="text-sm font-semibold text-ink-900">@review.Name</p>
                                <p class="mt-0.5 text-sm text-ink-500">
                                    @(route ?? review.Service)
                                </p>
                            </figcaption>
                        </figure>
                    </li>
                }
            </ul>
        </div>
    </section>
}