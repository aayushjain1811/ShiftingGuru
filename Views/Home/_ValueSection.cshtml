<section class="bg-white" aria-labelledby="value-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-28">

        <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-16">

            <div class="reveal-left lg:col-span-5">
                <h2 id="value-heading"
                    class="font-display text-[clamp(2rem,4.2vw,3.25rem)] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink-900">
                    Moving across the city or across the country?
                </h2>
                <p class="mt-6 text-xl leading-snug text-ink-700">
                    One platform. Multiple options. Better decisions.
                </p>
                <p class="mt-5 max-w-md text-base leading-relaxed text-ink-500">
                    Local shifts and long-distance relocations need different kinds of
                    providers. Describe your move once and see who is genuinely set up
                    to handle it.
                </p>

                <a href="#services"
                   class="group mt-9 inline-flex h-13 items-center gap-2 border border-ink-300 bg-white px-7 text-base font-semibold text-ink-900 rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">
                    Explore moving services
                    <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1.5"
                         viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                        <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>

            @* Drawn panel instead of a photograph: two pins, one route, a
               distance readout. Scales to any screen, no image request. *@
            <div class="reveal-right lg:col-span-7">
                <div class="relative overflow-hidden border border-ink-200 bg-hero shadow-card rounded-panel">
                    <svg class="block w-full" viewBox="0 0 760 480" fill="none" role="img"
                         aria-label="Illustration of a transport route between two cities">
                        <path d="M110 360 C 240 360, 250 190, 400 180 S 600 140, 660 120"
                              stroke="rgb(49 86 198 / 0.45)" stroke-width="2" stroke-dasharray="8 12" stroke-linecap="round" />
                        <circle cx="110" cy="360" r="7" fill="#3156C6" />
                        <circle cx="110" cy="360" r="18" fill="none" stroke="rgb(49 86 198 / 0.2)" />
                        <circle cx="660" cy="120" r="7" fill="#2F7D65" />
                        <circle cx="660" cy="120" r="18" fill="none" stroke="rgb(47 125 101 / 0.22)" />
                        <text x="110" y="404" text-anchor="middle" fill="#667085"
                              font-family="Inter, sans-serif" font-size="15">Pickup</text>
                        <text x="660" y="168" text-anchor="middle" fill="#667085"
                              font-family="Inter, sans-serif" font-size="15">Delivery</text>
                    </svg>

                    <div class="grid grid-cols-3 gap-px border-t border-ink-200 bg-ink-200">
                        <div class="bg-white p-5">
                            <p class="font-display text-2xl font-bold tracking-[-0.03em] text-ink-900">8</p>
                            <p class="mt-1 text-xs text-ink-500">Services</p>
                        </div>
                        <div class="bg-white p-5">
                            <p class="font-display text-2xl font-bold tracking-[-0.03em] text-ink-900">1</p>
                            <p class="mt-1 text-xs text-ink-500">Form to fill</p>
                        </div>
                        <div class="bg-white p-5">
                            <p class="font-display text-2xl font-bold tracking-[-0.03em] text-ink-900">0</p>
                            <p class="mt-1 text-xs text-ink-500">Booking fee</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>