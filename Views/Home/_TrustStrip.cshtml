@{
    var indicators = new (string Title, string Body)[]
    {
        ("Verified professionals", "Partner details are checked before they join."),
        ("Multiple quotes", "Several providers, not a single take-it-or-leave-it price."),
        ("Transparent options", "Compare scope and cost side by side."),
        ("Pan-India network", "Metro cities, tier-two cities and the routes between.")
    };
}

@* Extra top padding on desktop to clear the overlapping hero form card. *@
<section class="border-b border-ink-100 bg-paper pt-16 lg:pt-40" aria-label="Why customers use ShiftingGuru">
    <div class="mx-auto max-w-[1400px] px-5 pb-16 sm:px-8">
        <ul class="grid gap-y-9 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-10">
            @foreach (var item in indicators)
            {
                <li class="border-t border-ink-200 pt-5">
                    <p class="font-display text-[15px] font-bold tracking-[-0.02em] text-ink-900">@item.Title</p>
                    <p class="mt-2 max-w-[26ch] text-sm leading-relaxed text-ink-500">@item.Body</p>
                </li>
            }
        </ul>
    </div>
</section>
