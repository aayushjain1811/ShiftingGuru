@model QuoteRequestViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config

@{
    var requireOtp = ViewData["RequirePhoneOtp"] as bool? ?? true;
    var phoneVerified = !string.IsNullOrEmpty(Model.PhoneVerificationToken);
    var isStorage = Model.ServiceSlug == QuoteRequestViewModel.StorageSlug;

    var points = new[]
    {
        "Verified moving professionals",
        "Compare quotes in one place",
        "Free, with no obligation to book",
        "Across India and abroad"
    };

    const string fieldClasses = "mt-2 block h-12 w-full border border-ink-200 bg-white px-3 text-[15px] text-ink-900 placeholder:text-ink-400 rounded-card transition-colors focus:border-jade-500";
}

<section class="relative overflow-hidden bg-hero pt-28 pb-16 lg:pt-36 lg:pb-24">
    <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 1440 620"
         preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
        <path d="M880 -60 A 560 560 0 0 0 1500 620" stroke="rgb(49 86 198 / 0.07)" stroke-width="1.5" />
        <path d="M1000 -60 A 440 440 0 0 0 1500 460" stroke="rgb(49 86 198 / 0.05)" stroke-width="1.5" />
    </svg>

    <div class="relative mx-auto grid max-w-[1400px] gap-12 px-5 sm:px-8 lg:grid-cols-12 lg:gap-14">

        @* ---------- Left: message ---------- *@
        <div class="lg:col-span-5 lg:pt-6">
            <nav aria-label="Breadcrumb" class="hero-in hero-in-1">
                <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-500">
                    <li><a href="/" class="transition-colors hover:text-jade-500">Home</a></li>
                    <li class="text-ink-300" aria-hidden="true">/</li>
                    <li><span class="font-medium text-ink-900" aria-current="page">Get Free Quotes</span></li>
                </ol>
            </nav>

            <h1 class="hero-in hero-in-2 mt-10 font-display text-[clamp(2.25rem,5.5vw,4rem)] font-extrabold leading-[0.98] tracking-[-0.045em] text-ink-900">
                Get free moving quotes
            </h1>
            <p class="hero-in hero-in-3 mt-6 max-w-md text-lg leading-relaxed text-ink-500">
                Fill in the basics. Verified professionals who cover your route will call you
                with their price and what's included.
            </p>

            <ul class="hero-in hero-in-4 mt-10 space-y-4">
                @foreach (var point in points)
                {
                    <li class="flex items-center gap-3">
                        <svg class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <circle cx="10" cy="10" r="9" fill="#EBF5F1" />
                            <path d="M6 10.5l2.5 2.5 5.5-6" stroke="#2F7D65" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span class="text-[15px] font-medium text-ink-800">@point</span>
                    </li>
                }
            </ul>
        </div>

        @* ---------- Right: the short form ---------- *@
        <div class="lg:col-span-7">
            <form id="quote-form" method="post" asp-action="Index" novalidate
                  data-require-otp="@(requireOtp ? "true" : "false")"
                  data-fb-api-key="@Config["Firebase:ApiKey"]"
                  data-fb-auth-domain="@Config["Firebase:AuthDomain"]"
                  data-fb-project-id="@Config["Firebase:ProjectId"]"
                  class="hero-in hero-in-5 overflow-hidden border border-ink-200 bg-white shadow-float rounded-panel">

                <div class="border-b border-ink-100 px-6 py-5 text-center sm:px-8">
                    <h2 class="font-display text-[22px] font-bold tracking-[-0.03em] text-ink-900">
                        Get your <span class="text-jade-500">free</span> quote
                    </h2>
                    <p class="mt-1 text-sm text-ink-500">Takes less than a minute</p>
                </div>

                <div asp-validation-summary="ModelOnly"
                     class="border-b border-red-200 bg-red-50 px-6 py-4 text-sm text-red-700 empty:hidden"></div>

                <div class="grid gap-5 p-6 sm:grid-cols-2 sm:p-8">

                    <div>
                        <label asp-for="CustomerName" class="block text-[13px] font-semibold text-ink-800"></label>
                        <input asp-for="CustomerName" type="text" autocomplete="name" placeholder="Your name" class="@fieldClasses" />
                        <span asp-validation-for="CustomerName" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-[13px] font-semibold text-ink-800"></label>
                        <input asp-for="Email" type="email" autocomplete="email" placeholder="you@@example.com" class="@fieldClasses" />
                        <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    @* Mobile + OTP, full width *@
                    <div data-verify="phone" data-state="@(phoneVerified ? "ok" : null)" class="group sm:col-span-2">
                        <label asp-for="Phone" class="block text-[13px] font-semibold text-ink-800"></label>
                        <div class="mt-2 flex gap-2">
                            <span class="grid h-12 shrink-0 place-items-center border border-ink-200 bg-paper px-3 text-[15px] text-ink-500 rounded-card" aria-hidden="true">+91</span>
                            <input asp-for="Phone" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="10"
                                   placeholder="9876543210" data-verify-input
                                   class="block h-12 w-full min-w-0 flex-1 border border-ink-200 px-3 text-[15px] text-ink-900 placeholder:text-ink-400 rounded-card transition-colors focus:border-jade-500 group-data-[state=ok]:border-green-600" />
                            @if (requireOtp)
                            {
                                <button type="button" data-verify-send
                                        class="h-12 shrink-0 border border-ink-200 bg-white px-5 text-sm font-semibold text-ink-800 rounded-card transition-colors hover:border-jade-500 hover:text-jade-600 disabled:cursor-not-allowed disabled:opacity-50">
                                    @(phoneVerified ? "Verified" : "Verify")
                                </button>
                            }
                        </div>
                        <span asp-validation-for="Phone" class="mt-1 block text-sm text-red-600"></span>

                        @if (requireOtp)
                        {
                            <div data-verify-step hidden class="mt-3 flex gap-2">
                                <input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6"
                                       placeholder="6-digit code" aria-label="Mobile verification code" data-verify-code
                                       class="block h-12 w-40 border border-ink-200 px-3 text-[15px] tracking-[0.3em] text-ink-900 placeholder:tracking-normal placeholder:text-ink-400 rounded-card focus:border-jade-500" />
                                <button type="button" data-verify-check
                                        class="lift h-12 shrink-0 bg-jade-500 px-5 text-sm font-semibold text-white rounded-card transition-colors hover:bg-jade-600 disabled:opacity-50">
                                    Confirm
                                </button>
                            </div>

                            <p data-verify-status data-state="@(phoneVerified ? "ok" : "idle")" role="status" aria-live="polite"
                               class="mt-1.5 text-xs text-ink-500 data-[state=error]:text-red-600 data-[state=ok]:font-semibold data-[state=ok]:text-green-700">@(phoneVerified ? "✓ Mobile number verified" : "")</p>
                            <input asp-for="PhoneVerificationToken" type="hidden" data-verify-token />
                            <span asp-validation-for="PhoneVerificationToken" class="mt-1 block text-sm text-red-600"></span>
                        }
                    </div>

                    <div>
                        <label asp-for="ServiceSlug" class="block text-[13px] font-semibold text-ink-800"></label>
                        <select asp-for="ServiceSlug" class="@fieldClasses">
                            <option value="">Select a service</option>
                            @foreach (var service in Model.Services)
                            {
                                <option value="@service.Slug">@service.Name</option>
                            }
                        </select>
                        <span asp-validation-for="ServiceSlug" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label asp-for="MovingDate" class="block text-[13px] font-semibold text-ink-800">
                            Moving date <span class="font-normal text-ink-500">(optional)</span>
                        </label>
                        <input asp-for="MovingDate" type="date" class="@fieldClasses" />
                        <span asp-validation-for="MovingDate" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label asp-for="MovingFrom" data-from-label class="block text-[13px] font-semibold text-ink-800">
                            @(isStorage ? "Storage location" : "Moving from")
                        </label>
                        <input asp-for="MovingFrom" type="text" autocomplete="address-level2" placeholder="Gurugram" class="@fieldClasses" />
                        <span asp-validation-for="MovingFrom" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div data-to-field hidden="@isStorage">
                        <label asp-for="MovingTo" class="block text-[13px] font-semibold text-ink-800"></label>
                        <input asp-for="MovingTo" type="text" autocomplete="address-level2" placeholder="Bengaluru or Dubai" class="@fieldClasses" />
                        <span asp-validation-for="MovingTo" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div class="sm:col-span-2">
                        <label asp-for="AdditionalRequirements" class="block text-[13px] font-semibold text-ink-800">
                            Message <span class="font-normal text-ink-500">(optional)</span>
                        </label>
                        <textarea asp-for="AdditionalRequirements" rows="2" placeholder="Anything we should know, e.g. 2 BHK, 3rd floor, no lift"
                                  class="mt-2 block w-full border border-ink-200 bg-white px-3 py-2.5 text-[15px] text-ink-900 placeholder:text-ink-400 rounded-card transition-colors focus:border-jade-500"></textarea>
                        <span asp-validation-for="AdditionalRequirements" class="mt-1 block text-sm text-red-600"></span>
                    </div>
                </div>

                <div class="border-t border-ink-100 bg-paper p-6 sm:p-8">
                    <button type="submit" data-submit
                            class="lift group flex h-14 w-full items-center justify-center gap-2 bg-jade-500 px-6 text-base font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600 disabled:cursor-not-allowed disabled:opacity-50">
                        Get Free Quotes
                        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
                             viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                            <path d="M4 10h11M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>

                    @if (requireOtp)
                    {
                        <p data-submit-hint hidden class="mt-2 text-center text-xs font-medium text-ink-700">Verify your mobile number to continue.</p>
                    }

                    <p class="mt-3 text-center text-xs leading-relaxed text-ink-500">
                        By clicking Get Free Quotes, you agree that ShiftingGuru and its verified partners may contact you
                        about this request by call, SMS, WhatsApp or email. Free to use, no obligation to book.
                    </p>
                </div>

                @* Firebase puts its invisible "are you a robot" check here. *@
                <div id="recaptcha-container"></div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/quote.js" asp-append-version="true"></script>
}