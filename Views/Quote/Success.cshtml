@{
    var service = ViewData["SubmittedService"] as string;
    var leadNumber = ViewData["LeadNumber"] as string;
    var accessLink = ViewData["AccessLink"] as string;
}

<section class="relative overflow-hidden border-b border-ink-100 bg-hero pt-28 pb-20 lg:pt-40 lg:pb-28">
    @* Extremely faint arcs, the same decoration as the homepage hero. *@
    <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 1440 620"
         preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
        <path d="M880 -60 A 560 560 0 0 0 1500 620" stroke="rgb(49 86 198 / 0.07)" stroke-width="1.5" />
        <path d="M1000 -60 A 440 440 0 0 0 1500 460" stroke="rgb(49 86 198 / 0.05)" stroke-width="1.5" />
    </svg>

    <div class="relative mx-auto max-w-[1400px] px-5 sm:px-8">
        <div class="max-w-2xl">

            <span class="grid h-14 w-14 place-items-center border border-success-200 bg-success-50 rounded-card" aria-hidden="true">
                <svg class="h-7 w-7 text-success-600" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4">
                    <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>

            <h1 class="mt-9 font-display text-[clamp(2.25rem,5.5vw,4rem)] font-extrabold leading-[0.98] tracking-[-0.045em] text-ink-900">
                Request received
            </h1>

            <p class="mt-7 text-lg leading-relaxed text-ink-700">
                Thanks. We've received your
                @if (!string.IsNullOrEmpty(service))
                {
                    <span class="font-semibold text-ink-900">@service.ToLowerInvariant()</span>
                }
                requirement.
            </p>

            @if (!string.IsNullOrEmpty(leadNumber))
            {
                <div class="mt-8 inline-flex flex-col border border-ink-200 bg-white px-6 py-4 shadow-card rounded-panel">
                    <span class="text-[13px] font-semibold uppercase tracking-[0.14em] text-ink-500">Your reference</span>
                    <span class="mt-1 font-display text-xl font-bold tracking-[-0.02em] text-ink-900">@leadNumber</span>
                </div>
            }

            <p class="mt-8 max-w-xl text-base leading-relaxed text-ink-500">
                Our team can now review your request and connect you with relevant service
                providers. You'll be contacted using the details you gave us.
            </p>

            @* Development only. In production this link is emailed or texted;
               there is no delivery provider configured yet, so it is shown here
               rather than claiming a message was sent. *@
            @if (!string.IsNullOrEmpty(accessLink))
            {
                <div class="mt-8 max-w-xl border border-jade-100 bg-jade-50 p-5 rounded-panel">
                    <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-jade-600">
                        Your secure access link
                    </p>
                    <p class="mt-2 text-sm leading-relaxed text-ink-700">
                        Delivery by email or SMS isn't set up yet, so here's your link. Keep it
                        private - anyone with it can see your request and quotes.
                    </p>
                    <a href="@accessLink" class="mt-3 block break-all text-sm font-medium text-jade-500 underline decoration-jade-100 underline-offset-4 transition-colors hover:text-jade-600">
                        @accessLink
                    </a>
                </div>
            }

            <div class="mt-10 flex flex-wrap gap-4">
                <a href="/"
                   class="inline-flex h-13 items-center bg-jade-500 px-7 text-base font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                    Back to Home
                </a>
                <a href="/services"
                   class="inline-flex h-13 items-center border border-ink-300 bg-white px-7 text-base font-semibold text-ink-900 rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">
                    Explore Services
                </a>
            </div>
        </div>
    </div>
</section>

<section class="bg-paper" aria-labelledby="next-heading">
    <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-24">

        <h2 id="next-heading" class="font-display text-[clamp(1.75rem,3.5vw,2.5rem)] font-extrabold leading-[1.05] tracking-[-0.04em] text-ink-900">
            What happens next
        </h2>

        <ol class="mt-12 grid gap-5 lg:grid-cols-3">
            <li class="border border-ink-200 bg-white p-6 shadow-card rounded-panel sm:p-7">
                <span class="font-display text-sm font-bold text-jade-500">01</span>
                <h3 class="mt-3 font-display text-lg font-bold tracking-[-0.03em] text-ink-900">We review your requirement</h3>
                <p class="mt-2.5 max-w-[34ch] text-[15px] leading-relaxed text-ink-500">
                    We check the details and work out which providers cover your route and service.
                </p>
            </li>
            <li class="border border-ink-200 bg-white p-6 shadow-card rounded-panel sm:p-7">
                <span class="font-display text-sm font-bold text-jade-500">02</span>
                <h3 class="mt-3 font-display text-lg font-bold tracking-[-0.03em] text-ink-900">Providers get in touch</h3>
                <p class="mt-2.5 max-w-[34ch] text-[15px] leading-relaxed text-ink-500">
                    Relevant professionals contact you with what they'd charge and what's included.
                </p>
            </li>
            <li class="border border-ink-200 bg-white p-6 shadow-card rounded-panel sm:p-7">
                <span class="font-display text-sm font-bold text-jade-500">03</span>
                <h3 class="mt-3 font-display text-lg font-bold tracking-[-0.03em] text-ink-900">You compare and choose</h3>
                <p class="mt-2.5 max-w-[34ch] text-[15px] leading-relaxed text-ink-500">
                    Weigh scope, timing and price, then deal directly with the provider you pick.
                </p>
            </li>
        </ol>
    </div>
</section>
