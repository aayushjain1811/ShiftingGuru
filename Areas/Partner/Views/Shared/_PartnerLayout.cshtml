@{
    var business = ViewData["VendorBusinessName"] as string ?? "Partner";
    var path = Context.Request.Path.Value ?? "";

    var navItems = new (string Label, string Href)[]
    {
        ("Dashboard", "/partner/dashboard"),
        ("My Leads", "/partner/leads"),
        ("My Quotes", "/partner/quotes"),
        ("My Reviews", "/partner/reviews"),
        ("My Profile", "/partner/profile")
    };
}
<!DOCTYPE html>
<html lang="en-IN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] | ShiftingGuru Partners</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&display=swap" rel="stylesheet" />
    <partial name="_Favicons" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-dvh bg-paper font-sans text-ink-800">

<header class="border-b border-ink-200 bg-white">
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">

        <a href="/partner/dashboard" class="flex items-center gap-2.5">
            <partial name="_Logo" model="@("h-7 w-auto")" />
            <span class="text-[15px] font-bold tracking-tight text-ink-900">ShiftingGuru</span>
            <span class="hidden text-[13px] font-medium text-ink-500 sm:inline">Partners</span>
        </a>

        <nav class="flex items-center gap-1" aria-label="Partner">
            @foreach (var item in navItems)
            {
                var active = path.StartsWith(item.Href);
                <a href="@item.Href"
                   class="@(active ? "bg-jade-50 text-jade-600" : "text-ink-600 hover:bg-ink-50 hover:text-ink-900") px-3 py-2 text-sm font-medium rounded-card transition-colors">
                    @item.Label
                </a>
            }

            <form method="post" action="/partner/logout" class="ml-1">
                @Html.AntiForgeryToken()
                <button type="submit" class="px-3 py-2 text-sm font-medium text-ink-600 rounded-card transition-colors hover:bg-ink-50 hover:text-ink-900">
                    Logout
                </button>
            </form>
        </nav>
    </div>
</header>

<main class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
    @if (TempData["PartnerMessage"] is string ok)
    {
        <div class="mb-5 border border-jade-100 bg-jade-50 px-4 py-3 text-sm text-jade-600 rounded-card" role="status">@ok</div>
    }

    @RenderBody()
</main>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
