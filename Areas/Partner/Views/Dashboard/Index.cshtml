@model VendorDashboardViewModel
@{
    var vendor = Model.Vendor;
}

<div class="flex flex-wrap items-start justify-between gap-4">
    <div>
        <h1 class="text-xl font-bold tracking-tight text-ink-900">Welcome back, @vendor.ContactPerson</h1>
        <p class="mt-1 text-sm text-ink-500">@vendor.BusinessName &middot; @vendor.VendorNumber</p>
    </div>
    <span class="inline-flex items-center border border-emerald-200 bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-700 rounded-card">
        Approved partner
    </span>
</div>

<ul class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-3">
    <li class="border border-ink-200 bg-white p-4 rounded-card sm:p-5">
        <p class="text-[13px] font-medium text-ink-500">Assigned leads</p>
        <p class="mt-2 text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">@Model.AssignedLeads</p>
    </li>
    <li class="border border-ink-200 bg-white p-4 rounded-card sm:p-5">
        <p class="text-[13px] font-medium text-ink-500">New leads</p>
        <p class="mt-2 text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">@Model.NewLeads</p>
    </li>
    <li class="border border-ink-200 bg-white p-4 rounded-card sm:p-5">
        <p class="text-[13px] font-medium text-ink-500">Viewed leads</p>
        <p class="mt-2 text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">@Model.ViewedLeads</p>
    </li>
    <li class="border border-ink-200 bg-white p-4 rounded-card sm:p-5">
        <p class="text-[13px] font-medium text-ink-500">Quotes submitted</p>
        <p class="mt-2 text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">@Model.QuotesSubmitted</p>
    </li>
    <li class="border border-ink-200 bg-white p-4 rounded-card sm:p-5">
        <p class="text-[13px] font-medium text-ink-500">Quotes accepted</p>
        <p class="mt-2 text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">@Model.AcceptedQuotes</p>
    </li>
    <li class="border border-ink-200 bg-white p-4 rounded-card sm:p-5">
        <p class="text-[13px] font-medium text-ink-500">Rating</p>
        @if (Model.ReviewCount == 0)
        {
            <p class="mt-2 text-sm text-ink-500">No reviews yet</p>
        }
        else
        {
            <p class="mt-2 text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">
                @Model.AverageRating?.ToString("0.0") <span class="text-lg text-amber-400">&#9733;</span>
            </p>
            <p class="mt-1 text-xs text-ink-400">@Model.ReviewCount review(s)</p>
        }
    </li>
    <li class="border border-ink-200 bg-white p-4 rounded-card sm:p-5">
        <p class="text-[13px] font-medium text-ink-500">Profile complete</p>
        <p class="mt-2 text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">@Model.ProfileCompletion%</p>
    </li>
</ul>

<div class="mt-6 grid gap-4 lg:grid-cols-3">

    <section class="border border-ink-200 bg-white p-8 text-center lg:col-span-2 rounded-card" aria-labelledby="leads-heading">
        <h2 id="leads-heading" class="text-[15px] font-semibold text-ink-900">Your leads</h2>
        @if (Model.AssignedLeads == 0)
        {
            <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-ink-500">
                No leads assigned yet. Once our team starts matching customer enquiries to
                partners, the ones relevant to your services and locations will appear here.
            </p>
        }
        else
        {
            <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-ink-500">
                You have @Model.AssignedLeads lead@(Model.AssignedLeads == 1 ? "" : "s"),
                @Model.NewLeads of which you haven't opened yet.
            </p>
            <a href="/partner/leads"
               class="mt-5 inline-flex h-11 items-center bg-ink-900 px-5 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">
                View my leads
            </a>
        }
    </section>

    <section class="border border-ink-200 bg-white p-5 rounded-card" aria-labelledby="profile-heading">
        <h2 id="profile-heading" class="text-[15px] font-semibold text-ink-900">Your profile</h2>

        @if (Model.MissingProfileFields.Count > 0)
        {
            <p class="mt-2 text-sm leading-relaxed text-ink-500">
                Adding these helps us match you to the right enquiries:
            </p>
            <ul class="mt-3 space-y-1.5">
                @foreach (var field in Model.MissingProfileFields)
                {
                    <li class="text-sm text-ink-600">&middot; @field</li>
                }
            </ul>
        }
        else
        {
            <p class="mt-2 text-sm leading-relaxed text-ink-500">
                Your profile is complete. You can update it any time.
            </p>
        }

        <a href="/partner/profile"
           class="mt-5 inline-flex h-10 items-center bg-ink-900 px-4 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">
            Edit profile
        </a>
    </section>
</div>

<section class="mt-4 border border-ink-200 bg-white p-5 rounded-card" aria-labelledby="services-heading">
    <h2 id="services-heading" class="text-[15px] font-semibold text-ink-900">Services you offer</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
        @foreach (var service in vendor.Services)
        {
            <li class="border border-ink-200 px-3 py-1 text-sm text-ink-700 rounded-card">@service.ServiceName</li>
        }
    </ul>
</section>
