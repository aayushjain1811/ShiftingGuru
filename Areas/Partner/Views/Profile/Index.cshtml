@model VendorProfileViewModel

<div class="flex flex-wrap items-start justify-between gap-4">
    <div>
        <h1 class="text-xl font-bold tracking-tight text-ink-900">My profile</h1>
        <p class="mt-1 text-sm text-ink-500">@Model.VendorNumber</p>
    </div>
</div>

<div asp-validation-summary="ModelOnly"
     class="mt-5 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 rounded-card empty:hidden"></div>

<form method="post" asp-action="Index" class="mt-5 grid gap-4 lg:grid-cols-3">

    <div class="space-y-4 lg:col-span-2">

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Business</h2>

            <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div class="sm:col-span-2">
                    <label asp-for="BusinessName" class="block text-[13px] font-semibold text-ink-800"></label>
                    <input asp-for="BusinessName" class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                    <span asp-validation-for="BusinessName" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="ContactPerson" class="block text-[13px] font-semibold text-ink-800"></label>
                    <input asp-for="ContactPerson" class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                    <span asp-validation-for="ContactPerson" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Phone" class="block text-[13px] font-semibold text-ink-800"></label>
                    <input asp-for="Phone" type="tel" inputmode="tel" class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                    <span asp-validation-for="Phone" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="City" class="block text-[13px] font-semibold text-ink-800"></label>
                    <input asp-for="City" class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                    <span asp-validation-for="City" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="YearsOfExperience" class="block text-[13px] font-semibold text-ink-800"></label>
                    <input asp-for="YearsOfExperience" type="number" min="0" max="80" class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                    <span asp-validation-for="YearsOfExperience" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Address" class="block text-[13px] font-semibold text-ink-800"></label>
                    <input asp-for="Address" class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                    <span asp-validation-for="Address" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="GstNumber" class="block text-[13px] font-semibold text-ink-800"></label>
                    <input asp-for="GstNumber" class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                    <span asp-validation-for="GstNumber" class="mt-1 block text-sm text-red-600"></span>
                </div>
            </div>
        </section>

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Services and coverage</h2>

            <fieldset class="mt-4">
                <legend class="text-[13px] font-semibold text-ink-800">Services you offer</legend>
                <div class="mt-3 grid gap-2 sm:grid-cols-2">
                    @foreach (var service in Model.AvailableServices)
                    {
                        var isChecked = Model.ServicesOffered.Contains(service.Slug);
                        <label class="group cursor-pointer">
                            <input type="checkbox" name="ServicesOffered" value="@service.Slug"
                                   checked="@isChecked" class="peer sr-only" />
                            <span class="flex items-center gap-2.5 border border-ink-200 px-4 py-3 text-sm text-ink-800 rounded-card transition-colors peer-checked:border-ink-900 peer-checked:bg-ink-900 peer-checked:text-white">
                                @service.Name
                            </span>
                        </label>
                    }
                </div>
                <span asp-validation-for="ServicesOffered" class="mt-2 block text-sm text-red-600"></span>
            </fieldset>

            <div class="mt-4">
                <label asp-for="OperatingLocations" class="block text-[13px] font-semibold text-ink-800"></label>
                <input asp-for="OperatingLocations" placeholder="e.g. Delhi NCR, Jaipur, Chandigarh"
                       class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 placeholder:text-ink-400 rounded-card focus:border-jade-500" />
                <span asp-validation-for="OperatingLocations" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div class="mt-4">
                <label asp-for="AdditionalInformation" class="block text-[13px] font-semibold text-ink-800"></label>
                <textarea asp-for="AdditionalInformation" rows="4"
                          class="mt-2 block w-full border border-ink-200 px-3 py-2.5 text-[15px] text-ink-900 rounded-card focus:border-jade-500"></textarea>
                <span asp-validation-for="AdditionalInformation" class="mt-1 block text-sm text-red-600"></span>
            </div>
        </section>
    </div>

    <div class="lg:col-span-1">
        <section class="border border-ink-200 bg-white p-5 rounded-card lg:sticky lg:top-6">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Account</h2>

            @* Read-only. These are not form fields, so they cannot be posted. *@
            <dl class="mt-4 space-y-3">
                <div>
                    <dt class="text-[13px] text-ink-500">Email</dt>
                    <dd class="mt-0.5 truncate text-sm text-ink-800">@Model.Email</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Partner number</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@Model.VendorNumber</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Status</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@Model.Status</dd>
                </div>
            </dl>

            <p class="mt-4 border-t border-ink-100 pt-4 text-xs leading-relaxed text-ink-400">
                Contact our team if you need to change your email address or account status.
            </p>

            <button type="submit"
                    class="mt-5 h-11 w-full bg-ink-900 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">
                Save changes
            </button>
        </section>
    </div>
</form>
