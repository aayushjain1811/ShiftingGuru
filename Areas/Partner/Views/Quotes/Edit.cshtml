@model EditQuoteViewModel
@{
    var lead = Model.Lead;

    var charges = new (string Name, string Label, decimal Value)[]
    {
        (nameof(Model.BasePrice), "Base price", Model.BasePrice),
        (nameof(Model.PackingCharges), "Packing charges", Model.PackingCharges),
        (nameof(Model.TransportationCharges), "Transportation charges", Model.TransportationCharges),
        (nameof(Model.LoadingUnloadingCharges), "Loading / unloading", Model.LoadingUnloadingCharges),
        (nameof(Model.AdditionalCharges), "Additional charges", Model.AdditionalCharges)
    };
}

<div class="flex flex-wrap items-center justify-between gap-3">
    <a href="/partner/quotes" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 hover:text-ink-900">
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M16 10H5M9 6l-4 4 4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        My quotes
    </a>
</div>

<h1 class="mt-4 text-xl font-bold tracking-tight text-ink-900">Edit quote @Model.QuoteNumber</h1>
<p class="mt-1 text-sm text-ink-500">
    @lead.LeadNumber &middot; @lead.ServiceName &middot;
    @(lead.MovingFrom is null ? lead.StorageLocation ?? "-" : $"{lead.MovingFrom} to {lead.MovingTo}")
</p>

<div asp-validation-summary="ModelOnly"
     class="mt-5 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 rounded-card empty:hidden"></div>

<form id="quote-form" method="post" class="mt-5 grid gap-4 lg:grid-cols-3">

    <div class="space-y-4 lg:col-span-2">

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Pricing</h2>
            <p class="mt-1.5 text-sm text-ink-500">Enter amounts in rupees. Leave a line at zero if it doesn't apply.</p>

            <div class="mt-4 space-y-4">
                @foreach (var charge in charges)
                {
                    <div class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-center">
                        <label for="@charge.Name" class="text-sm font-medium text-ink-800">@charge.Label</label>
                        <input id="@charge.Name" name="@charge.Name" type="number" inputmode="decimal"
                               step="0.01" min="0" value="@charge.Value.ToString("0.##")" data-price
                               class="h-11 w-full border border-ink-200 px-3 text-right text-[15px] text-ink-900 rounded-card focus:border-jade-500 sm:w-48" />
                    </div>
                }
            </div>

            @* Convenience only - the server adds these up again on submit. *@
            <div class="mt-5 flex items-center justify-between border-t border-ink-200 pt-4">
                <span class="text-sm font-semibold text-ink-900">Total</span>
                <span data-quote-total class="text-xl font-bold tracking-tight text-ink-900">@Money.Format(Model.Total)</span>
            </div>
        </section>

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Timing</h2>

            <div class="mt-4 grid gap-4 sm:grid-cols-3">
                <div>
                    <label asp-for="EstimatedPickupDate" class="block text-[13px] font-semibold text-ink-800"></label>
                    <input asp-for="EstimatedPickupDate" type="date"
                           class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                    <span asp-validation-for="EstimatedPickupDate" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="EstimatedDeliveryDate" class="block text-[13px] font-semibold text-ink-800"></label>
                    <input asp-for="EstimatedDeliveryDate" type="date"
                           class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                    <span asp-validation-for="EstimatedDeliveryDate" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="EstimatedDeliveryDays" class="block text-[13px] font-semibold text-ink-800"></label>
                    <input asp-for="EstimatedDeliveryDays" type="number" min="0" max="365"
                           class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                    <span asp-validation-for="EstimatedDeliveryDays" class="mt-1 block text-sm text-red-600"></span>
                </div>
            </div>
        </section>

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Notes</h2>
            <label asp-for="VendorNotes" class="mt-4 block text-[13px] font-semibold text-ink-800"></label>
            <textarea asp-for="VendorNotes" rows="4" placeholder="What's included, what isn't, anything the customer should know"
                      class="mt-2 block w-full border border-ink-200 px-3 py-2.5 text-[15px] text-ink-900 placeholder:text-ink-400 rounded-card focus:border-jade-500"></textarea>
            <span asp-validation-for="VendorNotes" class="mt-1 block text-sm text-red-600"></span>
        </section>
    </div>

    <div class="lg:col-span-1">
        <section class="border border-ink-200 bg-white p-5 rounded-card lg:sticky lg:top-6">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">The requirement</h2>

            <dl class="mt-4 space-y-3">
                <div>
                    <dt class="text-[13px] text-ink-500">Service</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@lead.ServiceName</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Route</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">
                        @(lead.MovingFrom is null ? lead.StorageLocation ?? "-" : $"{lead.MovingFrom} to {lead.MovingTo}")
                    </dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Date</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingDate?.ToString("d MMMM yyyy") ?? "Not given")</dd>
                </div>
            </dl>

            <button type="submit"
                    class="mt-5 h-12 w-full bg-jade-500 text-sm font-semibold text-ink-950 rounded-card transition-colors hover:bg-jade-400">
                Save changes
            </button>

            <p class="mt-3 text-xs leading-relaxed text-ink-400">
                You can edit your quote until it's accepted or rejected.
            </p>
        </section>
    </div>
</form>

@section Scripts {
    <script src="~/js/quote-form.js" asp-append-version="true" defer></script>
}
