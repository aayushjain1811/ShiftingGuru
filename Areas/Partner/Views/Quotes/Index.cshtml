@model PartnerQuoteListViewModel
@using ShiftingGuru.Areas.Admin
@{
    string Link(int page)
    {
        var parts = new List<string> { $"page={page}" };
        if (Model.Status.HasValue) parts.Add($"status={Model.Status}");
        return "/partner/quotes?" + string.Join("&", parts);
    }
}

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-xl font-bold tracking-tight text-ink-900">My quotes</h1>
        <p class="mt-1 text-sm text-ink-500">Offers you've submitted against assigned leads.</p>
    </div>

    <form method="get" action="/partner/quotes" class="flex items-end gap-2">
        <div>
            <label for="status" class="block text-[12px] font-semibold text-ink-700">Status</label>
            <select id="status" name="status"
                    class="mt-1.5 block h-10 border border-ink-200 bg-white px-2 text-sm text-ink-900 rounded-card focus:border-jade-500">
                <option value="">All</option>
                @foreach (var status in Enum.GetValues<QuoteStatus>())
                {
                    <option value="@status" selected="@(Model.Status == status)">@QuoteBadge.Label(status)</option>
                }
            </select>
        </div>
        <button type="submit" class="h-10 bg-ink-900 px-4 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">Apply</button>
    </form>
</div>

@if (Model.TotalCount == 0)
{
    <div class="mt-6 border border-ink-200 bg-white p-10 text-center rounded-card">
        <h2 class="text-[15px] font-semibold text-ink-900">No quotes yet</h2>
        <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-ink-500">
            When you submit a price against an assigned lead, it'll appear here.
        </p>
        <a href="/partner/leads" class="mt-6 inline-flex h-11 items-center bg-ink-900 px-5 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">
            View my leads
        </a>
    </div>
}
else
{
    <div class="mt-5 overflow-hidden border border-ink-200 bg-white rounded-card">

        <div class="hidden overflow-x-auto lg:block">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-ink-200 bg-ink-50 text-[12px] uppercase tracking-wide text-ink-500">
                    <tr>
                        <th scope="col" class="px-4 py-3 font-semibold">Quote</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Lead</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Service</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Route</th>
                        <th scope="col" class="px-4 py-3 text-right font-semibold">Total</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Status</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Created</th>
                        <th scope="col" class="px-4 py-3"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    @foreach (var row in Model.Quotes)
                    {
                        <tr class="hover:bg-ink-50">
                            <td class="whitespace-nowrap px-4 py-3 font-medium text-ink-900">@row.QuoteNumber</td>
                            <td class="whitespace-nowrap px-4 py-3 text-ink-500">@row.LeadNumber</td>
                            <td class="px-4 py-3 text-ink-700">@row.ServiceName</td>
                            <td class="px-4 py-3 text-ink-500">
                                @(row.MovingFrom is null ? row.StorageLocation ?? "-" : $"{row.MovingFrom} to {row.MovingTo}")
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-right font-semibold text-ink-900">@Money.Format(row.TotalAmount)</td>
                            <td class="px-4 py-3">
                                <span class="@QuoteBadge.Classes(row.Status) inline-flex items-center border px-2 py-0.5 text-[12px] font-medium rounded-card">
                                    @QuoteBadge.Label(row.Status)
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-ink-500">@row.CreatedAt.ToLocalTime().ToString("d MMM")</td>
                            <td class="px-4 py-3 text-right">
                                <a href="/partner/quotes/@row.QuoteId" class="font-medium text-jade-600 hover:text-jade-500">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <ul class="divide-y divide-ink-100 lg:hidden">
            @foreach (var row in Model.Quotes)
            {
                <li>
                    <a href="/partner/quotes/@row.QuoteId" class="block p-4 hover:bg-ink-50">
                        <div class="flex items-start justify-between gap-3">
                            <p class="min-w-0 truncate text-sm font-semibold text-ink-900">@row.ServiceName</p>
                            <span class="@QuoteBadge.Classes(row.Status) shrink-0 border px-2 py-0.5 text-[12px] font-medium rounded-card">
                                @QuoteBadge.Label(row.Status)
                            </span>
                        </div>
                        <p class="mt-1 text-sm text-ink-500">
                            @(row.MovingFrom is null ? row.StorageLocation ?? "-" : $"{row.MovingFrom} to {row.MovingTo}")
                        </p>
                        <p class="mt-2 text-base font-bold text-ink-900">@Money.Format(row.TotalAmount)</p>
                        <p class="mt-1 text-xs text-ink-400">@row.QuoteNumber &middot; @row.CreatedAt.ToLocalTime().ToString("d MMM")</p>
                    </a>
                </li>
            }
        </ul>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 flex flex-wrap items-center gap-1.5" aria-label="Pagination">
            @if (Model.HasPrevious)
            {
                <a href="@Link(Model.Page - 1)" class="grid h-9 min-w-9 place-items-center border border-ink-200 bg-white px-3 text-sm font-medium text-ink-700 rounded-card hover:border-ink-900">Previous</a>
            }
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                var isCurrent = p == Model.Page;
                <a href="@Link(p)" aria-current="@(isCurrent ? "page" : null)"
                   class="@(isCurrent ? "border-ink-900 bg-ink-900 text-white" : "border-ink-200 bg-white text-ink-700 hover:border-ink-900") grid h-9 min-w-9 place-items-center border px-3 text-sm font-medium rounded-card">@p</a>
            }
            @if (Model.HasNext)
            {
                <a href="@Link(Model.Page + 1)" class="grid h-9 min-w-9 place-items-center border border-ink-200 bg-white px-3 text-sm font-medium text-ink-700 rounded-card hover:border-ink-900">Next</a>
            }
        </nav>
    }
}
