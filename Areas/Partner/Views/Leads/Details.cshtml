@model PartnerLeadDetailsViewModel
@using ShiftingGuru.Areas.Admin
@{
    var lead = Model.Lead;
    var isStorage = lead.ServiceSlug == "warehouse-storage";
}

<div class="flex flex-wrap items-center justify-between gap-3">
    <a href="/partner/leads" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 hover:text-ink-900">
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M16 10H5M9 6l-4 4 4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        My leads
    </a>

    <span class="@AssignmentBadge.Classes(Model.Assignment.Status) inline-flex items-center border px-3 py-1 text-sm font-medium rounded-card">
        @Model.Assignment.Status
    </span>
</div>

<div class="mt-5 grid gap-4 lg:grid-cols-3">

    <div class="space-y-4 lg:col-span-2">

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel" aria-labelledby="lead-info">
            <h2 id="lead-info" class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Lead</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <div>
                    <dt class="text-[13px] text-ink-500">Reference</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@lead.LeadNumber</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Service</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@lead.ServiceName</dd>
                </div>
                @if (isStorage)
                {
                    <div>
                        <dt class="text-[13px] text-ink-500">Location</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.StorageLocation ?? "-")</dd>
                    </div>
                    <div>
                        <dt class="text-[13px] text-ink-500">Start date</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingDate?.ToString("d MMMM yyyy") ?? "-")</dd>
                    </div>
                }
                else
                {
                    <div>
                        <dt class="text-[13px] text-ink-500">Moving from</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingFrom ?? "-")</dd>
                    </div>
                    <div>
                        <dt class="text-[13px] text-ink-500">Moving to</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingTo ?? "-")</dd>
                    </div>
                    <div>
                        <dt class="text-[13px] text-ink-500">Moving date</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingDate?.ToString("d MMMM yyyy") ?? "-")</dd>
                    </div>
                }
            </dl>
        </section>

        @if (Model.ServiceDetails.Count > 0)
        {
            <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel" aria-labelledby="requirements">
                <h2 id="requirements" class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Requirements</h2>
                <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                    @foreach (var detail in Model.ServiceDetails)
                    {
                        <div>
                            <dt class="text-[13px] text-ink-500">@detail.Label</dt>
                            <dd class="mt-0.5 text-sm text-ink-800">@detail.Value</dd>
                        </div>
                    }
                </dl>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(lead.AdditionalRequirements))
        {
            <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel" aria-labelledby="notes">
                <h2 id="notes" class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Customer notes</h2>
                <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-ink-800">@lead.AdditionalRequirements</p>
            </section>
        }
    </div>

    <div class="lg:col-span-1">
        @* Contact details are the point of the lead, so they're prominent -
           but they only ever render for the vendor this lead is assigned to. *@
        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel lg:sticky lg:top-6" aria-labelledby="contact">
            <h2 id="contact" class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Customer contact</h2>

            <dl class="mt-4 space-y-3">
                <div>
                    <dt class="text-[13px] text-ink-500">Name</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@lead.CustomerName</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Phone</dt>
                    <dd class="mt-0.5 text-sm"><a href="tel:@lead.Phone" class="font-semibold text-jade-500 transition-colors hover:text-jade-600">@lead.Phone</a></dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(lead.Email))
                {
                    <div>
                        <dt class="text-[13px] text-ink-500">Email</dt>
                        <dd class="mt-0.5 truncate text-sm"><a href="mailto:@lead.Email" class="text-jade-500 transition-colors hover:text-jade-600">@lead.Email</a></dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(lead.PreferredContactMethod))
                {
                    <div>
                        <dt class="text-[13px] text-ink-500">Prefers</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@lead.PreferredContactMethod</dd>
                    </div>
                }
            </dl>

            <div class="mt-5 border-t border-ink-100 pt-4">
                <p class="text-[13px] text-ink-500">Assigned to you</p>
                <p class="mt-0.5 text-sm text-ink-800">@Model.Assignment.AssignedAt.ToLocalTime().ToString("d MMMM yyyy, HH:mm")</p>
            </div>

            <p class="mt-4 text-xs leading-relaxed text-ink-500">
                Contact the customer directly to discuss their requirement and what you'd charge.
            </p>

            @* Which button shows depends on whether this vendor already has a
               live quote on this lead - decided server-side. *@
            <div class="mt-5 space-y-2.5 border-t border-ink-100 pt-4">
                @if (Model.ExistingQuote is null)
                {
                    <a href="/partner/leads/@lead.Id/quote"
                       class="grid h-12 place-items-center bg-jade-500 text-sm font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                        Submit quote
                    </a>
                }
                else
                {
                    <p class="text-sm text-ink-600">
                        Your quote: <span class="font-semibold text-ink-900">@Money.Format(Model.ExistingQuote.TotalAmount)</span>
                        &middot; @ShiftingGuru.Areas.Admin.QuoteBadge.Label(Model.ExistingQuote.Status)
                    </p>

                    <a href="/partner/quotes/@Model.ExistingQuote.Id"
                       class="grid h-11 place-items-center border border-ink-200 text-sm font-medium text-ink-800 bg-white rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">
                        View quote
                    </a>

                    @if (Model.ExistingQuote.IsEditableByVendor)
                    {
                        <a href="/partner/quotes/@Model.ExistingQuote.Id/edit"
                           class="grid h-11 place-items-center bg-jade-500 text-sm font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                            Edit quote
                        </a>
                    }
                }
            </div>
        </section>
    </div>
</div>
