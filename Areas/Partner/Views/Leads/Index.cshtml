@model PartnerLeadListViewModel
@using ShiftingGuru.Areas.Admin
@{
    var firstItem = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);

    string Link(int page)
    {
        var parts = new List<string> { $"page={page}" };
        if (Model.Status.HasValue) parts.Add($"status={Model.Status}");
        return "/partner/leads?" + string.Join("&", parts);
    }
}

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-xl font-bold tracking-tight text-ink-900">My leads</h1>
        <p class="mt-1 text-sm text-ink-500">Customer requirements assigned to your business.</p>
    </div>

    <form method="get" action="/partner/leads" class="flex items-end gap-2">
        <div>
            <label for="status" class="block text-[12px] font-semibold text-ink-700">Status</label>
            <select id="status" name="status"
                    class="mt-1.5 block h-10 border border-ink-200 bg-white px-2 text-sm text-ink-900 rounded-card focus:border-jade-500">
                <option value="">All</option>
                <option value="Assigned" selected="@(Model.Status == AssignmentStatus.Assigned)">New</option>
                <option value="Viewed" selected="@(Model.Status == AssignmentStatus.Viewed)">Viewed</option>
            </select>
        </div>
        <button type="submit" class="h-10 bg-jade-500 px-4 text-sm font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">Apply</button>
    </form>
</div>

@if (Model.TotalCount == 0)
{
    <div class="mt-6 border border-ink-200 bg-white p-10 text-center shadow-card rounded-panel">
        <h2 class="text-[15px] font-semibold text-ink-900">No leads yet</h2>
        <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-ink-500">
            No leads assigned yet. When our team matches a customer enquiry to your
            services and locations, it'll appear here.
        </p>
        <a href="/partner/profile" class="mt-6 inline-flex h-11 items-center border border-ink-200 px-5 text-sm font-medium text-ink-800 bg-white rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">
            Review my profile
        </a>
    </div>
}
else
{
    <p class="mt-4 text-sm text-ink-500">Showing @firstItem&ndash;@lastItem of @Model.TotalCount</p>

    <div class="mt-3 overflow-hidden border border-ink-200 bg-white shadow-card rounded-panel">

        <div class="hidden overflow-x-auto lg:block">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-ink-200 bg-ink-50 text-[12px] uppercase tracking-wide text-ink-500">
                    <tr>
                        <th scope="col" class="px-4 py-3 font-semibold">Lead</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Service</th>
                        <th scope="col" class="px-4 py-3 font-semibold">From</th>
                        <th scope="col" class="px-4 py-3 font-semibold">To</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Moving date</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Status</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Assigned</th>
                        <th scope="col" class="px-4 py-3"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    @foreach (var row in Model.Leads)
                    {
                        <tr class="hover:bg-jade-50">
                            <td class="whitespace-nowrap px-4 py-3 font-medium text-ink-900">@row.LeadNumber</td>
                            <td class="px-4 py-3 text-ink-700">@row.ServiceName</td>
                            <td class="px-4 py-3 text-ink-500">@(row.MovingFrom ?? row.StorageLocation ?? "-")</td>
                            <td class="px-4 py-3 text-ink-500">@(row.MovingTo ?? "-")</td>
                            <td class="whitespace-nowrap px-4 py-3 text-ink-500">@(row.MovingDate?.ToString("d MMM yyyy") ?? "-")</td>
                            <td class="px-4 py-3">
                                <span class="@AssignmentBadge.Classes(row.Status) inline-flex items-center border px-2 py-0.5 text-[12px] font-medium rounded-card">
                                    @(row.Status == AssignmentStatus.Assigned ? "New" : row.Status.ToString())
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-ink-500">@row.AssignedAt.ToLocalTime().ToString("d MMM")</td>
                            <td class="px-4 py-3 text-right">
                                <a href="/partner/leads/@row.LeadId" class="font-medium text-jade-500 transition-colors hover:text-jade-600">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <ul class="divide-y divide-ink-100 lg:hidden">
            @foreach (var row in Model.Leads)
            {
                <li>
                    <a href="/partner/leads/@row.LeadId" class="block p-4 hover:bg-jade-50">
                        <div class="flex items-start justify-between gap-3">
                            <p class="min-w-0 truncate text-sm font-semibold text-ink-900">@row.ServiceName</p>
                            <span class="@AssignmentBadge.Classes(row.Status) shrink-0 border px-2 py-0.5 text-[12px] font-medium rounded-card">
                                @(row.Status == AssignmentStatus.Assigned ? "New" : row.Status.ToString())
                            </span>
                        </div>
                        <p class="mt-1 text-sm text-ink-500">
                            @(row.MovingFrom is null ? row.StorageLocation ?? "-" : $"{row.MovingFrom} to {row.MovingTo}")
                        </p>
                        @if (row.MovingDate.HasValue)
                        {
                            <p class="mt-1 text-sm text-ink-500">Moving @row.MovingDate.Value.ToString("d MMM yyyy")</p>
                        }
                        <p class="mt-2 text-xs text-ink-500">@row.LeadNumber &middot; assigned @row.AssignedAt.ToLocalTime().ToString("d MMM")</p>
                    </a>
                </li>
            }
        </ul>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 flex flex-wrap items-center gap-1.5" aria-label="Pagination">
            @if (Model.HasPrevious)
            {
                <a href="@Link(Model.Page - 1)" class="grid h-9 min-w-9 place-items-center border border-ink-200 bg-white px-3 text-sm font-medium text-ink-700 bg-white rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">Previous</a>
            }
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                var isCurrent = p == Model.Page;
                <a href="@Link(p)" aria-current="@(isCurrent ? "page" : null)"
                   class="@(isCurrent ? "border-jade-500 bg-jade-500 text-white" : "border-ink-200 bg-white text-ink-700 transition-colors hover:border-jade-500 hover:text-jade-600") grid h-9 min-w-9 place-items-center border px-3 text-sm font-medium rounded-card">@p</a>
            }
            @if (Model.HasNext)
            {
                <a href="@Link(Model.Page + 1)" class="grid h-9 min-w-9 place-items-center border border-ink-200 bg-white px-3 text-sm font-medium text-ink-700 bg-white rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">Next</a>
            }
        </nav>
    }
}
