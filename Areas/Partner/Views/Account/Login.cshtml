@model VendorLoginViewModel
@{
    Layout = "_PartnerPlainLayout";
}

<div class="w-full max-w-sm">

    <a href="/" class="flex items-center gap-2.5">
        <partial name="_Logo" model="@("h-8 w-auto")" />
        <span class="text-base font-bold tracking-tight text-ink-900">ShiftingGuru</span>
    </a>

    <div class="mt-7 border border-ink-200 bg-white p-7 shadow-float rounded-panel">

        <h1 class="text-xl font-bold tracking-tight text-ink-900">Partner Login</h1>
        <p class="mt-1.5 text-sm text-ink-500">Sign in to your partner account.</p>

        <div asp-validation-summary="ModelOnly"
             class="mt-5 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 rounded-card empty:hidden"></div>

        <form method="post" asp-action="Login" class="mt-6 space-y-4">

            <div>
                <label asp-for="Email" class="block text-[13px] font-semibold text-ink-800"></label>
                <input asp-for="Email" type="email" autocomplete="username" autofocus
                       class="mt-2 block h-11 w-full border border-ink-200 bg-white px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-[13px] font-semibold text-ink-800"></label>
                <input asp-for="Password" type="password" autocomplete="current-password"
                       class="mt-2 block h-11 w-full border border-ink-200 bg-white px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                <span asp-validation-for="Password" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <label class="flex items-center gap-2.5">
                <input asp-for="RememberMe" type="checkbox" class="h-4 w-4 accent-jade-500" />
                <span class="text-sm text-ink-700">Keep me signed in</span>
            </label>

            <button type="submit"
                    class="mt-2 h-12 w-full bg-jade-500 text-[15px] font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                Sign in
            </button>
        </form>

        <p class="mt-6 border-t border-ink-100 pt-5 text-sm text-ink-500">
            Not registered yet?
            <a href="/join-as-partner" class="font-semibold text-jade-600 hover:text-jade-500">Apply to join</a>
        </p>
    </div>
</div>
