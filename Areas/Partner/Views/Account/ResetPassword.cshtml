@model PartnerResetPasswordViewModel
@{
    Layout = "_PartnerPlainLayout";
    var codeSent = ViewData["CodeSentMessage"] as string;
}

<div class="w-full max-w-sm">

    <a href="/" class="flex items-center gap-2.5">
        <partial name="_Logo" model="@("h-8 w-auto")" />
        <span class="text-base font-bold tracking-tight text-ink-900">ShiftingGuru</span>
    </a>

    <div class="mt-7 border border-ink-200 bg-white p-7 shadow-float rounded-panel">

        <h1 class="text-xl font-bold tracking-tight text-ink-900">Set a new password</h1>
        <p class="mt-1.5 text-sm text-ink-500">Enter the code from your email and choose a new password.</p>

        @* Shown only on the first visit, straight after "Send code". *@
        @if (!string.IsNullOrEmpty(codeSent) && ViewContext.HttpContext.Request.Method == "GET")
        {
            <div class="mt-5 border border-ink-200 px-4 py-3 text-sm text-ink-700 rounded-card">
                @codeSent
            </div>
        }

        <div asp-validation-summary="ModelOnly"
             class="mt-5 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 rounded-card empty:hidden"></div>

        <form method="post" asp-action="ResetPassword" class="mt-6 space-y-4">

            <div>
                <label asp-for="Email" class="block text-[13px] font-semibold text-ink-800"></label>
                <input asp-for="Email" type="email" autocomplete="username"
                       class="mt-2 block h-11 w-full border border-ink-200 bg-white px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="Code" class="block text-[13px] font-semibold text-ink-800"></label>
                <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code"
                       maxlength="6" pattern="[0-9]{6}" autofocus
                       class="mt-2 block h-11 w-full border border-ink-200 bg-white px-3 text-[15px] tracking-[0.3em] text-ink-900 rounded-card focus:border-jade-500" />
                <span asp-validation-for="Code" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="NewPassword" class="block text-[13px] font-semibold text-ink-800"></label>
                <input asp-for="NewPassword" type="password" autocomplete="new-password"
                       class="mt-2 block h-11 w-full border border-ink-200 bg-white px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                <span class="mt-1 block text-[13px] text-ink-500">At least 8 characters, including a number.</span>
                <span asp-validation-for="NewPassword" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-[13px] font-semibold text-ink-800"></label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password"
                       class="mt-2 block h-11 w-full border border-ink-200 bg-white px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                <span asp-validation-for="ConfirmPassword" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <button type="submit"
                    class="mt-2 h-12 w-full bg-jade-500 text-[15px] font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
                Change password
            </button>
        </form>

        <div class="mt-6 space-y-2 border-t border-ink-100 pt-5 text-sm text-ink-500">
            <p>
                Didn't get a code?
                <a asp-action="ForgotPassword" class="font-semibold text-jade-600 hover:text-jade-500">Send a new one</a>
            </p>
            <p>
                <a asp-action="Login" class="font-semibold text-jade-600 hover:text-jade-500">Back to sign in</a>
            </p>
        </div>
    </div>
</div>