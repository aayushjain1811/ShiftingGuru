@model AdminAuditListViewModel
@{
    string ActionClasses(ShiftingGuru.Models.AuditAction action) => action switch
    {
        AuditAction.Created => "bg-sky-50 text-sky-700 border-sky-200",
        AuditAction.Published or AuditAction.Approved => "bg-emerald-50 text-emerald-700 border-emerald-200",
        AuditAction.Rejected or AuditAction.Deleted => "bg-red-50 text-red-700 border-red-200",
        AuditAction.Unpublished or AuditAction.Suspended => "bg-amber-50 text-amber-700 border-amber-200",
        _ => "bg-ink-100 text-ink-600 border-ink-200"
    };

    var entityTypes = new[] { "Lead", "Vendor", "Quote", "Review", "Location", "Route", "Faq" };
}

<div>
    <h1 class="text-[15px] font-semibold text-ink-900">Audit log</h1>
    @* No edit or delete actions exist for this page - a log an admin can
       change isn't a log. *@
    <p class="mt-1 text-sm text-ink-500">
        A read-only record of admin actions. Entries can't be edited or removed.
    </p>
</div>

<form method="get" action="/admin/audit" class="mt-4 border border-ink-200 bg-white p-4 rounded-card">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="lg:col-span-2">
            <label for="search" class="block text-[12px] font-semibold text-ink-700">Search</label>
            <input id="search" name="search" type="search" value="@Model.Search" placeholder="Description or admin email"
                   class="mt-1.5 block h-10 w-full border border-ink-200 px-3 text-sm text-ink-900 rounded-card focus:border-jade-500" />
        </div>
        <div>
            <label for="action" class="block text-[12px] font-semibold text-ink-700">Action</label>
            <select id="action" name="action" class="mt-1.5 block h-10 w-full border border-ink-200 bg-white px-2 text-sm text-ink-900 rounded-card focus:border-jade-500">
                <option value="">All actions</option>
                @foreach (var action in Enum.GetValues<AuditAction>())
                {
                    <option value="@action" selected="@(Model.Action == action)">@action</option>
                }
            </select>
        </div>
        <div>
            <label for="entityType" class="block text-[12px] font-semibold text-ink-700">Entity</label>
            <select id="entityType" name="entityType" class="mt-1.5 block h-10 w-full border border-ink-200 bg-white px-2 text-sm text-ink-900 rounded-card focus:border-jade-500">
                <option value="">All entities</option>
                @foreach (var type in entityTypes)
                {
                    <option value="@type" selected="@(Model.EntityType == type)">@type</option>
                }
            </select>
        </div>
    </div>

    <div class="mt-3 flex flex-wrap gap-2">
        <button type="submit" class="h-10 bg-ink-900 px-5 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">Apply</button>
        <a href="/admin/audit" class="h-10 border border-ink-200 px-5 text-sm font-medium leading-10 text-ink-700 rounded-card hover:border-ink-900">Clear</a>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <p class="mt-6 border border-ink-200 bg-white p-8 text-center text-sm text-ink-500 rounded-card">
        No audit entries match these filters.
    </p>
}
else
{
    <p class="mt-4 text-sm text-ink-500">@Model.TotalCount entries</p>

    <div class="mt-3 overflow-hidden border border-ink-200 bg-white rounded-card">
        <div class="hidden overflow-x-auto lg:block">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-ink-200 bg-ink-50 text-[12px] uppercase tracking-wide text-ink-500">
                    <tr>
                        <th scope="col" class="px-4 py-3 font-semibold">When</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Admin</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Action</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Entity</th>
                        <th scope="col" class="px-4 py-3 font-semibold">What happened</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    @foreach (var entry in Model.Entries)
                    {
                        <tr class="hover:bg-ink-50">
                            <td class="whitespace-nowrap px-4 py-3 text-ink-500">@entry.CreatedAt.ToLocalTime().ToString("d MMM, HH:mm")</td>
                            <td class="max-w-[180px] truncate px-4 py-3 text-ink-700">@entry.AdminEmail</td>
                            <td class="px-4 py-3">
                                <span class="@ActionClasses(entry.Action) inline-flex items-center border px-2 py-0.5 text-[12px] font-medium rounded-card">@entry.Action</span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-ink-500">@entry.EntityType #@entry.EntityId</td>
                            <td class="px-4 py-3 text-ink-700">@entry.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <ul class="divide-y divide-ink-100 lg:hidden">
            @foreach (var entry in Model.Entries)
            {
                <li class="p-4">
                    <div class="flex items-start justify-between gap-3">
                        <p class="min-w-0 text-sm font-semibold text-ink-900">@entry.Description</p>
                        <span class="@ActionClasses(entry.Action) shrink-0 border px-2 py-0.5 text-[12px] font-medium rounded-card">@entry.Action</span>
                    </div>
                    <p class="mt-2 truncate text-xs text-ink-400">
                        @entry.AdminEmail &middot; @entry.EntityType #@entry.EntityId &middot;
                        @entry.CreatedAt.ToLocalTime().ToString("d MMM, HH:mm")
                    </p>
                </li>
            }
        </ul>
    </div>

    <partial name="_CmsPager" model="@(("/admin/audit", (AdminCmsListViewModel)Model))" />
}
