@model AdminFaqListViewModel
@{
    string OwnerLabel(ShiftingGuru.Models.Faq faq)
    {
        if (faq.Location is not null) return $"Location: {faq.Location.Name}";
        if (faq.Route is not null) return $"Route: {faq.Route.FromLocation?.Name} to {faq.Route.ToLocation?.Name}";
        return $"Service: {faq.ServiceSlug}";
    }
}

<div class="flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="text-[15px] font-semibold text-ink-900">FAQs</h1>
        <p class="mt-1 text-sm text-ink-500">
            Published FAQs appear on the page and in its FAQ structured data. Hidden ones appear in neither.
        </p>
    </div>
    <a href="/admin/faqs/create" class="inline-flex h-10 items-center bg-ink-900 px-5 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">
        New FAQ
    </a>
</div>

<form method="get" action="/admin/faqs" class="mt-4 border border-ink-200 bg-white p-4 rounded-card">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="lg:col-span-2">
            <label for="search" class="block text-[12px] font-semibold text-ink-700">Search</label>
            <input id="search" name="search" type="search" value="@Model.Search" placeholder="Question or answer text"
                   class="mt-1.5 block h-10 w-full border border-ink-200 px-3 text-sm text-ink-900 rounded-card focus:border-jade-500" />
        </div>
        <div>
            <label for="owner" class="block text-[12px] font-semibold text-ink-700">Attached to</label>
            <select id="owner" name="owner" class="mt-1.5 block h-10 w-full border border-ink-200 bg-white px-2 text-sm text-ink-900 rounded-card focus:border-jade-500">
                <option value="">All</option>
                <option value="location" selected="@(Model.Owner == "location")">Locations</option>
                <option value="route" selected="@(Model.Owner == "route")">Routes</option>
                <option value="service" selected="@(Model.Owner == "service")">Services</option>
            </select>
        </div>
        <div>
            <label for="published" class="block text-[12px] font-semibold text-ink-700">Status</label>
            <select id="published" name="published" class="mt-1.5 block h-10 w-full border border-ink-200 bg-white px-2 text-sm text-ink-900 rounded-card focus:border-jade-500">
                <option value="">All</option>
                <option value="true" selected="@(Model.Published == true)">Published</option>
                <option value="false" selected="@(Model.Published == false)">Hidden</option>
            </select>
        </div>
    </div>

    <div class="mt-3 flex flex-wrap gap-2">
        <button type="submit" class="h-10 bg-ink-900 px-5 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">Apply</button>
        <a href="/admin/faqs" class="h-10 border border-ink-200 px-5 text-sm font-medium leading-10 text-ink-700 rounded-card hover:border-ink-900">Clear</a>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <p class="mt-6 border border-ink-200 bg-white p-8 text-center text-sm text-ink-500 rounded-card">
        No FAQs match these filters.
    </p>
}
else
{
    <ul class="mt-4 space-y-3">
        @foreach (var faq in Model.Faqs)
        {
            <li class="border border-ink-200 bg-white p-5 rounded-card">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                        <p class="text-sm font-semibold text-ink-900">@faq.Question</p>
                        <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-ink-500">@faq.Answer</p>
                    </div>

                    <span class="@(faq.IsPublished ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-ink-100 text-ink-600 border-ink-200") shrink-0 border px-2 py-0.5 text-[12px] font-medium rounded-card">
                        @(faq.IsPublished ? "Published" : "Hidden")
                    </span>
                </div>

                <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-ink-100 pt-4">
                    <p class="text-xs text-ink-400">@OwnerLabel(faq) &middot; order @faq.DisplayOrder</p>

                    <div class="flex items-center gap-3">
                        <a href="/admin/faqs/@faq.Id/edit" class="text-sm font-medium text-jade-600 hover:text-jade-500">Edit</a>
                        <form method="post" action="/admin/faqs/@faq.Id/publish">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-sm font-medium text-ink-600 hover:text-ink-900">
                                @(faq.IsPublished ? "Hide" : "Publish")
                            </button>
                        </form>
                    </div>
                </div>
            </li>
        }
    </ul>

    <partial name="_CmsPager" model="@(("/admin/faqs", (AdminCmsListViewModel)Model))" />
}
