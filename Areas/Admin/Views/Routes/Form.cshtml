@model AdminRouteFormViewModel
@{
    var action = Model.IsEdit ? $"/admin/routes/{Model.Id}/edit" : "/admin/routes/create";
}

<a href="/admin/routes" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 hover:text-ink-900">
    <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M16 10H5M9 6l-4 4 4 4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    All routes
</a>

<div asp-validation-summary="ModelOnly"
     class="mt-4 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 rounded-card empty:hidden"></div>

<form method="post" action="@action" class="mt-4 grid gap-4 lg:grid-cols-3">
    @Html.AntiForgeryToken()

    <div class="space-y-4 lg:col-span-2">

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">The corridor</h2>

            <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div>
                    <label asp-for="FromLocationId" class="block text-[13px] font-semibold text-ink-800"></label>
                    <select asp-for="FromLocationId" class="mt-2 block h-11 w-full border border-ink-200 bg-white px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500">
                        <option value="0">Choose a city</option>
                        @foreach (var location in Model.Locations)
                        {
                            <option value="@location.Id" selected="@(Model.FromLocationId == location.Id)">
                                @location.Name@(location.IsPublished ? "" : " (draft)")
                            </option>
                        }
                    </select>
                    <span asp-validation-for="FromLocationId" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="ToLocationId" class="block text-[13px] font-semibold text-ink-800"></label>
                    <select asp-for="ToLocationId" class="mt-2 block h-11 w-full border border-ink-200 bg-white px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500">
                        <option value="0">Choose a city</option>
                        @foreach (var location in Model.Locations)
                        {
                            <option value="@location.Id" selected="@(Model.ToLocationId == location.Id)">
                                @location.Name@(location.IsPublished ? "" : " (draft)")
                            </option>
                        }
                    </select>
                    <span asp-validation-for="ToLocationId" class="mt-1 block text-sm text-red-600"></span>
                </div>
            </div>

            @* The URL is derived, never typed - two routes can't disagree about
               what their own address is. *@
            <p class="mt-4 text-xs leading-relaxed text-ink-400">
                The URL is built automatically from the two city slugs.
                @if (!string.IsNullOrEmpty(Model.CurrentSlug))
                {
                    <text>Currently <span class="font-medium text-ink-600">/@Model.CurrentSlug</span>. Changing either city changes the URL and breaks the old one.</text>
                }
            </p>
        </section>

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Page content</h2>

            <div class="mt-4 space-y-4">
                <div>
                    <label asp-for="H1" class="block text-[13px] font-semibold text-ink-800"></label>
                    <input asp-for="H1" placeholder="Packers and Movers from Delhi to Bangalore"
                           class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 placeholder:text-ink-400 rounded-card focus:border-jade-500" />
                    <span asp-validation-for="H1" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="ShortDescription" class="block text-[13px] font-semibold text-ink-800"></label>
                    <textarea asp-for="ShortDescription" rows="2"
                              class="mt-2 block w-full border border-ink-200 px-3 py-2.5 text-[15px] text-ink-900 rounded-card focus:border-jade-500"></textarea>
                    <span asp-validation-for="ShortDescription" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Content" class="block text-[13px] font-semibold text-ink-800"></label>
                    <textarea asp-for="Content" rows="14"
                              class="mt-2 block w-full border border-ink-200 px-3 py-2.5 text-[15px] leading-relaxed text-ink-900 rounded-card focus:border-jade-500"></textarea>
                    <span asp-validation-for="Content" class="mt-1 block text-sm text-red-600"></span>
                    <p class="mt-1.5 text-xs text-ink-400">
                        Blank line between paragraphs. Say something specific to this corridor -
                        distance, typical transit time, what changes on a long-distance move.
                    </p>
                </div>
            </div>
        </section>

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Search and sharing</h2>

            <div class="mt-4 space-y-4">
                <div>
                    <label asp-for="MetaTitle" class="block text-[13px] font-semibold text-ink-800"></label>
                    <input asp-for="MetaTitle" class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                    <span asp-validation-for="MetaTitle" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="MetaDescription" class="block text-[13px] font-semibold text-ink-800"></label>
                    <textarea asp-for="MetaDescription" rows="3"
                              class="mt-2 block w-full border border-ink-200 px-3 py-2.5 text-[15px] text-ink-900 rounded-card focus:border-jade-500"></textarea>
                    <span asp-validation-for="MetaDescription" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label asp-for="OgTitle" class="block text-[13px] font-semibold text-ink-800"></label>
                        <input asp-for="OgTitle" class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 rounded-card focus:border-jade-500" />
                        <span asp-validation-for="OgTitle" class="mt-1 block text-sm text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="OgImage" class="block text-[13px] font-semibold text-ink-800"></label>
                        <input asp-for="OgImage" placeholder="https://..." class="mt-2 block h-11 w-full border border-ink-200 px-3 text-[15px] text-ink-900 placeholder:text-ink-400 rounded-card focus:border-jade-500" />
                        <span asp-validation-for="OgImage" class="mt-1 block text-sm text-red-600"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="OgDescription" class="block text-[13px] font-semibold text-ink-800"></label>
                    <textarea asp-for="OgDescription" rows="2"
                              class="mt-2 block w-full border border-ink-200 px-3 py-2.5 text-[15px] text-ink-900 rounded-card focus:border-jade-500"></textarea>
                    <span asp-validation-for="OgDescription" class="mt-1 block text-sm text-red-600"></span>
                    <p class="mt-1.5 text-xs text-ink-400">Leave blank to reuse the meta title and description.</p>
                </div>
            </div>
        </section>
    </div>

    <div class="lg:col-span-1">
        <section class="border border-ink-200 bg-white p-5 rounded-card lg:sticky lg:top-20">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Publishing</h2>

            <label class="mt-4 flex items-start gap-3">
                <input asp-for="IsPublished" type="checkbox" class="mt-0.5 h-4 w-4 accent-jade-500" />
                <span>
                    <span class="block text-sm font-medium text-ink-800">Published</span>
                    <span class="mt-0.5 block text-xs leading-relaxed text-ink-400">
                        Both cities must be published too, or the page would link to drafts.
                    </span>
                </span>
            </label>

            @if (Model.IsEdit && !string.IsNullOrEmpty(Model.CurrentSlug))
            {
                <a href="/@Model.CurrentSlug" target="_blank" rel="noopener"
                   class="mt-5 grid h-11 place-items-center border border-ink-200 text-sm font-medium text-ink-800 rounded-card hover:border-ink-900">
                    Preview page
                </a>
            }

            <button type="submit" class="mt-3 h-11 w-full bg-ink-900 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">
                @(Model.IsEdit ? "Save changes" : "Create route")
            </button>
        </section>
    </div>
</form>
