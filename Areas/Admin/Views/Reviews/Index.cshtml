@model AdminReviewListViewModel
@{
    var firstItem = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);

    var windowStart = Math.Max(1, Model.Page - 2);
    var windowEnd = Math.Min(Model.TotalPages, windowStart + 4);
    windowStart = Math.Max(1, windowEnd - 4);

    string Link(int page) => "/admin/reviews?" + string.Join("&",
        Model.RouteValues(page).Where(kv => !string.IsNullOrEmpty(kv.Value))
             .Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}"));
}

@if (Model.PendingCount > 0)
{
    <div class="mb-4 border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 rounded-card">
        @Model.PendingCount review@(Model.PendingCount == 1 ? "" : "s") awaiting moderation.
    </div>
}

<form method="get" action="/admin/reviews" class="border border-ink-200 bg-white p-4 rounded-card">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-6">

        <div class="lg:col-span-2">
            <label for="search" class="block text-[12px] font-semibold text-ink-700">Search</label>
            <input id="search" name="search" type="search" value="@Model.Search"
                   placeholder="Review text, vendor or lead number"
                   class="mt-1.5 block h-10 w-full border border-ink-200 px-3 text-sm text-ink-900 rounded-card focus:border-jade-500" />
        </div>

        <div>
            <label for="status" class="block text-[12px] font-semibold text-ink-700">Status</label>
            <select id="status" name="status" class="mt-1.5 block h-10 w-full border border-ink-200 bg-white px-2 text-sm text-ink-900 rounded-card focus:border-jade-500">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<ReviewStatus>())
                {
                    <option value="@status" selected="@(Model.Status == status)">@status</option>
                }
            </select>
        </div>

        <div>
            <label for="rating" class="block text-[12px] font-semibold text-ink-700">Rating</label>
            <select id="rating" name="rating" class="mt-1.5 block h-10 w-full border border-ink-200 bg-white px-2 text-sm text-ink-900 rounded-card focus:border-jade-500">
                <option value="">All ratings</option>
                @for (var stars = 5; stars >= 1; stars--)
                {
                    <option value="@stars" selected="@(Model.Rating == stars)">@stars star</option>
                }
            </select>
        </div>

        <div>
            <label for="vendorId" class="block text-[12px] font-semibold text-ink-700">Vendor</label>
            <select id="vendorId" name="vendorId" class="mt-1.5 block h-10 w-full border border-ink-200 bg-white px-2 text-sm text-ink-900 rounded-card focus:border-jade-500">
                <option value="">All vendors</option>
                @foreach (var vendor in Model.Vendors)
                {
                    <option value="@vendor.Id" selected="@(Model.VendorId == vendor.Id)">@vendor.Name</option>
                }
            </select>
        </div>

        <div class="grid grid-cols-2 gap-2">
            <div>
                <label for="from" class="block text-[12px] font-semibold text-ink-700">From</label>
                <input id="from" name="from" type="date" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                       class="mt-1.5 block h-10 w-full border border-ink-200 px-2 text-sm text-ink-900 rounded-card focus:border-jade-500" />
            </div>
            <div>
                <label for="to" class="block text-[12px] font-semibold text-ink-700">To</label>
                <input id="to" name="to" type="date" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                       class="mt-1.5 block h-10 w-full border border-ink-200 px-2 text-sm text-ink-900 rounded-card focus:border-jade-500" />
            </div>
        </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-2">
        <button type="submit" class="h-10 bg-ink-900 px-5 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">Apply</button>
        <a href="/admin/reviews" class="h-10 border border-ink-200 px-5 text-sm font-medium leading-10 text-ink-700 rounded-card hover:border-ink-900">Clear</a>
    </div>
</form>

<p class="mt-4 text-sm text-ink-500">
    @if (Model.TotalCount == 0)
    {
        <text>No reviews found.</text>
    }
    else
    {
        <text>Showing @firstItem&ndash;@lastItem of @Model.TotalCount</text>
    }
</p>

@if (Model.TotalCount > 0)
{
    <div class="mt-3 overflow-hidden border border-ink-200 bg-white rounded-card">

        <div class="hidden overflow-x-auto lg:block">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-ink-200 bg-ink-50 text-[12px] uppercase tracking-wide text-ink-500">
                    <tr>
                        <th scope="col" class="px-4 py-3 font-semibold">Rating</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Review</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Vendor</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Lead</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Status</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Created</th>
                        <th scope="col" class="px-4 py-3"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    @foreach (var review in Model.Reviews)
                    {
                        <tr class="hover:bg-ink-50">
                            <td class="whitespace-nowrap px-4 py-3 text-amber-400">@ReviewBadge.Stars(review.Rating)</td>
                            <td class="max-w-[260px] px-4 py-3">
                                @if (!string.IsNullOrWhiteSpace(review.Title))
                                {
                                    <p class="truncate font-medium text-ink-900">@review.Title</p>
                                }
                                <p class="truncate text-ink-500">@review.Comment</p>
                            </td>
                            <td class="px-4 py-3 text-ink-700">@review.Vendor?.BusinessName</td>
                            <td class="whitespace-nowrap px-4 py-3 text-ink-500">@review.Lead?.LeadNumber</td>
                            <td class="px-4 py-3">
                                <span class="@ReviewBadge.Classes(review.Status) inline-flex items-center border px-2 py-0.5 text-[12px] font-medium rounded-card">
                                    @review.Status
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-ink-500">@review.CreatedAt.ToLocalTime().ToString("d MMM")</td>
                            <td class="px-4 py-3 text-right">
                                <a href="/admin/reviews/@review.Id" class="font-medium text-jade-600 hover:text-jade-500">Review</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <ul class="divide-y divide-ink-100 lg:hidden">
            @foreach (var review in Model.Reviews)
            {
                <li>
                    <a href="/admin/reviews/@review.Id" class="block p-4 hover:bg-ink-50">
                        <div class="flex items-start justify-between gap-3">
                            <p class="text-amber-400">@ReviewBadge.Stars(review.Rating)</p>
                            <span class="@ReviewBadge.Classes(review.Status) shrink-0 border px-2 py-0.5 text-[12px] font-medium rounded-card">@review.Status</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(review.Title))
                        {
                            <p class="mt-2 truncate text-sm font-semibold text-ink-900">@review.Title</p>
                        }
                        <p class="mt-1 line-clamp-2 text-sm text-ink-500">@review.Comment</p>
                        <p class="mt-2 text-xs text-ink-400">
                            @review.Vendor?.BusinessName &middot; @review.Lead?.LeadNumber &middot;
                            @review.CreatedAt.ToLocalTime().ToString("d MMM")
                        </p>
                    </a>
                </li>
            }
        </ul>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 flex flex-wrap items-center gap-1.5" aria-label="Pagination">
            @if (Model.HasPrevious)
            {
                <a href="@Link(Model.Page - 1)" class="grid h-9 min-w-9 place-items-center border border-ink-200 bg-white px-3 text-sm font-medium text-ink-700 rounded-card hover:border-ink-900">Previous</a>
            }
            @for (var p = windowStart; p <= windowEnd; p++)
            {
                var isCurrent = p == Model.Page;
                <a href="@Link(p)" aria-current="@(isCurrent ? "page" : null)"
                   class="@(isCurrent ? "border-ink-900 bg-ink-900 text-white" : "border-ink-200 bg-white text-ink-700 hover:border-ink-900") grid h-9 min-w-9 place-items-center border px-3 text-sm font-medium rounded-card">@p</a>
            }
            @if (Model.HasNext)
            {
                <a href="@Link(Model.Page + 1)" class="grid h-9 min-w-9 place-items-center border border-ink-200 bg-white px-3 text-sm font-medium text-ink-700 rounded-card hover:border-ink-900">Next</a>
            }
        </nav>
    }
}
