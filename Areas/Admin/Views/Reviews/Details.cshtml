@model AdminReviewDetailsViewModel
@{
    var review = Model.Review;
    var lead = Model.Lead;
    var vendor = Model.Vendor;

    string Describe(ReviewStatus status) => status switch
    {
        ReviewStatus.Approved => "Publish this review? It'll appear on the vendor's profile.",
        ReviewStatus.Rejected => "Reject this review? It won't be published.",
        ReviewStatus.Hidden => "Hide this review? It'll be removed from public view and the rating.",
        _ => "Change this review's status?"
    };

    string ButtonClasses(ReviewStatus status) => status switch
    {
        ReviewStatus.Approved => "bg-jade-500 text-ink-950 hover:bg-jade-400",
        ReviewStatus.Rejected => "bg-red-600 text-white hover:bg-red-700",
        _ => "bg-ink-900 text-white hover:bg-ink-800"
    };
}

<div class="flex flex-wrap items-center justify-between gap-3">
    <a href="/admin/reviews" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 hover:text-ink-900">
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M16 10H5M9 6l-4 4 4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        All reviews
    </a>

    <span class="@ReviewBadge.Classes(review.Status) inline-flex items-center border px-3 py-1 text-sm font-medium rounded-card">
        @review.Status
    </span>
</div>

@if (!Model.MatchesSelectedVendor)
{
    @* Should be impossible - the vendor is taken from the lead, never a form.
       If it ever shows, something is badly wrong and worth seeing. *@
    <div class="mt-4 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 rounded-card">
        This review's vendor doesn't match the lead's selected vendor. Investigate before moderating.
    </div>
}

<div class="mt-5 grid gap-4 lg:grid-cols-3">

    <div class="space-y-4 lg:col-span-2">

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Review</h2>

            <p class="mt-4 text-2xl text-amber-400" role="img" aria-label="@review.Rating out of 5 stars">
                @ReviewBadge.Stars(review.Rating)
            </p>
            <p class="mt-1 text-sm text-ink-500">@review.Rating out of 5</p>

            @if (!string.IsNullOrWhiteSpace(review.Title))
            {
                <h3 class="mt-5 font-display text-lg font-bold tracking-[-0.02em] text-ink-900">@review.Title</h3>
            }

            <p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-ink-800">@review.Comment</p>

            <dl class="mt-6 grid gap-4 border-t border-ink-100 pt-5 sm:grid-cols-3">
                <div>
                    <dt class="text-[13px] text-ink-500">Submitted</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@review.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Updated</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(review.UpdatedAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "Not updated")</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Published</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(review.PublishedAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "Not published")</dd>
                </div>
            </dl>
        </section>

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Lead</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <div>
                    <dt class="text-[13px] text-ink-500">Lead number</dt>
                    <dd class="mt-0.5 text-sm">
                        <a href="/admin/leads/@lead.Id" class="font-semibold text-jade-600 hover:text-jade-500">@lead.LeadNumber</a>
                    </dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Customer</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@lead.CustomerName</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Service</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@lead.ServiceName</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Route</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">
                        @(lead.MovingFrom is null ? lead.StorageLocation ?? "-" : $"{lead.MovingFrom} to {lead.MovingTo}")
                    </dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Moving date</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingDate?.ToString("d MMM yyyy") ?? "Not given")</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Lead status</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@lead.Status</dd>
                </div>
            </dl>
        </section>
    </div>

    <div class="space-y-4 lg:col-span-1">

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Vendor</h2>
            <dl class="mt-4 space-y-3">
                <div>
                    <dt class="text-[13px] text-ink-500">Business</dt>
                    <dd class="mt-0.5 text-sm">
                        <a href="/admin/vendors/@vendor.Id" class="font-semibold text-jade-600 hover:text-jade-500">@vendor.BusinessName</a>
                    </dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Vendor number</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.VendorNumber</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Contact</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.ContactPerson</dd>
                </div>
            </dl>
        </section>

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Moderation</h2>

            @if (Model.AllowedTransitions.Count == 0)
            {
                <p class="mt-3 text-sm text-ink-500">No moderation actions available.</p>
            }
            else
            {
                @* Internal only. Never rendered to the customer or the vendor. *@
                @foreach (var status in Model.AllowedTransitions)
                {
                    <form method="post" action="/admin/reviews/@review.Id/moderate" class="mt-4"
                          onsubmit="return confirm('@Describe(status)');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="status" value="@status" />

                        <label for="note-@status" class="block text-[12px] font-semibold text-ink-700">
                            Internal note (optional)
                        </label>
                        <input id="note-@status" name="note" type="text" maxlength="500"
                               placeholder="Why, for the record"
                               class="mt-1.5 block h-10 w-full border border-ink-200 px-3 text-sm text-ink-900 placeholder:text-ink-400 rounded-card focus:border-jade-500" />

                        <button type="submit" class="@ButtonClasses(status) mt-2 h-11 w-full text-sm font-semibold rounded-card transition-colors">
                            @status
                        </button>
                    </form>
                }
            }

            @if (!string.IsNullOrWhiteSpace(review.ModerationNote))
            {
                <div class="mt-5 border-t border-ink-100 pt-4">
                    <p class="text-[12px] font-semibold uppercase tracking-wide text-ink-500">Last note</p>
                    <p class="mt-1.5 text-sm leading-relaxed text-ink-700">@review.ModerationNote</p>
                    <p class="mt-2 text-xs text-ink-400">Visible to admins only.</p>
                </div>
            }
        </section>
    </div>
</div>
