@{
    ViewData["Title"] = "Access denied";
    Layout = "_LoginLayout";
}

<div class="w-full max-w-sm py-12 text-center">
    <h1 class="text-xl font-bold tracking-tight text-ink-900">Access denied</h1>
    <p class="mt-3 text-sm leading-relaxed text-ink-500">
        Your account doesn't have permission to view the admin area.
    </p>

    <div class="mt-7 flex flex-col gap-3">
        <a href="/admin/login" class="grid h-11 place-items-center bg-jade-500 text-[15px] font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
            Sign in with another account
        </a>
        <a href="/" class="grid h-11 place-items-center border border-ink-200 bg-white text-[15px] font-medium text-ink-800 rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">
            Back to site
        </a>
    </div>
</div>
