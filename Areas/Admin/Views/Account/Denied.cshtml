@{
    ViewData["Title"] = "Access denied";
    Layout = "_LoginLayout";
}

<div class="w-full max-w-sm py-12 text-center">
    <h1 class="text-xl font-bold tracking-tight text-white">Access denied</h1>
    <p class="mt-3 text-sm leading-relaxed text-ink-400">
        Your account doesn't have permission to view the admin area.
    </p>

    <div class="mt-7 flex flex-col gap-3">
        <a href="/admin/login" class="grid h-11 place-items-center bg-jade-500 text-[15px] font-semibold text-ink-950 rounded-card">
            Sign in with another account
        </a>
        <a href="/" class="grid h-11 place-items-center border border-white/20 text-[15px] font-medium text-white rounded-card">
            Back to site
        </a>
    </div>
</div>
