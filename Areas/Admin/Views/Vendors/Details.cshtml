@model AdminVendorDetailsViewModel
@{
    var vendor = Model.Vendor;

    string Describe(VendorStatus status) => status switch
    {
        VendorStatus.Approved => "Approve this partner? They'll be able to sign in and receive leads.",
        VendorStatus.Rejected => "Reject this application? They won't be able to access the partner area.",
        VendorStatus.Suspended => "Suspend this partner? They'll lose access until reinstated.",
        _ => "Change this partner's status?"
    };

    string ButtonClasses(VendorStatus status) => status switch
    {
        VendorStatus.Approved => "bg-jade-500 text-ink-950 hover:bg-jade-400",
        VendorStatus.Rejected => "bg-red-600 text-white hover:bg-red-700",
        VendorStatus.Suspended => "bg-ink-900 text-white hover:bg-ink-800",
        _ => "bg-ink-900 text-white hover:bg-ink-800"
    };
}

<div class="flex flex-wrap items-center justify-between gap-3">
    <a href="/admin/vendors" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 hover:text-ink-900">
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M16 10H5M9 6l-4 4 4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        All partners
    </a>

    <span class="@VendorBadge.Classes(vendor.Status) inline-flex items-center border px-3 py-1 text-sm font-medium rounded-card">@vendor.Status</span>
</div>

<div class="mt-5 grid gap-4 lg:grid-cols-3">

    <div class="space-y-4 lg:col-span-2">

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Business information</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <div>
                    <dt class="text-[13px] text-ink-500">Vendor number</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@vendor.VendorNumber</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Business name</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@vendor.BusinessName</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Contact person</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.ContactPerson</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Phone</dt>
                    <dd class="mt-0.5 text-sm"><a href="tel:@vendor.Phone" class="text-jade-600 hover:text-jade-500">@vendor.Phone</a></dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Email</dt>
                    <dd class="mt-0.5 truncate text-sm"><a href="mailto:@vendor.Email" class="text-jade-600 hover:text-jade-500">@vendor.Email</a></dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">City</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.City</dd>
                </div>
                <div class="sm:col-span-2">
                    <dt class="text-[13px] text-ink-500">Address</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.Address</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">GST number</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(string.IsNullOrWhiteSpace(vendor.GstNumber) ? "Not provided" : vendor.GstNumber)</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Years of experience</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.YearsOfExperience</dd>
                </div>
            </dl>
        </section>

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Services</h2>
            @if (vendor.Services.Count == 0)
            {
                <p class="mt-3 text-sm text-ink-500">No services listed.</p>
            }
            else
            {
                <ul class="mt-3 flex flex-wrap gap-2">
                    @foreach (var service in vendor.Services)
                    {
                        <li class="border border-ink-200 px-3 py-1 text-sm text-ink-700 rounded-card">@service.ServiceName</li>
                    }
                </ul>
            }
        </section>

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Operating information</h2>
            <dl class="mt-4 space-y-4">
                <div>
                    <dt class="text-[13px] text-ink-500">Operating locations</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(string.IsNullOrWhiteSpace(vendor.OperatingLocations) ? "Not provided" : vendor.OperatingLocations)</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Additional information</dt>
                    <dd class="mt-0.5 whitespace-pre-line text-sm leading-relaxed text-ink-800">@(string.IsNullOrWhiteSpace(vendor.AdditionalInformation) ? "Not provided" : vendor.AdditionalInformation)</dd>
                </div>
            </dl>
        </section>

        <section class="border border-ink-200 bg-white p-5 rounded-card">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Application</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-3">
                <div>
                    <dt class="text-[13px] text-ink-500">Status</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@vendor.Status</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Applied</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.CreatedAt.ToLocalTime().ToString("d MMMM yyyy, HH:mm")</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Last updated</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(vendor.UpdatedAt?.ToLocalTime().ToString("d MMMM yyyy, HH:mm") ?? "Not updated yet")</dd>
                </div>
            </dl>
        </section>
    </div>

    <div class="lg:col-span-1">
        <section class="border border-ink-200 bg-white p-5 rounded-card lg:sticky lg:top-20">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Actions</h2>

            @if (Model.AllowedTransitions.Count == 0)
            {
                <p class="mt-3 text-sm text-ink-500">No status changes available.</p>
            }
            else
            {
                <p class="mt-2 text-sm leading-relaxed text-ink-500">
                    Only moves that are valid from <strong class="text-ink-800">@vendor.Status</strong> are shown.
                </p>

                @* Each action is its own POST with its own token. The native
                   confirm dialog is a deliberate pause before a state change. *@
                <div class="mt-4 space-y-2.5">
                    @foreach (var status in Model.AllowedTransitions)
                    {
                        <form method="post" action="/admin/vendors/@vendor.Id/status"
                              onsubmit="return confirm('@Describe(status)');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="status" value="@status" />
                            <button type="submit"
                                    class="@ButtonClasses(status) h-11 w-full text-sm font-semibold rounded-card transition-colors">
                                @status
                            </button>
                        </form>
                    }
                </div>
            }

            <p class="mt-5 border-t border-ink-100 pt-4 text-xs leading-relaxed text-ink-400">
                Partner records are kept for business purposes and can't be deleted from here.
            </p>
        </section>
    </div>
</div>
