@model AdminVendorDetailsViewModel
@{
    var vendor = Model.Vendor;
    var feePayment = ViewData["RegistrationPayment"] as ShiftingGuru.Models.RegistrationPayment;
    var feePaid = vendor.RegistrationFeePaidAt is not null;

    string Describe(VendorStatus status) => status switch
    {
        VendorStatus.Approved when !feePaid =>
            "This partner has NOT paid the registration fee. Approve anyway? (No free trial will start.)",
        VendorStatus.Approved => $"Approve this partner? They'll be able to sign in and receive leads, and their {Vendor.FreeTrialDays}-day free trial starts now.",
        VendorStatus.Rejected => "Reject this application? They won't be able to access the partner area.",
        VendorStatus.Suspended => "Suspend this partner? They'll lose access until reinstated.",
        _ => "Change this partner's status?"
    };

    string ButtonClasses(VendorStatus status) => status switch
    {
        VendorStatus.Approved => "bg-success-600 text-white hover:bg-success-700",
        VendorStatus.Rejected => "bg-red-600 text-white hover:bg-red-700",
        VendorStatus.Suspended => "bg-ink-950 text-white hover:bg-ink-800",
        _ => "bg-jade-500 text-white hover:bg-jade-600"
    };

    var documentSlots = new (VendorDocumentType Type, string Label)[]
    {
        (VendorDocumentType.GstCertificate, "GST certificate"),
        (VendorDocumentType.PanCard, "PAN card"),
        (VendorDocumentType.AadhaarFront, "Aadhaar (front)"),
        (VendorDocumentType.AadhaarBack, "Aadhaar (back)"),
        (VendorDocumentType.OfficePhoto, "Office photo")
    };

    string Size(long bytes) => bytes >= 1024 * 1024
        ? $"{bytes / (1024d * 1024d):0.0} MB"
        : $"{Math.Max(1, bytes / 1024)} KB";

    string When(DateTime? value) =>
        value?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "Not verified";

    string Trial()
    {
        if (vendor.TrialEndsAt is { } ends)
        {
            var date = ends.ToLocalTime().ToString("d MMM yyyy");
            return ends > DateTime.UtcNow ? $"Active, ends {date}" : $"Ended {date}";
        }
        return feePaid ? "Starts when approved" : "Not available (fee not paid)";
    }
}

<div class="flex flex-wrap items-center justify-between gap-3">
    <a href="/admin/vendors" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 hover:text-ink-900">
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M16 10H5M9 6l-4 4 4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        All partners
    </a>

    <span class="@VendorBadge.Classes(vendor.Status) inline-flex items-center border px-3 py-1 text-sm font-medium rounded-card">@vendor.Status</span>
</div>

@if (!feePaid)
{
    <div class="mt-4 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 rounded-card">
        <strong>Registration fee not paid.</strong>
        The partner was emailed a link to pay. Partners who joined before the fee was introduced also show this.
    </div>
}

<div class="mt-5 grid gap-4 lg:grid-cols-3">

    <div class="space-y-4 lg:col-span-2">

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Business information</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <div>
                    <dt class="text-[13px] text-ink-500">Vendor number</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@vendor.VendorNumber</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Business name</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@vendor.BusinessName</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Full name</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.ContactPerson</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Phone</dt>
                    <dd class="mt-0.5 text-sm"><a href="tel:@vendor.Phone" class="text-jade-500 transition-colors hover:text-jade-600">@vendor.Phone</a></dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Email</dt>
                    <dd class="mt-0.5 truncate text-sm"><a href="mailto:@vendor.Email" class="text-jade-500 transition-colors hover:text-jade-600">@vendor.Email</a></dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">City</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.City</dd>
                </div>
                <div class="sm:col-span-2">
                    <dt class="text-[13px] text-ink-500">Address</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.Address</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">GST number</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(string.IsNullOrWhiteSpace(vendor.GstNumber) ? "Not provided" : vendor.GstNumber)</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Years of experience</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.YearsOfExperience</dd>
                </div>
            </dl>
        </section>

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Documents</h2>
                <p class="text-xs text-ink-500">Opens in a new tab. Check names match the business and person above.</p>
            </div>

            @if (vendor.Documents.Count == 0)
            {
                               <p class="mt-3 text-sm text-ink-500">No documents uploaded. Ask the partner for them before approving.</p>
            }
            else
            {
                <ul class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                    @foreach (var slot in documentSlots)
                    {
                        var doc = vendor.Documents.FirstOrDefault(d => d.Type == slot.Type);

                        <li class="overflow-hidden border border-ink-200 rounded-card">
                            @if (doc is null)
                            {
                                <div class="grid aspect-[4/3] place-items-center bg-ink-50 text-sm text-ink-500">Not uploaded</div>
                                <p class="border-t border-ink-100 px-3 py-2 text-sm font-semibold text-ink-900">@slot.Label</p>
                            }
                            else
                            {
                                var url = $"/admin/vendors/{vendor.Id}/documents/{doc.Id}";
                                var isImage = doc.ContentType.StartsWith("image/");

                                <a href="@url" target="_blank" rel="noopener" class="group block">
                                    @if (isImage)
                                    {
                                        <img src="@url" alt="@slot.Label" loading="lazy"
                                             class="aspect-[4/3] w-full bg-ink-50 object-cover transition-opacity group-hover:opacity-90" />
                                    }
                                    else
                                    {
                                        <span class="grid aspect-[4/3] place-items-center bg-ink-50 text-ink-500 transition-colors group-hover:text-jade-500">
                                            <span class="flex flex-col items-center gap-2">
                                                <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                                    <path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8l-5-5Z" stroke-linejoin="round" />
                                                    <path d="M14 3v5h5" stroke-linejoin="round" />
                                                </svg>
                                                <span class="text-xs font-semibold">PDF</span>
                                            </span>
                                        </span>
                                    }
                                    <span class="block border-t border-ink-100 px-3 py-2">
                                        <span class="block text-sm font-semibold text-ink-900 group-hover:text-jade-600">@slot.Label</span>
                                        <span class="block truncate text-xs text-ink-500">@doc.OriginalFileName, @Size(doc.SizeBytes)</span>
                                    </span>
                                </a>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Registration fee and trial</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <div>
                    <dt class="text-[13px] text-ink-500">Fee</dt>
                    <dd class="mt-0.5 text-sm font-semibold @(feePaid ? "text-success-600" : "text-red-600")">
                        @(feePayment is not null ? $"₹{feePayment.Amount:0.##} paid" : feePaid ? "Paid" : "Not paid")
                    </dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Paid on</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(vendor.RegistrationFeePaidAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "-")</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Razorpay payment ID</dt>
                    <dd class="mt-0.5 font-mono text-xs text-ink-800">@(feePayment?.RazorpayPaymentId ?? "-")</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Free trial (@Vendor.FreeTrialDays days)</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@Trial()</dd>
                </div>
            </dl>
        </section>

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Services</h2>
            @if (vendor.Services.Count == 0)
            {
                <p class="mt-3 text-sm text-ink-500">No services listed.</p>
            }
            else
            {
                <ul class="mt-3 flex flex-wrap gap-2">
                    @foreach (var service in vendor.Services)
                    {
                        <li class="border border-jade-100 bg-jade-50 px-3 py-1 text-sm text-jade-600 rounded-card">@service.ServiceName</li>
                    }
                </ul>
            }
        </section>

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Operating information</h2>
            <dl class="mt-4 space-y-4">
                <div>
                    <dt class="text-[13px] text-ink-500">Operating locations</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(string.IsNullOrWhiteSpace(vendor.OperatingLocations) ? "Not provided" : vendor.OperatingLocations)</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Additional information</dt>
                    <dd class="mt-0.5 whitespace-pre-line text-sm leading-relaxed text-ink-800">@(string.IsNullOrWhiteSpace(vendor.AdditionalInformation) ? "Not provided" : vendor.AdditionalInformation)</dd>
                </div>
            </dl>
        </section>

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Application</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-3">
                <div>
                    <dt class="text-[13px] text-ink-500">Status</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@vendor.Status</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Applied</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.CreatedAt.ToLocalTime().ToString("d MMMM yyyy, HH:mm")</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Last updated</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(vendor.UpdatedAt?.ToLocalTime().ToString("d MMMM yyyy, HH:mm") ?? "Not updated yet")</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Email verified</dt>
                    <dd class="mt-0.5 text-sm @(vendor.EmailVerifiedAt is null ? "text-ink-500" : "font-semibold text-success-600")">@When(vendor.EmailVerifiedAt)</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Mobile verified</dt>
                    <dd class="mt-0.5 text-sm @(vendor.PhoneVerifiedAt is null ? "text-ink-500" : "font-semibold text-success-600")">@When(vendor.PhoneVerifiedAt)</dd>
                </div>
            </dl>
        </section>
    </div>

    <div class="lg:col-span-1">
        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel lg:sticky lg:top-20">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Actions</h2>

            @if (Model.AllowedTransitions.Count == 0)
            {
                <p class="mt-3 text-sm text-ink-500">No status changes available.</p>
            }
            else
            {
                <p class="mt-2 text-sm leading-relaxed text-ink-500">
                    Only moves that are valid from <strong class="text-ink-800">@vendor.Status</strong> are shown.
                </p>

                <div class="mt-4 space-y-2.5">
                    @foreach (var status in Model.AllowedTransitions)
                    {
                        <form method="post" action="/admin/vendors/@vendor.Id/status"
                              onsubmit="return confirm('@Describe(status)');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="status" value="@status" />
                            <button type="submit"
                                    class="@ButtonClasses(status) h-11 w-full text-sm font-semibold rounded-card transition-colors">
                                @status
                            </button>
                        </form>
                    }
                </div>
            }

            <p class="mt-5 border-t border-ink-100 pt-4 text-xs leading-relaxed text-ink-500">
                Partner records are kept for business purposes and can't be deleted from here.
            </p>
        </section>
    </div>
</div>