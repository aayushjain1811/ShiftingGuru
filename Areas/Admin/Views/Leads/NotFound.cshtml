@{
    ViewData["Title"] = "Lead not found";
}

<div class="border border-ink-200 bg-white p-10 text-center rounded-panel">
    <h2 class="text-lg font-bold text-ink-900">Lead not found</h2>
    <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-ink-500">
        That lead doesn't exist. It may have been removed, or the link may be wrong.
    </p>
    <a href="/admin/leads"
       class="mt-6 inline-flex h-11 items-center bg-ink-900 px-5 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">
        Back to all leads
    </a>
</div>
