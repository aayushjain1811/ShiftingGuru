@model AdminLeadDetailsViewModel
@{
    var lead = Model.Lead;
    ViewData["Title"] = lead.LeadNumber;

    var isStorage = lead.ServiceSlug == "warehouse-storage";
}

<div class="flex flex-wrap items-center justify-between gap-3">
    <a href="/admin/leads" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 hover:text-ink-900">
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M16 10H5M9 6l-4 4 4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        All leads
    </a>

    <span class="@StatusBadge.Classes(lead.Status) inline-flex items-center border px-3 py-1 text-sm font-medium rounded-card">
        @StatusBadge.Label(lead.Status)
    </span>
</div>

<div class="mt-5 grid gap-4 lg:grid-cols-3">

    <!-- Left: the lead itself -->
    <div class="space-y-4 lg:col-span-2">

        <section class="border border-ink-200 bg-white p-5 rounded-card" aria-labelledby="lead-info">
            <h2 id="lead-info" class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Lead</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <div>
                    <dt class="text-[13px] text-ink-500">Reference</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@lead.LeadNumber</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Service</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@lead.ServiceName</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Created</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@lead.CreatedAt.ToLocalTime().ToString("d MMMM yyyy, HH:mm")</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Last updated</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">
                        @(lead.UpdatedAt?.ToLocalTime().ToString("d MMMM yyyy, HH:mm") ?? "Not updated yet")
                    </dd>
                </div>
            </dl>
        </section>

        <section class="border border-ink-200 bg-white p-5 rounded-card" aria-labelledby="customer-info">
            <h2 id="customer-info" class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Customer</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <div>
                    <dt class="text-[13px] text-ink-500">Name</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@lead.CustomerName</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Phone</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">
                        <a href="tel:@lead.Phone" class="text-jade-600 hover:text-jade-500">@lead.Phone</a>
                    </dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(lead.Email))
                {
                    <div>
                        <dt class="text-[13px] text-ink-500">Email</dt>
                        <dd class="mt-0.5 truncate text-sm text-ink-800">
                            <a href="mailto:@lead.Email" class="text-jade-600 hover:text-jade-500">@lead.Email</a>
                        </dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(lead.PreferredContactMethod))
                {
                    <div>
                        <dt class="text-[13px] text-ink-500">Prefers</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@lead.PreferredContactMethod</dd>
                    </div>
                }
            </dl>
        </section>

        <section class="border border-ink-200 bg-white p-5 rounded-card" aria-labelledby="move-info">
            <h2 id="move-info" class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">
                @(isStorage ? "Storage" : "Move")
            </h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                @if (isStorage)
                {
                    <div>
                        <dt class="text-[13px] text-ink-500">Location</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.StorageLocation ?? "-")</dd>
                    </div>
                    <div>
                        <dt class="text-[13px] text-ink-500">Start date</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingDate?.ToString("d MMMM yyyy") ?? "-")</dd>
                    </div>
                }
                else
                {
                    <div>
                        <dt class="text-[13px] text-ink-500">From</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingFrom ?? "-")</dd>
                    </div>
                    <div>
                        <dt class="text-[13px] text-ink-500">To</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingTo ?? "-")</dd>
                    </div>
                    <div>
                        <dt class="text-[13px] text-ink-500">Moving date</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingDate?.ToString("d MMMM yyyy") ?? "-")</dd>
                    </div>
                }
            </dl>
        </section>

        @* Only fields with a value reach the view - filtered in the controller. *@
        @if (Model.ServiceDetails.Count > 0)
        {
            <section class="border border-ink-200 bg-white p-5 rounded-card" aria-labelledby="requirements">
                <h2 id="requirements" class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Requirements</h2>
                <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                    @foreach (var detail in Model.ServiceDetails)
                    {
                        <div>
                            <dt class="text-[13px] text-ink-500">@detail.Label</dt>
                            <dd class="mt-0.5 text-sm text-ink-800">@detail.Value</dd>
                        </div>
                    }
                </dl>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(lead.AdditionalRequirements))
        {
            <section class="border border-ink-200 bg-white p-5 rounded-card" aria-labelledby="notes">
                <h2 id="notes" class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Customer notes</h2>
                <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-ink-800">@lead.AdditionalRequirements</p>
            </section>
        }
    </div>

    <!-- Right: status control -->
    <div class="lg:col-span-1">
        <section class="border border-ink-200 bg-white p-5 rounded-card lg:sticky lg:top-20" aria-labelledby="status-heading">
            <h2 id="status-heading" class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Update status</h2>

            @* POST only. A GET must never change state, and the anti-forgery
               token stops another site submitting this on your behalf. *@
            <form method="post" action="/admin/leads/@lead.Id/status" class="mt-4">
                @Html.AntiForgeryToken()

                <label for="status-select" class="sr-only">Status</label>
                <select id="status-select" name="status"
                        class="block h-11 w-full border border-ink-200 bg-white px-3 text-sm text-ink-900 rounded-card focus:border-jade-500">
                    @foreach (var status in Model.AvailableStatuses)
                    {
                        <option value="@status" selected="@(status == lead.Status)">@StatusBadge.Label(status)</option>
                    }
                </select>

                <button type="submit"
                        class="mt-3 h-11 w-full bg-ink-900 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">
                    Save status
                </button>
            </form>

            @* Only a converted lead can be completed, and completion is what
               unlocks the customer's review. *@
            @if (lead.Status == LeadStatus.Converted)
            {
                <form method="post" action="/admin/leads/@lead.Id/complete" class="mt-4 border-t border-ink-100 pt-4"
                      onsubmit="return confirm('Mark this move as complete? The customer will be invited to review the vendor.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="h-11 w-full bg-jade-500 text-sm font-semibold text-ink-950 rounded-card transition-colors hover:bg-jade-400">
                        Mark as completed
                    </button>
                </form>
            }

            <p class="mt-4 border-t border-ink-100 pt-4 text-xs leading-relaxed text-ink-400">
                Leads are kept for business records and can't be deleted from here.
            </p>
        </section>
    </div>
</div>

<!-- ============ Vendor assignment ============ -->
<section class="mt-4 border border-ink-200 bg-white rounded-card" aria-labelledby="assign-heading">

    <div class="border-b border-ink-200 p-5">
        <h2 id="assign-heading" class="text-[15px] font-semibold text-ink-900">Assign vendors</h2>
        <p class="mt-1 text-sm text-ink-500">
            @lead.LeadNumber &middot; @lead.ServiceName &middot;
            @(lead.MovingFrom is null ? lead.StorageLocation ?? "-" : $"{lead.MovingFrom} to {lead.MovingTo}")
            @if (lead.MovingDate.HasValue)
            {
                <text> &middot; @lead.MovingDate.Value.ToString("d MMM yyyy")</text>
            }
            &middot; @lead.CustomerName
        </p>
    </div>

    @* ---- vendors already on this lead ---- *@
    @{
        var active = Model.Assignment.Existing.Where(a => a.Status != AssignmentStatus.Cancelled).ToList();
        var withdrawn = Model.Assignment.Existing.Where(a => a.Status == AssignmentStatus.Cancelled).ToList();
    }

    <div class="border-b border-ink-200 p-5">
        <h3 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Assigned vendors</h3>

        @if (active.Count == 0)
        {
            <p class="mt-3 text-sm text-ink-500">Not assigned to any vendor yet.</p>
        }
        else
        {
            <ul class="mt-3 divide-y divide-ink-100 border-y border-ink-100">
                @foreach (var assignment in active)
                {
                    <li class="flex flex-wrap items-center justify-between gap-3 py-3">
                        <div class="min-w-0">
                            <a href="/admin/vendors/@assignment.VendorId" class="text-sm font-semibold text-ink-900 hover:text-jade-600">
                                @assignment.Vendor?.BusinessName
                            </a>
                            <p class="mt-0.5 text-sm text-ink-500">
                                Assigned @assignment.AssignedAt.ToLocalTime().ToString("d MMM yyyy")
                                @if (assignment.ViewedAt.HasValue)
                                {
                                    <text> &middot; viewed @assignment.ViewedAt.Value.ToLocalTime().ToString("d MMM")</text>
                                }
                            </p>
                        </div>

                        <div class="flex shrink-0 items-center gap-3">
                            <span class="@AssignmentBadge.Classes(assignment.Status) inline-flex items-center border px-2 py-0.5 text-[12px] font-medium rounded-card">
                                @assignment.Status
                            </span>

                            <form method="post" action="/admin/leads/@lead.Id/assignments/@assignment.Id/cancel"
                                  onsubmit="return confirm('Withdraw this lead from @assignment.Vendor?.BusinessName?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-sm font-medium text-red-600 hover:text-red-700">Remove</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        }

        @if (withdrawn.Count > 0)
        {
            <p class="mt-3 text-xs text-ink-400">
                @withdrawn.Count withdrawn assignment@(withdrawn.Count == 1 ? "" : "s") kept in history.
            </p>
        }
    </div>

    @* ---- pick new vendors ---- *@
    <div class="p-5">
        <h3 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Available vendors</h3>

        @if (Model.Assignment.ApprovedVendorCount == 0)
        {
            <p class="mt-3 text-sm text-ink-500">
                No approved vendors yet. <a href="/admin/vendors" class="font-medium text-jade-600">Review partner applications</a>.
            </p>
        }
        else
        {
            @if (Model.Assignment.ShowingAllApproved)
            {
                <p class="mt-3 border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-700 rounded-card">
                    No vendor offers @lead.ServiceName. Showing all approved vendors so you can decide.
                </p>
            }

            <form method="post" action="/admin/leads/@lead.Id/assign" class="mt-4">
                @Html.AntiForgeryToken()

                <ul class="divide-y divide-ink-100 border-y border-ink-100">
                    @foreach (var candidate in Model.Assignment.Candidates)
                    {
                        <li class="py-3">
                            <label class="flex items-start gap-3 @(candidate.AlreadyAssigned ? "opacity-50" : "cursor-pointer")">
                                <input type="checkbox" name="vendorIds" value="@candidate.VendorId"
                                       disabled="@candidate.AlreadyAssigned"
                                       class="mt-1 h-4 w-4 shrink-0 accent-jade-500" />

                                <span class="min-w-0 flex-1">
                                    <span class="block text-sm font-semibold text-ink-900">@candidate.BusinessName</span>
                                    <span class="mt-0.5 block text-sm text-ink-500">
                                        @candidate.City
                                        @if (!string.IsNullOrWhiteSpace(candidate.OperatingLocations))
                                        {
                                            <text> &middot; @candidate.OperatingLocations</text>
                                        }
                                    </span>
                                </span>

                                <span class="flex shrink-0 flex-wrap items-center gap-1.5">
                                    <span class="@AssignmentBadge.MatchClasses(candidate.ServiceMatch) border px-2 py-0.5 text-[12px] font-medium rounded-card">
                                        Service: @AssignmentBadge.MatchLabel(candidate.ServiceMatch)
                                    </span>
                                    <span class="@AssignmentBadge.MatchClasses(candidate.LocationMatch) border px-2 py-0.5 text-[12px] font-medium rounded-card">
                                        Location: @AssignmentBadge.MatchLabel(candidate.LocationMatch)
                                    </span>
                                    @if (candidate.AlreadyAssigned)
                                    {
                                        <span class="border border-ink-200 bg-ink-100 px-2 py-0.5 text-[12px] font-medium text-ink-500 rounded-card">Assigned</span>
                                    }
                                </span>
                            </label>
                        </li>
                    }
                </ul>

                <button type="submit"
                        class="mt-4 h-11 bg-ink-900 px-5 text-sm font-semibold text-white rounded-card transition-colors hover:bg-ink-800">
                    Assign selected vendors
                </button>
            </form>
        }
    </div>
</section>

@* ---- Conversion, when the customer has chosen ---- *@
@if (lead.IsConverted && lead.SelectedVendor is not null && lead.SelectedQuote is not null)
{
    <section class="mt-4 border border-jade-500/40 bg-white p-5 rounded-card" aria-labelledby="conversion-heading">
        <h2 id="conversion-heading" class="text-[13px] font-semibold uppercase tracking-wide text-jade-600">Conversion</h2>

        <dl class="mt-4 grid gap-4 sm:grid-cols-4">
            <div>
                <dt class="text-[13px] text-ink-500">Status</dt>
                <dd class="mt-0.5 text-sm font-semibold text-ink-900">Converted</dd>
            </div>
            <div>
                <dt class="text-[13px] text-ink-500">Selected vendor</dt>
                <dd class="mt-0.5 text-sm">
                    <a href="/admin/vendors/@lead.SelectedVendorId" class="font-semibold text-jade-600 hover:text-jade-500">
                        @lead.SelectedVendor.BusinessName
                    </a>
                </dd>
            </div>
            <div>
                <dt class="text-[13px] text-ink-500">Accepted quote</dt>
                <dd class="mt-0.5 text-sm">
                    <a href="/admin/quotes/@lead.SelectedQuoteId" class="font-semibold text-jade-600 hover:text-jade-500">
                        @lead.SelectedQuote.QuoteNumber
                    </a>
                    <span class="text-ink-600">&middot; @Money.Format(lead.SelectedQuote.TotalAmount)</span>
                </dd>
            </div>
            <div>
                <dt class="text-[13px] text-ink-500">Converted at</dt>
                <dd class="mt-0.5 text-sm text-ink-800">@(lead.ConvertedAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "-")</dd>
            </div>
        </dl>
    </section>
}

<!-- ============ Vendor quotes ============ -->
<section class="mt-4 border border-ink-200 bg-white rounded-card" aria-labelledby="quotes-heading">

    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink-200 p-5">
        <h2 id="quotes-heading" class="text-[15px] font-semibold text-ink-900">Vendor quotes</h2>
        @if (Model.Quotes.Count > 0)
        {
            <span class="text-sm text-ink-500">@Model.Quotes.Count received &middot; cheapest first</span>
        }
    </div>

    @if (Model.Quotes.Count == 0)
    {
        <p class="p-5 text-sm text-ink-500">
            No vendors have quoted yet. Assigned vendors can submit a price from their partner dashboard.
        </p>
    }
    else
    {
        <ul class="divide-y divide-ink-100">
            @foreach (var quote in Model.Quotes)
            {
                <li class="flex flex-wrap items-center justify-between gap-4 p-5">
                    <div class="min-w-0">
                        <a href="/admin/vendors/@quote.VendorId" class="text-sm font-semibold text-ink-900 hover:text-jade-600">
                            @quote.Vendor?.BusinessName
                        </a>
                        <p class="mt-0.5 text-sm text-ink-500">
                            @quote.QuoteNumber &middot; @quote.CreatedAt.ToLocalTime().ToString("d MMM yyyy")
                            @if (quote.EstimatedDeliveryDays.HasValue)
                            {
                                <text> &middot; @quote.EstimatedDeliveryDays day(s) in transit</text>
                            }
                        </p>
                    </div>

                    <div class="flex shrink-0 items-center gap-4">
                        <span class="text-base font-bold tracking-tight text-ink-900">@Money.Format(quote.TotalAmount)</span>
                        <span class="@QuoteBadge.Classes(quote.Status) inline-flex items-center border px-2 py-0.5 text-[12px] font-medium rounded-card">
                            @QuoteBadge.Label(quote.Status)
                        </span>
                        <a href="/admin/quotes/@quote.Id" class="text-sm font-medium text-jade-600 hover:text-jade-500">View quote</a>
                    </div>
                </li>
            }
        </ul>
    }
</section>
