@model AdminLeadListViewModel
@{
    ViewData["Title"] = "Leads";

    var firstItem = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);

    // Show a window of page numbers rather than all of them.
    var windowStart = Math.Max(1, Model.Page - 2);
    var windowEnd = Math.Min(Model.TotalPages, windowStart + 4);
    windowStart = Math.Max(1, windowEnd - 4);
}

@* GET, so filters live in the query string and the page is shareable and
   bookmarkable. No customer data goes into the URL - only search terms the
   admin typed themselves. *@
<form method="get" action="/admin/leads" class="border border-ink-200 bg-white p-4 shadow-card rounded-panel">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-6">

        <div class="lg:col-span-2">
            <label for="search" class="block text-[12px] font-semibold text-ink-700">Search</label>
            <input id="search" name="search" type="search" value="@Model.Search"
                   placeholder="Lead number, name, phone or email"
                   class="mt-1.5 block h-10 w-full border border-ink-200 px-3 text-sm text-ink-900 rounded-card focus:border-jade-500" />
        </div>

        <div>
            <label for="service" class="block text-[12px] font-semibold text-ink-700">Service</label>
            <select id="service" name="service"
                    class="mt-1.5 block h-10 w-full border border-ink-200 bg-white px-2 text-sm text-ink-900 rounded-card focus:border-jade-500">
                <option value="">All services</option>
                @foreach (var service in Model.Services)
                {
                    <option value="@service.Slug" selected="@(Model.ServiceSlug == service.Slug)">@service.Name</option>
                }
            </select>
        </div>

        <div>
            <label for="status" class="block text-[12px] font-semibold text-ink-700">Status</label>
            <select id="status" name="status"
                    class="mt-1.5 block h-10 w-full border border-ink-200 bg-white px-2 text-sm text-ink-900 rounded-card focus:border-jade-500">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<LeadStatus>())
                {
                    <option value="@status" selected="@(Model.Status == status)">@StatusBadge.Label(status)</option>
                }
            </select>
        </div>

        <div>
            <label for="assigned" class="block text-[12px] font-semibold text-ink-700">Assignment</label>
            <select id="assigned" name="assigned"
                    class="mt-1.5 block h-10 w-full border border-ink-200 bg-white px-2 text-sm text-ink-900 rounded-card focus:border-jade-500">
                <option value="">All leads</option>
                <option value="true" selected="@(Model.Assigned == true)">Assigned</option>
                <option value="false" selected="@(Model.Assigned == false)">Unassigned</option>
            </select>
        </div>

        <div class="grid grid-cols-2 gap-2">
            <div>
                <label for="from" class="block text-[12px] font-semibold text-ink-700">From</label>
                <input id="from" name="from" type="date" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                       class="mt-1.5 block h-10 w-full border border-ink-200 px-2 text-sm text-ink-900 rounded-card focus:border-jade-500" />
            </div>
            <div>
                <label for="to" class="block text-[12px] font-semibold text-ink-700">To</label>
                <input id="to" name="to" type="date" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                       class="mt-1.5 block h-10 w-full border border-ink-200 px-2 text-sm text-ink-900 rounded-card focus:border-jade-500" />
            </div>
        </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-2">
        <button type="submit" class="h-10 bg-jade-500 px-5 text-sm font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
            Apply
        </button>
        <a href="/admin/leads" class="h-10 border border-ink-200 px-5 text-sm font-medium leading-10 text-ink-700 bg-white rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">
            Clear
        </a>
    </div>
</form>

<p class="mt-4 text-sm text-ink-500">
    @if (Model.TotalCount == 0)
    {
        <text>No leads match these filters.</text>
    }
    else
    {
        <text>Showing @firstItem&ndash;@lastItem of @Model.TotalCount</text>
    }
</p>

@if (Model.TotalCount > 0)
{
    <div class="mt-3 overflow-hidden border border-ink-200 bg-white shadow-card rounded-panel">

        <div class="hidden overflow-x-auto lg:block">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-ink-200 bg-ink-50 text-[12px] uppercase tracking-wide text-ink-500">
                    <tr>
                        <th scope="col" class="px-4 py-3 font-semibold">Lead</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Customer</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Phone</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Service</th>
                        <th scope="col" class="px-4 py-3 font-semibold">From</th>
                        <th scope="col" class="px-4 py-3 font-semibold">To</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Moving date</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Status</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Vendors</th>
                        <th scope="col" class="px-4 py-3 font-semibold">Created</th>
                        <th scope="col" class="px-4 py-3"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-100">
                    @foreach (var lead in Model.Leads)
                    {
                        <tr class="hover:bg-jade-50">
                            <td class="whitespace-nowrap px-4 py-3 font-medium text-ink-900">@lead.LeadNumber</td>
                            <td class="px-4 py-3 text-ink-700">@lead.CustomerName</td>
                            <td class="whitespace-nowrap px-4 py-3 text-ink-700">@lead.Phone</td>
                            <td class="px-4 py-3 text-ink-700">@lead.ServiceName</td>
                            <td class="px-4 py-3 text-ink-500">@(lead.MovingFrom ?? lead.StorageLocation ?? "-")</td>
                            <td class="px-4 py-3 text-ink-500">@(lead.MovingTo ?? "-")</td>
                            <td class="whitespace-nowrap px-4 py-3 text-ink-500">@(lead.MovingDate?.ToString("d MMM yyyy") ?? "-")</td>
                            <td class="px-4 py-3">
                                <span class="@StatusBadge.Classes(lead.Status) inline-flex items-center border px-2 py-0.5 text-[12px] font-medium rounded-card">
                                    @StatusBadge.Label(lead.Status)
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                @{ var assignedCount = Model.CountFor(lead.Id); }
                                @if (assignedCount == 0)
                                {
                                    <span class="text-ink-500">None</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center border border-jade-100 bg-jade-50 px-2 py-0.5 text-[12px] font-medium text-jade-600 rounded-card">@assignedCount</span>
                                }
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-ink-500">@lead.CreatedAt.ToLocalTime().ToString("d MMM, HH:mm")</td>
                            <td class="px-4 py-3 text-right">
                                <a href="/admin/leads/@lead.Id" class="font-medium text-jade-500 transition-colors hover:text-jade-600">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <ul class="divide-y divide-ink-100 lg:hidden">
            @foreach (var lead in Model.Leads)
            {
                <li>
                    <a href="/admin/leads/@lead.Id" class="block p-4 hover:bg-jade-50">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold text-ink-900">@lead.CustomerName</p>
                                <p class="mt-0.5 text-sm text-ink-500">@lead.Phone</p>
                            </div>
                            <span class="@StatusBadge.Classes(lead.Status) shrink-0 border px-2 py-0.5 text-[12px] font-medium rounded-card">
                                @StatusBadge.Label(lead.Status)
                            </span>
                        </div>
                        <p class="mt-2 text-sm text-ink-700">@lead.ServiceName</p>
                        <p class="mt-0.5 truncate text-sm text-ink-500">
                            @(lead.MovingFrom is null ? lead.StorageLocation ?? "-" : $"{lead.MovingFrom} to {lead.MovingTo}")
                        </p>
                        <p class="mt-2 text-xs text-ink-500">
                            @lead.LeadNumber &middot; @lead.CreatedAt.ToLocalTime().ToString("d MMM, HH:mm")
                            &middot; @(Model.CountFor(lead.Id) == 0 ? "no vendors" : $"{Model.CountFor(lead.Id)} vendor(s)")
                        </p>
                    </a>
                </li>
            }
        </ul>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 flex flex-wrap items-center gap-1.5" aria-label="Pagination">
            @if (Model.HasPrevious)
            {
                <a href="/admin/leads?@Html.Raw(string.Join("&", Model.RouteValues(Model.Page - 1).Where(kv => !string.IsNullOrEmpty(kv.Value)).Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}")))"
                   class="grid h-9 min-w-9 place-items-center border border-ink-200 bg-white px-3 text-sm font-medium text-ink-700 rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">Previous</a>
            }

            @for (var p = windowStart; p <= windowEnd; p++)
            {
                var isCurrent = p == Model.Page;
                <a href="/admin/leads?@Html.Raw(string.Join("&", Model.RouteValues(p).Where(kv => !string.IsNullOrEmpty(kv.Value)).Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}")))"
                   aria-current="@(isCurrent ? "page" : null)"
                   class="@(isCurrent ? "border-jade-500 bg-jade-500 text-white" : "border-ink-200 bg-white text-ink-700 transition-colors hover:border-jade-500 hover:text-jade-600") grid h-9 min-w-9 place-items-center border px-3 text-sm font-medium rounded-card">@p</a>
            }

            @if (Model.HasNext)
            {
                <a href="/admin/leads?@Html.Raw(string.Join("&", Model.RouteValues(Model.Page + 1).Where(kv => !string.IsNullOrEmpty(kv.Value)).Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}")))"
                   class="grid h-9 min-w-9 place-items-center border border-ink-200 bg-white px-3 text-sm font-medium text-ink-700 rounded-card transition-colors hover:border-jade-500 hover:text-jade-600">Next</a>
            }
        </nav>
    }
}
