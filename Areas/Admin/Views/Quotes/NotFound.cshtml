@{
    ViewData["Title"] = "Quote not found";
}

<div class="border border-ink-200 bg-white p-10 text-center shadow-card rounded-panel">
    <h2 class="text-lg font-bold text-ink-900">Quote not found</h2>
    <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-ink-500">
        That quote doesn't exist. The link may be wrong.
    </p>
    <a href="/admin/quotes" class="mt-6 inline-flex h-11 items-center bg-jade-500 px-5 text-sm font-semibold text-white shadow-cta rounded-card transition-colors hover:bg-jade-600">
        Back to all quotes
    </a>
</div>
