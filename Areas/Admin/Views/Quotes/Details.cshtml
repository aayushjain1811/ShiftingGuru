@model AdminQuoteDetailsViewModel
@{
    var quote = Model.Quote;
    var lead = Model.Lead;
    var vendor = Model.Vendor;

    var lines = new (string Label, decimal Value)[]
    {
        ("Base price", quote.BasePrice),
        ("Packing charges", quote.PackingCharges),
        ("Transportation charges", quote.TransportationCharges),
        ("Loading / unloading", quote.LoadingUnloadingCharges),
        ("Additional charges", quote.AdditionalCharges)
    };

    string Describe(QuoteStatus status) => status switch
    {
        QuoteStatus.Accepted => "Accept this quote?",
        QuoteStatus.Rejected => "Reject this quote?",
        QuoteStatus.Cancelled => "Cancel this quote? This can't be undone.",
        QuoteStatus.Expired => "Mark this quote expired?",
        QuoteStatus.UnderReview => "Move this quote to under review?",
        _ => "Change this quote's status?"
    };

    string ButtonClasses(QuoteStatus status) => status switch
    {
        QuoteStatus.Accepted => "bg-success-600 text-white hover:bg-success-700",
        QuoteStatus.Rejected or QuoteStatus.Cancelled => "bg-red-600 text-white hover:bg-red-700",
        _ => "bg-jade-500 text-white hover:bg-jade-600"
    };
}

<div class="flex flex-wrap items-center justify-between gap-3">
    <a href="/admin/quotes" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 hover:text-ink-900">
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M16 10H5M9 6l-4 4 4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        All quotes
    </a>

    <span class="@QuoteBadge.Classes(quote.Status) inline-flex items-center border px-3 py-1 text-sm font-medium rounded-card">
        @QuoteBadge.Label(quote.Status)
    </span>
</div>

<div class="mt-5 grid gap-4 lg:grid-cols-3">

    <div class="space-y-4 lg:col-span-2">

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Quote</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-3">
                <div>
                    <dt class="text-[13px] text-ink-500">Quote number</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-ink-900">@quote.QuoteNumber</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Created</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@quote.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Updated</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(quote.UpdatedAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "Not updated")</dd>
                </div>
            </dl>
        </section>

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Pricing</h2>
            <dl class="mt-4 divide-y divide-ink-100 border-y border-ink-100">
                @foreach (var line in lines)
                {
                    <div class="flex items-center justify-between py-2.5">
                        <dt class="text-sm text-ink-600">@line.Label</dt>
                        <dd class="text-sm text-ink-900">@Money.Format(line.Value)</dd>
                    </div>
                }
            </dl>
            <div class="mt-4 flex items-center justify-between">
                <span class="text-sm font-semibold text-ink-900">Total</span>
                <span class="text-xl font-bold tracking-tight text-ink-900">@Money.Format(quote.TotalAmount)</span>
            </div>
        </section>

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Timing</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-3">
                <div>
                    <dt class="text-[13px] text-ink-500">Pickup</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(quote.EstimatedPickupDate?.ToString("d MMM yyyy") ?? "Not given")</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Delivery</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(quote.EstimatedDeliveryDate?.ToString("d MMM yyyy") ?? "Not given")</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Days in transit</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(quote.EstimatedDeliveryDays?.ToString() ?? "Not given")</dd>
                </div>
            </dl>
        </section>

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Lead</h2>
            <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <div>
                    <dt class="text-[13px] text-ink-500">Lead number</dt>
                    <dd class="mt-0.5 text-sm">
                        <a href="/admin/leads/@lead.Id" class="font-semibold text-jade-500 transition-colors hover:text-jade-600">@lead.LeadNumber</a>
                    </dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Service</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@lead.ServiceName</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Route</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">
                        @(lead.MovingFrom is null ? lead.StorageLocation ?? "-" : $"{lead.MovingFrom} to {lead.MovingTo}")
                    </dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Moving date</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@(lead.MovingDate?.ToString("d MMM yyyy") ?? "Not given")</dd>
                </div>

                @foreach (var detail in Model.ServiceDetails)
                {
                    <div>
                        <dt class="text-[13px] text-ink-500">@detail.Label</dt>
                        <dd class="mt-0.5 text-sm text-ink-800">@detail.Value</dd>
                    </div>
                }
            </dl>
        </section>

        @if (!string.IsNullOrWhiteSpace(quote.VendorNotes))
        {
            <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
                <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Vendor notes</h2>
                <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-ink-800">@quote.VendorNotes</p>
            </section>
        }
    </div>

    <div class="space-y-4 lg:col-span-1">

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Vendor</h2>
            <dl class="mt-4 space-y-3">
                <div>
                    <dt class="text-[13px] text-ink-500">Business</dt>
                    <dd class="mt-0.5 text-sm">
                        <a href="/admin/vendors/@vendor.Id" class="font-semibold text-jade-500 transition-colors hover:text-jade-600">@vendor.BusinessName</a>
                    </dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Vendor number</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.VendorNumber</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Contact</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.ContactPerson</dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Phone</dt>
                    <dd class="mt-0.5 text-sm"><a href="tel:@vendor.Phone" class="text-jade-500 transition-colors hover:text-jade-600">@vendor.Phone</a></dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">Email</dt>
                    <dd class="mt-0.5 truncate text-sm"><a href="mailto:@vendor.Email" class="text-jade-500 transition-colors hover:text-jade-600">@vendor.Email</a></dd>
                </div>
                <div>
                    <dt class="text-[13px] text-ink-500">City</dt>
                    <dd class="mt-0.5 text-sm text-ink-800">@vendor.City</dd>
                </div>
            </dl>
        </section>

        <section class="border border-ink-200 bg-white p-5 shadow-card rounded-panel">
            <h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-500">Status</h2>

            @if (Model.AllowedTransitions.Count == 0)
            {
                <p class="mt-3 text-sm text-ink-500">No further status changes are available.</p>
            }
            else
            {
                <p class="mt-2 text-sm leading-relaxed text-ink-500">
                    Valid moves from <strong class="text-ink-800">@QuoteBadge.Label(quote.Status)</strong>.
                </p>

                <div class="mt-4 space-y-2.5">
                    @foreach (var status in Model.AllowedTransitions)
                    {
                        <form method="post" action="/admin/quotes/@quote.Id/status"
                              onsubmit="return confirm('@Describe(status)');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="status" value="@status" />
                            <button type="submit" class="@ButtonClasses(status) h-11 w-full text-sm font-semibold rounded-card transition-colors">
                                @QuoteBadge.Label(status)
                            </button>
                        </form>
                    }
                </div>
            }
        </section>
    </div>
</div>
